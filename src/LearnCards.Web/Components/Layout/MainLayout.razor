@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject AppConfig Config
@inject AuthenticationStateProvider AuthState
@inject CardRepository Repo
@inject NavigationManager Nav
@inject UserUiState UiState

@* Anwendungshülle: schmale Icon-Navigation (Desktop/Tablet), untere Leiste mit „Mehr“ (Smartphone), großer Hauptcontainer mit Kopfbereich.
   Alle Ziele sind vorhandene Seiten; Berechtigungen prüfen weiterhin die Seiten und Dienste serverseitig (Ausblenden ist nie ein Schutz). *@
<AuthorizeView>
    <Authorized>
        <div class="app-shell">
            <aside class="sidebar" aria-label="Hauptnavigation">
                <a class="sidebar-logo" href="/dashboard" aria-label="Learny — Mein Dashboard">
                    <svg viewBox="0 0 64 64" width="30" height="30" aria-hidden="true"><rect x="6" y="10" width="52" height="44" rx="12" fill="currentColor" /><path d="M18 24h28M18 33h28M18 42h16" stroke="#fff" stroke-width="5" stroke-linecap="round" fill="none" /></svg>
                </a>
                <nav class="nav-list" id="main-nav">
                    <a class="nav-ico" href="/dashboard" aria-current="@Current("dashboard")" title="Mein Dashboard" aria-label="Mein Dashboard">@Icon("home")<span class="nav-label">Start</span></a>
                    <a class="nav-ico" href="/" aria-current="@Current("")" title="Module und Lernkarten" aria-label="Module und Lernkarten">@Icon("cube")<span class="nav-label">Lernen</span></a>
                    <a class="nav-ico" href="/topics" aria-current="@Current("topics")" title="Themen" aria-label="Themen">@Icon("route")<span class="nav-label">Themen</span></a>
                    <a class="nav-ico" href="/achievements" aria-current="@Current("achievements")" title="Meine Abschlüsse und Nachweise" aria-label="Meine Abschlüsse und Nachweise">@Icon("award")<span class="nav-label">Abschlüsse</span></a>
                    <button type="button" class="nav-ico nav-more" aria-expanded="false" aria-controls="main-nav" title="Weitere Bereiche" aria-label="Weitere Bereiche" data-shell="more">@Icon("more")<span class="nav-label">Mehr</span></button>
                    <div class="nav-secondary-wrap">
                        @if (context.User.IsInRole(Roles.Admin) || context.User.IsInRole(Roles.TopicAdmin))
                        {
                            <a class="nav-ico nav-secondary" href="/topic-admin" aria-current="@Current("topic-admin")" title="Zuweisungen und Lernstatus" aria-label="Zuweisungen und Lernstatus">@Icon("users")<span class="nav-label">Zuweisungen</span></a>
                        }
                        else if (context.User.IsInRole(Roles.Auditor))
                        {
                            <a class="nav-ico nav-secondary" href="/topic-admin" aria-current="@Current("topic-admin")" title="Lernstatus" aria-label="Lernstatus">@Icon("users")<span class="nav-label">Lernstatus</span></a>
                        }
                        @if (context.User.IsInRole(Roles.Admin))
                        {
                            <a class="nav-ico nav-secondary" href="/admin" aria-current="@Current("admin")" title="Administration" aria-label="Administration">@Icon("shield")<span class="nav-label">Verwaltung</span></a>
                        }
                        else if (context.User.IsInRole(Roles.Auditor))
                        {
                            <a class="nav-ico nav-secondary" href="/admin" aria-current="@Current("admin")" title="Globale Inhalte" aria-label="Globale Inhalte">@Icon("shield")<span class="nav-label">Inhalte</span></a>
                        }
                        <a class="nav-ico nav-secondary nav-foot" href="/profile" aria-current="@Current("profile")" title="Mein Profil und Einstellungen" aria-label="Mein Profil und Einstellungen">@Icon("user")<span class="nav-label">Profil</span></a>
                        <a class="nav-ico nav-secondary" href="/help" aria-current="@Current("help")" title="Hilfe" aria-label="Hilfe">@Icon("help")<span class="nav-label">Hilfe</span></a>
                        <a class="nav-ico nav-secondary" href="/auth/logout" title="Abmelden" aria-label="Abmelden">@Icon("logout")<span class="nav-label">Abmelden</span></a>
                    </div>
                </nav>
            </aside>

            <div class="stage">
                <header class="stage-top">
                    <a href="/dashboard" class="stage-brand" aria-label="Learny">
                        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 64 64" width="26" height="26"><rect x="6" y="10" width="52" height="44" rx="12" fill="currentColor" /><path d="M18 24h28M18 33h28M18 42h16" stroke="#fff" stroke-width="5" stroke-linecap="round" fill="none" /></svg></span>
                        <span>Learny</span>
                    </a>
                    <a href="/verify" class="seal-link" title="Learny Verified – Zertifikate prüfen" aria-label="Learny Verified – Zertifikate prüfen"><img src="/brand/learny-verified-mark.svg" alt="" width="26" height="26" /></a>
                    <form class="search-pill" action="/" method="get" role="search">
                        @Icon("search")
                        <input type="search" name="q" maxlength="100" placeholder="Module durchsuchen …" aria-label="Module durchsuchen" autocomplete="off" />
                    </form>
                    <div class="stage-actions">
                        <button type="button" class="icon-btn theme-btn" data-shell="theme" title="@ThemeTitle" aria-label="@ThemeTitle">
                            <span aria-hidden="true" data-theme-icon>@ThemeIcon</span>
                            <span class="theme-label" data-theme-short>@ThemeShort</span>
                        </button>
                        <span class="sr-only" role="status" aria-live="polite" id="theme-announce"></span>
                        <div class="user-menu">
                            <button type="button" class="user-btn" aria-haspopup="menu" aria-expanded="false" data-shell="menu" title="Profilmenü: @context.User.Identity?.Name">
                                <Avatar Preset="@UiState.AvatarPreset" Hidden="@UiState.AvatarHidden" Name="@context.User.Identity?.Name" Size="38" Animate="false" />
                                <span class="user-name">@context.User.Identity?.Name</span>
                            </button>
                                <div class="user-panel" role="menu" aria-label="Profilmenü" hidden>
                                    <a role="menuitem" href="/profile">@Icon("user") Mein Profil</a>
                                    <a role="menuitem" href="/profile#avatar">@Icon("home") Mein Avatar</a>
                                    <button type="button" role="menuitem" data-shell="theme"><span aria-hidden="true" data-theme-icon>@ThemeIcon</span> Darstellung: <span data-theme-short>@ThemeShort</span></button>
                                    <a role="menuitem" href="/help">@Icon("help") Hilfe</a>
                                    <a role="menuitem" href="/auth/logout">@Icon("logout") Abmelden</a>
                                </div>
                        </div>
                    </div>
                </header>
                <main id="main-content" class="stage-body">
                    @Body
                </main>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="app-shell app-shell-solo">
            <main id="main-content" class="main">
                @Body
            </main>
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Darstellung: system (folgt dem Gerät, Standard) → light → dark → system
    private string _mode = "system";
    private static readonly string[] Modes = { "system", "light", "dark" };
    private string ThemeIcon => _mode switch { "light" => "☀️", "dark" => "🌙", _ => "🖥️" };
    private string ThemeShort => _mode switch { "light" => "Hell", "dark" => "Dunkel", _ => "Auto" };
    private static string ModeLabel(string m) => m switch { "light" => "Hell", "dark" => "Dunkel", _ => "System (automatisch, folgt dem Gerät)" };
    private string NextMode => Modes[(Array.IndexOf(Modes, _mode) + 1) % Modes.Length];
    private string ThemeTitle => $"Darstellung: {ModeLabel(_mode)}. Klicken für: {ModeLabel(NextMode)}";
    private string _userSub = "";

    /// <summary>aria-current für den aktiven Bereich (null = Attribut entfällt).</summary>
    private string? Current(string area)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        var first = path.Split('/')[0];
        var active = area == "" ? first is "" or "module" : first == area || (area == "admin" && first is "pki");
        return active ? "page" : null;
    }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        UiState.Changed += OnUiChanged;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            _userSub = auth.User.GetUserId() ?? "";
            if (!string.IsNullOrWhiteSpace(_userSub))
            {
                var (preset, hidden) = await Repo.GetAvatarAsync(_userSub);   // Darstellungseinstellung des angemeldeten Benutzers
                UiState.SetAvatar(preset, hidden);
            }
        }
        catch (Exception) { /* Avatar ist nur Darstellung: ohne Einstellung erscheinen Initialen */ }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) { InvokeAsync(StateHasChanged); }
    private void OnUiChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() { Nav.LocationChanged -= OnLocationChanged; UiState.Changed -= OnUiChanged; }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var storedTheme = string.IsNullOrWhiteSpace(_userSub) ? "" : await Repo.GetThemeAsync(_userSub);
                if (storedTheme is "dark" or "light" or "system")   // im Profil gespeicherte Wahl gilt geräteübergreifend
                    await JS.InvokeVoidAsync("lcTheme.set", storedTheme);
                _mode = await JS.InvokeAsync<string>("lcTheme.mode");
                StateHasChanged();
            }
            catch { /* Prerender ohne JS */ }
        }
    }

    /// <summary>Einheitliche Linien-Icons (24×24, currentColor).</summary>
    private static RenderFragment Icon(string name) => builder =>
    {
        var path = name switch
        {
            "home" => "<path d=\"M3 11l9-8 9 8\"/><path d=\"M5 10v10h14V10\"/><path d=\"M10 20v-6h4v6\"/>",
            "cube" => "<path d=\"M12 2l9 5v10l-9 5-9-5V7z\"/><path d=\"M12 12l9-5M12 12v10M12 12L3 7\"/>",
            "route" => "<circle cx=\"6\" cy=\"18\" r=\"2.5\"/><circle cx=\"18\" cy=\"6\" r=\"2.5\"/><path d=\"M8.5 18H15a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6.5\"/>",
            "award" => "<circle cx=\"12\" cy=\"9\" r=\"6\"/><path d=\"M8.5 14.5L7 22l5-3 5 3-1.5-7.5\"/>",
            "users" => "<circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M2.5 20a6.5 6.5 0 0 1 13 0\"/><path d=\"M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6.5 6.5 0 0 1 3.5 6\"/>",
            "shield" => "<path d=\"M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z\"/><path d=\"M9 12l2 2 4-4\"/>",
            "help" => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 1-1 1.7M12 17h.01\"/>",
            "user" => "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/>",
            "logout" => "<path d=\"M9 4H5v16h4\"/><path d=\"M16 8l4 4-4 4M20 12H9\"/>",
            "more" => "<circle cx=\"5\" cy=\"12\" r=\"1.6\"/><circle cx=\"12\" cy=\"12\" r=\"1.6\"/><circle cx=\"19\" cy=\"12\" r=\"1.6\"/>",
            "search" => "<circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/>",
            _ => "",
        };
        builder.AddMarkupContent(0, $"<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">{path}</svg>");
    };
}
