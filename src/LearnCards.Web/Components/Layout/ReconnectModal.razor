<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* Statusanzeige bei unterbrochener Verbindung (Blazor-Circuit). Texte setzt ReconnectModal.razor.js; ohne JavaScript bleibt der Dialog unsichtbar. *@
<dialog id="components-reconnect-modal" data-nosnippet aria-labelledby="components-reconnect-title">
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p id="components-reconnect-title" class="components-reconnect-title">Verbindung unterbrochen</p>
        <p id="components-reconnect-status" class="components-reconnect-status" role="status" aria-live="polite">Learny verbindet sich automatisch neu …</p>
        <button id="components-reconnect-button" type="button">Erneut verbinden</button>
    </div>
</dialog>
