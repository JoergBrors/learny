@using LearnCards.Web.Domain
@* Avatar: freundlicher, selbst gezeichneter Lernbegleiter (SVG) in mehreren Varianten und Stimmungen. Ohne Auswahl (oder ausgeblendet) erscheinen neutrale Initialen.
   Rein dekorativ (ADR 0051): leitet nichts aus Personendaten ab, verleiht keine Rechte. Animationen sind kurz und entfallen bei prefers-reduced-motion. *@
@if (_preset is null)
{
    <span class="avatar avatar-initials" style="--av-size:@(Size)px" role="img" aria-label="@(string.IsNullOrWhiteSpace(Name) ? "Benutzer" : Name)">@Initials</span>
}
else
{
    var p = _preset;
    <svg class="avatar avatar-svg avatar-@State @(Animate ? "avatar-animated" : "")" style="--av-size:@(Size)px" viewBox="0 0 100 100" width="@Size" height="@Size" role="img" aria-label="@Label">
        <defs>
            <linearGradient id="@_bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8B5CF6" /><stop offset="1" stop-color="#4C1D95" /></linearGradient>
            <clipPath id="@_clip"><circle cx="50" cy="50" r="50" /></clipPath>
        </defs>
        <g clip-path="url(#@_clip)">
            <circle cx="50" cy="50" r="50" fill="url(#@_bg)" />
            @if (p.HairStyle is "long") { <path d="M29 46 C26 24 40 16 52 17 C66 18 74 30 71 52 L72 76 C66 74 64 62 64 52 L36 52 C36 62 34 74 28 76Z" fill="@p.Hair" /> }
            @if (p.HairStyle is "bob") { <path d="M28 50 C26 26 40 17 52 18 C66 19 74 30 72 52 L72 68 C66 68 64 58 64 50 L36 50 C36 58 34 68 28 68Z" fill="@p.Hair" /> }
            <path d="M18 104 C18 80 34 71 50 71 C66 71 82 80 82 104Z" fill="@p.Outfit" />
            <rect x="44" y="58" width="12" height="16" rx="6" fill="@p.Skin" /><rect x="44" y="58" width="12" height="16" rx="6" fill="#000" opacity=".08" />
            <circle cx="31" cy="48" r="4" fill="@p.Skin" /><circle cx="69" cy="48" r="4" fill="@p.Skin" />
            <ellipse cx="50" cy="46" rx="19" ry="21" fill="@p.Skin" />
            @switch (p.HairStyle)
            {
                case "curly":
                    <g fill="@p.Hair"><circle cx="34" cy="34" r="8" /><circle cx="44" cy="26" r="9" /><circle cx="56" cy="26" r="9" /><circle cx="66" cy="34" r="8" /><circle cx="30" cy="46" r="6" /><circle cx="70" cy="46" r="6" /><path d="M32 40 C36 30 64 30 68 40 C62 35 56 33 50 33 C44 33 38 35 32 40Z" /></g>
                    break;
                case "bun":
                    <g fill="@p.Hair"><circle cx="50" cy="16" r="8" /><path d="M31 44 C30 26 42 20 52 21 C64 22 70 32 69 44 C64 36 56 33 48 34 C42 35 35 38 31 44Z" /></g>
                    break;
                default:
                    <path d="M31 44 C30 26 42 20 52 21 C64 22 70 32 69 44 C64 36 56 33 48 34 C42 35 35 38 31 44Z" fill="@p.Hair" />
                    break;
            }
            @switch (p.Accessory)
            {
                case "beanie":
                    <path d="M30 38 C30 20 70 20 70 38Z" fill="#6B7280" /><rect x="29" y="35" width="42" height="6" rx="3" fill="#9CA3AF" /><circle cx="50" cy="19" r="4" fill="#9CA3AF" />
                    break;
                case "cap":
                    <path d="M30 36 C32 20 68 20 70 36Z" fill="@p.Outfit" /><path d="M46 36 L78 38 L78 42 L46 41Z" fill="@p.Outfit" /><path d="M46 36 L78 38 L78 42 L46 41Z" fill="#000" opacity=".15" />
                    break;
                case "headphones":
                    <path d="M30 46 C28 22 72 22 70 46" fill="none" stroke="#1F2937" stroke-width="3.5" stroke-linecap="round" /><rect x="26" y="43" width="7" height="13" rx="3.5" fill="#1F2937" /><rect x="67" y="43" width="7" height="13" rx="3.5" fill="#1F2937" />
                    break;
                case "glasses":
                    <g fill="none" stroke="#1F2937" stroke-width="1.6"><circle cx="43" cy="47" r="6.5" /><circle cx="57" cy="47" r="6.5" /><path d="M49.5 47h1" /></g>
                    break;
            }
            @* Gesicht je Stimmung *@
            <g class="avatar-eyes" fill="#1F1B2E">
                @if (State is "happy" or "success")
                {
                    <path d="M39.5 47.5 q3.5 -4.5 7 0" fill="none" stroke="#1F1B2E" stroke-width="2.2" stroke-linecap="round" /><path d="M53.5 47.5 q3.5 -4.5 7 0" fill="none" stroke="#1F1B2E" stroke-width="2.2" stroke-linecap="round" />
                }
                else
                {
                    <circle cx="43" cy="47" r="@(State == "motivating" ? "2.9" : "2.5")" /><circle cx="57" cy="47" r="@(State == "motivating" ? "2.9" : "2.5")" />
                }
            </g>
            @if (State == "motivating") { <g stroke="#1F1B2E" stroke-width="1.6" stroke-linecap="round" fill="none"><path d="M39 40.5 q4 -2.5 8 -.5" /><path d="M53 40 q4 -2 8 .5" /></g> }
            @if (State == "encouraging") { <g stroke="#1F1B2E" stroke-width="1.5" stroke-linecap="round" fill="none"><path d="M39.5 42 q3 -2 6.5 -.2" /><path d="M54 41.8 q3.5 -1.8 6.5 .2" /></g> }
            @if (State is "happy" or "success") { <g fill="#F9A8D4" opacity=".55"><circle cx="38" cy="54" r="3.2" /><circle cx="62" cy="54" r="3.2" /></g> }
            @switch (State)
            {
                case "success":
                    <path d="M42 55 Q50 66 58 55Z" fill="#7F1D3D" /><path d="M45 60 Q50 63 55 60 Q50 58.5 45 60Z" fill="#F472B6" />
                    break;
                case "happy":
                    <path d="M43.5 55.5 Q50 63 56.5 55.5Z" fill="#7F1D3D" />
                    break;
                case "motivating":
                    <path d="M44 56 q6 5 12 0" fill="none" stroke="#7F1D3D" stroke-width="2" stroke-linecap="round" />
                    break;
                case "encouraging":
                    <path d="M45 57 q5 2.6 10 0" fill="none" stroke="#7F1D3D" stroke-width="2" stroke-linecap="round" />
                    break;
                default:
                    <path d="M44 56 q6 4 12 0" fill="none" stroke="#7F1D3D" stroke-width="2" stroke-linecap="round" />
                    break;
            }
            @if (State == "success") { <g fill="#FDE68A" class="avatar-sparkles"><path d="M20 22 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z" /><path d="M80 18 l1.5 4 4 1.5 -4 1.5 -1.5 4 -1.5 -4 -4 -1.5 4 -1.5z" /></g> }
        </g>
    </svg>
}

@code {
    private readonly string _uid = Guid.NewGuid().ToString("N")[..8];
    private string _bg => "avbg" + _uid;
    private string _clip => "avcl" + _uid;
    private AvatarPreset? _preset;

    /// <summary>Kennung der Variante (siehe <see cref="Avatars"/>); leer oder unbekannt = neutrale Initialen.</summary>
    [Parameter] public string? Preset { get; set; }
    /// <summary>Anzeigename nur für die Initialen und die Beschriftung.</summary>
    [Parameter] public string? Name { get; set; }
    [Parameter] public int Size { get; set; } = 40;
    /// <summary>neutral | happy | motivating | success | encouraging</summary>
    [Parameter] public string State { get; set; } = "neutral";
    /// <summary>Dezente Animation (Blinzeln, Begrüßung, Erfolg). Entfällt bei prefers-reduced-motion.</summary>
    [Parameter] public bool Animate { get; set; } = true;
    /// <summary>true = Avatar ausgeblendet: es erscheinen nur Initialen.</summary>
    [Parameter] public bool Hidden { get; set; }

    private string Label => $"Avatar{(string.IsNullOrWhiteSpace(Name) ? "" : " von " + Name)}";
    private string Initials
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Name)) return "?";
            var parts = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2 ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[^1][0])}" : Name[..Math.Min(2, Name.Length)].ToUpper();
        }
    }

    protected override void OnParametersSet()
    {
        _preset = Hidden ? null : Avatars.Find(Preset);
        if (!Avatars.States.Contains(State)) State = "neutral";
    }
}
