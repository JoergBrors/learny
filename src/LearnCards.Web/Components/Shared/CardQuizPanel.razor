@* Einstieg „Quiz für diese Seite/Karte“: startet über die gemeinsame Quiz-Engine (ADR 0019) und zeigt die gemeinsame Oberfläche *@
@inject QuizService Quiz
@inject CardRepository Repo
@inject AuthenticationStateProvider AuthState

<div class="modal-backdrop" @onclick="CloseIfIdle">
    <div class="modal" role="dialog" aria-modal="true" aria-label="Seitenquiz" @onclick:stopPropagation>
        <div class="modal-head">
            <h2>📝 Quiz für diese Seite@(TitleSuffix)</h2>
            <button class="icon-btn" @onclick="() => OnClose.InvokeAsync()" aria-label="Quiz schließen">✕</button>
        </div>

        @if (_loading)
        {
            <div class="spinner-wrap" aria-busy="true"><div class="spinner" role="status"></div></div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-error" role="alert">@_error</div>
            <div class="modal-actions">
                <button class="btn btn-primary" @onclick="() => OnClose.InvokeAsync()">Schließen</button>
            </div>
        }
        else if (_session is not null)
        {
            <QuizRunner Session="_session" OnClose="OnClose" OnRestart="RestartAsync" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string CardId { get; set; } = "";
    [Parameter] public string CardTerm { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private string _loadedCardId = "";
    private bool _loading;
    private string? _error;
    private QuizStartResponse? _session;
    private string TitleSuffix => string.IsNullOrWhiteSpace(CardTerm) ? "" : $" — {CardTerm}";

    protected override async Task OnParametersSetAsync()
    {
        if (CardId == _loadedCardId) return;
        _loadedCardId = CardId;
        await StartAsync();
    }

    private async Task RestartAsync() => await StartAsync();

    private async Task StartAsync()
    {
        _loading = true;
        _error = null;
        _session = null;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var userSub = auth.User.GetUserId() ?? throw new UnauthorizedAccessException();
            var card = await Repo.GetReadableCardAsync(CardId, userSub) ?? throw new InvalidOperationException("Die ausgewählte Karte wurde nicht gefunden.");
            _session = await Quiz.StartSessionAsync(card.ModuleId, "", CardId, 0, userSub);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CloseIfIdle()
    {
        if (!_loading) await OnClose.InvokeAsync();
    }
}
