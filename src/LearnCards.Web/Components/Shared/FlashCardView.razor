@implements IAsyncDisposable
@inject IJSRuntime JS
@* Lernkarte mit 3D-Flip, Fortschrittsbalken, Aktionen und Bedienung per Berührung (Wischen/Tippen), Maus und Tastatur. Die Gesten (wwwroot/cards.js) rufen dieselben Aktionen
   wie die sichtbaren Schaltflächen auf — es gibt keine zweite Navigationslogik. Vertikales Scrollen bleibt nativ. *@

<div class="flashcard-wrap" data-immersive="@(_immersive ? "true" : "false")" data-controls="@(_controls ? "true" : "false")">
    @* Vollbildmodus (Mobil): blendet Navigation, Kopfzeile und Steuerung aus; die Steuerung lässt sich jederzeit einblenden. Wischen, Tippen und Tasten funktionieren weiter. *@
    <div class="immersive-fab">
        @if (_immersive)
        {
            <button type="button" class="btn btn-ghost btn-sm" aria-pressed="@(_controls ? "true" : "false")" @onclick="() => _controls = !_controls">@(_controls ? "Steuerung ausblenden" : "Steuerung einblenden")</button>
            <button type="button" class="btn btn-primary btn-sm" @onclick="() => SetImmersiveAsync(false)">Vollbild beenden</button>
        }
        else
        {
            <button type="button" class="btn btn-ghost btn-sm immersive-start" @onclick="() => SetImmersiveAsync(true)" aria-label="Vollbild: Steuerelemente ausblenden">⛶ Vollbild</button>
        }
    </div>
    @* Fortschritt *@
    <div class="progress-head" role="progressbar" aria-valuenow="@ProgressValue" aria-valuemin="1" aria-valuemax="@ProgressTotal"
         aria-label="@($"{ProgressLabel} {ProgressValue} von {ProgressTotal}")">
        <div class="progress-labels">
            <span>@ProgressLabel @ProgressValue / @ProgressTotal</span>
            <span>@Math.Round(ProgressValue * 100.0 / Math.Max(1, ProgressTotal))%</span>
        </div>
        <div class="progress-track"><div class="progress-fill" style="width:@((ProgressValue * 100.0 / Math.Max(1, ProgressTotal)).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
        @if (TargetTimeSec is > 0)
        {
            <div class="progress-meta">Ziel: @FormatTargetTime(TargetTimeSec.Value)</div>
        }
    </div>

    @* Karte *@
    <div class="flip-scene" @ref="_scene" tabindex="0" role="button" aria-pressed="@(_flipped ? "true" : "false")"
         data-can-prev="@(Index > 0 ? "true" : "false")" data-can-next="@(Index < Total - 1 ? "true" : "false")"
         aria-label="@(_flipped ? $"Rückseite: {Card.Term}" : $"Vorderseite: {Card.Term}. Antippen oder Leertaste zum Umdrehen")"
         @onkeydown="HandleKey">
        <div class="flip-inner @(_flipped ? "flipped" : "")">
            <div class="flip-face flip-front" aria-hidden="@_flipped">
                <div>
                    <span class="pill pill-brand">@Card.Category</span>
                    <h2 class="card-term">@Card.Term</h2>
                    <p class="card-question">@Card.Question</p>
                    @if (Images.Count > 0)
                    {
                        <div class="card-figures" aria-label="Abbildungen zur Karte">
                            @foreach (var img in Images)
                            {
                                <figure class="card-figure">
                                    <img src="@DataUri(img)" alt="@img.AltText" loading="lazy" decoding="async" />
                                    @if (!string.IsNullOrWhiteSpace(img.Caption))
                                    {
                                        <figcaption>@img.Caption</figcaption>
                                    }
                                </figure>
                            }
                        </div>
                    }
                </div>
                <p class="flip-hint"><span class="hint-pointer">Klicken oder <kbd>Space</kbd> zum Umdrehen</span><span class="hint-touch">Tippen zum Umdrehen · nach links/rechts wischen für nächste/vorherige Karte</span></p>
            </div>
            <div class="flip-face flip-back" aria-hidden="@(!_flipped)">
                <div class="back-head">
                    <h3>@Card.Term</h3>
                    <span class="pill pill-muted">@Card.Category</span>
                </div>
                <div class="back-sections">
                    <section aria-label="Definition">
                        <h4>Definition</h4>
                        <RichTextView Value="@Card.Definition" />
                    </section>
                    @if (!string.IsNullOrEmpty(Card.HowItWorks))
                    {
                        <section aria-label="Wie es funktioniert">
                            <h4>⚙️ Wie es funktioniert</h4>
                            <RichTextView Value="@Card.HowItWorks" />
                        </section>
                    }
                    @if (!string.IsNullOrEmpty(Card.Context))
                    {
                        <section aria-label="Kontext">
                            <h4>🧭 Kontext</h4>
                            <RichTextView Value="@Card.Context" />
                        </section>
                    }
                    @if (_flipped && Images.Count > 0)
                    {
                        <section aria-label="Abbildungen">
                            <h4>🖼 Abbildungen</h4>
                            <div class="card-figures">
                                @foreach (var img in Images)
                                {
                                    <figure class="card-figure">
                                        <img src="@DataUri(img)" alt="@img.AltText" loading="lazy" decoding="async" />
                                        @if (!string.IsNullOrWhiteSpace(img.Caption))
                                        {
                                            <figcaption>@img.Caption</figcaption>
                                        }
                                    </figure>
                                }
                            </div>
                        </section>
                    }
                    @if (!string.IsNullOrEmpty(Card.KeyFact))
                    {
                        <div class="keyfact">🎯 <strong>Key Fact:</strong> <RichTextView Value="@Card.KeyFact" CssClass="rt-inline" /></div>
                    }
                    @if (Card.OfficialSources.Count > 0)
                    {
                        <section aria-label="Offizielle Quellen">
                            <h4>📚 Offizielle Quellen</h4>
                            <ul class="source-list">
                                @foreach (var source in Card.OfficialSources)
                                {
                                    <li>
                                        <a href="@source.Url" target="_blank" rel="noreferrer">@source.Title</a>
                                        @if (!string.IsNullOrWhiteSpace(source.Publisher))
                                        {
                                            <span class="muted"> · @source.Publisher</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Aktionsleiste *@
    <div class="card-actions">
        <div class="nav-group">
            <button class="btn btn-ghost btn-touch" @onclick="OnPrevClick" disabled="@(Index == 0)" aria-label="Vorherige Karte">← Zurück</button>
            <button class="btn btn-primary btn-touch" @onclick="Flip" aria-pressed="@(_flipped ? "true" : "false")" aria-label="@(_flipped ? "Frage wieder anzeigen" : "Antwort anzeigen")">@(_flipped ? "Frage zeigen" : "Antwort anzeigen")</button>
            <button class="btn btn-ghost btn-touch" @onclick="OnNextClick" disabled="@(Index >= Total - 1)" aria-label="Nächste Karte">Weiter →</button>
        </div>
        <div class="action-group">
            <button class="btn btn-ghost btn-sm" @onclick="() => OnPageQuizCard.InvokeAsync(Card.Id)" aria-label="Quiz zu dieser Seite starten">📝 Quiz für diese Seite</button>
            <button class="btn btn-ghost btn-sm" @onclick="() => OnQuizCard.InvokeAsync(Card.Id)" aria-label="Quiz nur zu dieser Karte starten">🎯 Karten-Quiz</button>
            @if (CanEdit)
            {
                <a class="btn btn-ghost btn-sm" href="/module/@Card.ModuleId/edit?card=@Card.Id" aria-label="Diese Karte bearbeiten">✏ Bearbeiten</a>
            }
            <button class="btn btn-primary btn-sm" @onclick="() => _chatOpen = !_chatOpen" aria-label="KI-Chatbot zu dieser Karte öffnen">💬 Chat</button>
            <button class="btn btn-sm @(MarkedKnown ? "btn-known-active" : "btn-known")" @onclick="() => OnMarkKnown.InvokeAsync(Card.Id)"
                    aria-pressed="@MarkedKnown" aria-label="Als geprüft markieren">✔ Check</button>
            <button class="btn btn-sm @(MarkedReview ? "btn-review-active" : "btn-review")" @onclick="() => OnMarkReview.InvokeAsync(Card.Id)"
                    aria-pressed="@MarkedReview" aria-label="Zur Wiederholung markieren">↻ Wiederholen</button>
            @if (CanEdit)
            {
                <button class="btn btn-ghost btn-sm" @onclick="() => OnArchive.InvokeAsync(Card.Id)" aria-label="Karte archivieren">🗂 Archivieren</button>
            }
        </div>
    </div>

    <p class="kbd-hint"><kbd>←</kbd><kbd>→</kbd> navigieren · <kbd>G</kbd> Bekannt · <kbd>R</kbd> Wiederholen</p>

    @if (_chatOpen)
    {
        <ChatPanel Card="Card" OnClose="() => _chatOpen = false" />
    }
</div>

@code {
    [Parameter, EditorRequired] public Card Card { get; set; } = default!;
    [Parameter] public int Index { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public bool MarkedKnown { get; set; }
    [Parameter] public bool MarkedReview { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrev { get; set; }
    [Parameter] public EventCallback<string> OnArchive { get; set; }
    /// <summary>Nur der Eigentümer darf archivieren; bei freigegebenen/globalen Modulen ausgeblendet (ADR 0015).</summary>
    [Parameter] public bool CanEdit { get; set; } = true;

    /// <summary>
    /// Darstellbare Bilder (ADR 0017): Der Browser lädt jedes Bild erst bei Bedarf über <c>/api/images/{id}</c> (Berechtigung wie die Karte, unabhängig vom Bildspeicher);
    /// die Karte selbst trägt nur Metadaten. Es werden nie externe URLs geladen; zusätzlich wird hier erneut gegen die MIME-Allowlist geprüft (Defense in depth).
    /// </summary>
    private List<CardImage> Images => Card.Images
        .Where(i => CardImageLimits.IsAllowedMimeType(i.MimeType) && Guid.TryParse(i.ImageId, out _))
        .ToList();

    private static string DataUri(CardImage img) => "/api/images/" + img.ImageId;
    [Parameter] public EventCallback<string> OnQuizCard { get; set; }
    [Parameter] public EventCallback<string> OnPageQuizCard { get; set; }
    [Parameter] public EventCallback<string> OnMarkKnown { get; set; }
    [Parameter] public EventCallback<string> OnMarkReview { get; set; }
    [Parameter] public string ProgressLabel { get; set; } = "Karte";
    [Parameter] public int? ProgressValueOverride { get; set; }
    [Parameter] public int? ProgressTotalOverride { get; set; }
    [Parameter] public int? TargetTimeSec { get; set; }

    private bool _flipped;
    private bool _chatOpen;
    private string _lastCardId = "";
    private ElementReference _scene;
    private DotNetObjectReference<FlashCardView>? _self;
    private bool _immersive, _controls;

    private async Task SetImmersiveAsync(bool on)
    {
        _immersive = on; _controls = false;
        try { await JS.InvokeVoidAsync("lcCards.immersive", on, _self); } catch (Exception) { /* ohne JavaScript bleibt die normale Ansicht */ }
    }

    /// <summary>Vom Browser beendetes Vollbild (Escape, Systemgeste): Zustand angleichen.</summary>
    [JSInvokable]
    public Task OnImmersiveExited() => InvokeAsync(() => { _immersive = false; _controls = false; StateHasChanged(); });
    private int ProgressValue => ProgressValueOverride ?? (Index + 1);
    private int ProgressTotal => ProgressTotalOverride ?? Total;

    protected override void OnParametersSet()
    {
        if (Card.Id != _lastCardId)
        {
            _lastCardId = Card.Id;
            _flipped = false;
        }
    }

    private void Flip() => _flipped = !_flipped;

    private async Task OnNextClick() => await OnNext.InvokeAsync();
    private async Task OnPrevClick() => await OnPrev.InvokeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { _self = DotNetObjectReference.Create(this); await JS.InvokeVoidAsync("lcCards.attach", _scene, _self); }
        catch (Exception) { /* ohne JavaScript bleiben Schaltflächen und Tastatur (auf der Karte) nutzbar */ }
    }

    /// <summary>Wisch- oder Pfeiltastenaktion aus cards.js: dieselben Aktionen wie die Schaltflächen „Zurück“/„Weiter“ (mit Grenzen).</summary>
    [JSInvokable]
    public async Task OnSwipe(string direction)
    {
        if (direction == "next" && Index < Total - 1) await OnNext.InvokeAsync();
        else if (direction == "prev" && Index > 0) await OnPrev.InvokeAsync();
    }

    /// <summary>Einfaches Tippen/Klicken auf die Kartenfläche (nicht auf Links, Schaltflächen oder Eingaben): Karte umdrehen.</summary>
    [JSInvokable]
    public Task OnTap() => InvokeAsync(() => { Flip(); StateHasChanged(); });

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("lcCards.immersive", false, null); await JS.InvokeVoidAsync("lcCards.detach", _scene); } catch (Exception) { /* Verbindung bereits beendet */ }
        _self?.Dispose();
    }

    private static string FormatTargetTime(int seconds)
    {
        var span = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return $"{(int)span.TotalMinutes}:{span.Seconds:00} Min";
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case " ": case "Enter": Flip(); break;
            case "g": case "G": await OnMarkKnown.InvokeAsync(Card.Id); break;
            case "r": case "R": await OnMarkReview.InvokeAsync(Card.Id); break;
        }
    }
}
