@* Modulquiz (Prüfungsmodus): Umfang wählen → gemeinsame Quiz-Engine/-Oberfläche (ADR 0019) *@
@inject QuizService Quiz
@inject AuthenticationStateProvider AuthState

<div class="modal-backdrop" @onclick="CloseIfIdle">
    <div class="modal" role="dialog" aria-modal="true" aria-label="Prüfungsmodus" @onclick:stopPropagation>
        <div class="modal-head">
            <h2>🎓 Prüfungsmodus @TitleSuffix</h2>
            <button class="icon-btn" @onclick="() => OnClose.InvokeAsync()" aria-label="Quiz schließen">✕</button>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">@_error</div>
        }

        @if (_phase == Phase.Config)
        {
            <p class="muted">Die Fragen kommen aus dem gespeicherten Fragenpool des Moduls und – laut Quizeinstellungen – aus KI-Generierung bzw. den Karten. Auswahlfragen werden sofort, Freitext per KI bewertet (ohne KI lokal).</p>
            @if (_config is not null && !_config.Config.Enabled)
            {
                <div class="alert alert-error" role="alert">Das Quiz ist für dieses Modul deaktiviert.</div>
            }
            else
            {
                var max = Math.Max(1, _config?.Config.QuestionCount ?? 15);
                if (_numQuestions > max) _numQuestions = max;
                <label class="form-label" for="numq">Anzahl Fragen: <strong>@_numQuestions</strong> <span class="muted">(höchstens @max laut Einstellung)</span></label>
                <input id="numq" type="range" min="1" max="@max" class="range" @bind="_numQuestions" @bind:event="oninput" />
                @if (_config is not null)
                {
                    <p class="muted">Bestehensgrenze @_config.Config.PassPercent% · @(_config.Config.AllowRetry ? "Wiederholung erlaubt" : "nur ein Versuch")</p>
                }
            }
            @if (_history.Count > 0)
            {
                <details class="chat-history quiz-history">
                    <summary>Quiz-Verlauf anzeigen (@_history.Count)</summary>
                    <div class="quiz-history-list">
                        @foreach (var entry in _history)
                        {
                            <details class="graded-item quiz-run-item">
                                <summary class="quiz-run-summary">
                                    <div class="quiz-run-head">
                                        <div>
                                            <div class="graded-q">Quizlauf vom @entry.Result.CompletedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                            <div class="graded-f">
                                                <span class="pill">@entry.Result.Score / @entry.Result.MaxScore Punkte</span>
                                                <span class="pill">Note @entry.Result.Grade</span>
                                                <span class="pill">@entry.Stats.QuestionCount Fragen</span>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteHistoryEntryAsync(entry.Result.Id)" @onclick:stopPropagation>Löschen</button>
                                    </div>
                                </summary>
                                <div class="graded-a muted">
                                    Genutzte Karten: @entry.Stats.UsedCheckedCardCount / @entry.Stats.CheckedCardCount ·
                                    Gewichtung: @entry.Stats.DistributionWeight ·
                                    Fragen pro genutzter Karte: @entry.Stats.QuestionsPerUsedCard
                                </div>
                                @if (entry.Stats.CardUsage.Count > 0)
                                {
                                    <div class="graded-label">Kartenverteilung</div>
                                    <ul class="source-list">
                                        @foreach (var usage in entry.Stats.CardUsage)
                                        {
                                            <li>@usage.Term (@usage.Category): @usage.QuestionCount Frage(n), Gewicht @((usage.RelativeWeight * 100).ToString("0.#"))%</li>
                                        }
                                    </ul>
                                }
                                @if (entry.Answers.Count > 0)
                                {
                                    <div class="graded-label">Fragen dieses Quizlaufs</div>
                                    <div class="graded-list">
                                        @foreach (var answer in entry.Answers)
                                        {
                                            <div class="graded-item quiz-answer-item">
                                                <div class="graded-q">@answer.Question</div>
                                                @if (!string.IsNullOrWhiteSpace(answer.SourceTerm))
                                                {
                                                    <div class="graded-a muted">Quellenkarte: @answer.SourceTerm</div>
                                                }
                                                <div class="graded-label">Gegebene Antwort</div>
                                                <div class="graded-a muted">@answer.UserAnswer</div>
                                                <div class="graded-f"><span class="pill">@answer.Score / @answer.Max</span> @answer.Feedback</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </details>
                        }
                    </div>
                </details>
            }
            <div class="modal-actions">
                <button class="btn btn-ghost" @onclick="() => OnClose.InvokeAsync()">Abbrechen</button>
                <button class="btn btn-primary" @onclick="StartAsync" disabled="@(_loading || (_config is not null && !_config.Config.Enabled))">
                    @(_loading ? "Fragen werden generiert…" : "Quiz starten")
                </button>
            </div>
        }
        else if (_phase == Phase.Running && _session is not null)
        {
            <QuizRunner Session="_session" OnClose="OnClose" OnRestart="RestartAsync" OnSubmitted="LoadHistoryAsync" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string ModuleId { get; set; } = "";
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public string CardId { get; set; } = "";
    [Parameter] public string CardTerm { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private enum Phase { Config, Running }
    private Phase _phase = Phase.Config;
    private int _numQuestions = 5;
    private QuizStartResponse? _session;
    private QuizConfigView? _config;
    private bool _loading;
    private string? _error;
    private string _userSub = "";
    private List<QuizHistoryEntry> _history = new();

    private string TitleSuffix => !string.IsNullOrWhiteSpace(CardTerm)
        ? $"— Karte: {CardTerm}"
        : (string.IsNullOrEmpty(Category) ? "" : $"— {Category}");

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userSub = auth.User.GetUserId() ?? throw new UnauthorizedAccessException();
        try { _config = await Quiz.GetConfigViewAsync(ModuleId, _userSub); if (_numQuestions > _config.Config.QuestionCount) _numQuestions = _config.Config.QuestionCount; }
        catch (KeyNotFoundException) { _config = null; }
        await LoadHistoryAsync();
    }

    private async Task StartAsync()
    {
        _loading = true; _error = null;
        try
        {
            _session = await Quiz.StartSessionAsync(ModuleId, Category, string.IsNullOrWhiteSpace(CardId) ? null : CardId, _numQuestions, _userSub);
            _phase = Phase.Running;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private Task RestartAsync()
    {
        _phase = Phase.Config;
        _session = null;
        return Task.CompletedTask;
    }

    private async Task CloseIfIdle()
    {
        if (_phase == Phase.Config && !_loading) await OnClose.InvokeAsync();
    }

    private async Task LoadHistoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_userSub))
        {
            _history = new();
            return;
        }
        _history = await Quiz.GetHistoryAsync(_userSub, ModuleId, CardId, 10);
    }

    private async Task DeleteHistoryEntryAsync(string quizId)
    {
        try
        {
            await Quiz.DeleteHistoryEntryAsync(_userSub, quizId);
            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            _error = "Quizverlauf konnte nicht gelöscht werden: " + ex.Message;
        }
    }
}
