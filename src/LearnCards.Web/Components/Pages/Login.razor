@page "/login"
@attribute [AllowAnonymous]
@layout Layout.MainLayout
@inject AppConfig Config
@inject NavigationManager Nav

<PageTitle>Anmelden — LearnCards</PageTitle>

<div class="login-wrap">
    <div class="login-card">
        <div class="login-logo" aria-hidden="true">
            <svg viewBox="0 0 64 64" width="34" height="34"><rect x="6" y="10" width="52" height="44" rx="10" fill="white"/><path d="M18 24h28M18 33h28M18 42h16" stroke="var(--brand-600)" stroke-width="4" stroke-linecap="round"/></svg>
        </div>
        <h1>LearnCards</h1>
        <p class="login-sub">Interaktive Lernkarten mit KI-Chatbot und Prüfungsmodus</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-error" role="alert">Anmeldefehler: @Error</div>
        }

        @if (Config.AuthMode == "oidc")
        {
            <a class="btn btn-primary btn-lg btn-block" href="@LoginHref">
                <svg width="18" height="18" viewBox="0 0 21 21" aria-hidden="true"><rect x="1" y="1" width="9" height="9" fill="#f25022"/><rect x="11" y="1" width="9" height="9" fill="#7fba00"/><rect x="1" y="11" width="9" height="9" fill="#00a4ef"/><rect x="11" y="11" width="9" height="9" fill="#ffb900"/></svg>
                Mit Microsoft anmelden
            </a>
            <p class="login-note">Anmeldung über OpenID Connect (Entra&nbsp;ID)</p>
        }
        else
        {
            <a class="btn btn-primary btn-lg btn-block" href="@LoginHref">🧑‍💻 Lokal anmelden (Dev-Modus)</a>
            <p class="login-note">AUTH_MODE=dev — ohne Entra ID. Für Produktion OIDC in der .env konfigurieren.</p>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string LoginHref => "/auth/login?returnUrl=" + Uri.EscapeDataString(
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') ? ReturnUrl : "/");
}
