@page "/topics"
@attribute [Authorize]
@rendermode InteractiveServer
@inject TopicService TopicApi
@inject CardRepository Repo
@inject FavoritesService Favs
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Themen — LearnCards</PageTitle>

<div class="container">
    <div class="page-head">
        <div>
            <h1>Themen</h1>
            <p class="muted">Ein Thema fasst mehrere <strong>eigene Module</strong> zu einem Lernpfad mit Modulprüfungen und einer Abschlussprüfung zusammen.</p>
        </div>
        <div class="page-head-actions">
            <a class="btn btn-ghost" href="/">← Module</a>
            @if (!_restricted)
            {
            <label class="btn btn-ghost file-btn" title="Neues privates Thema aus einer learny-topic-Definition (Entwurf, keine Veröffentlichung)">
                ⬆ Thema aus JSON erstellen
                <InputFile OnChange="ImportJsonAsync" accept=".json" disabled="@_importing" />
            </label>
            <button class="btn btn-primary" @onclick="() => _showCreate = !_showCreate">＋ Neues Thema</button>
            }
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="alert @(_error ? "alert-error" : "alert-ok")" role="status">@_message</div>
    }

    @if (_showCreate)
    {
        <div class="card panel create-module">
            <h2 class="panel-title">Neues Thema anlegen</h2>
            <div class="form-row">
                <input class="input" placeholder="Name, z. B. Microsoft 365 Administration" maxlength="120" @bind="_newName" aria-label="Name des Themas" />
                <input class="input" placeholder="Beschreibung (optional)" maxlength="2000" @bind="_newDescription" aria-label="Beschreibung" />
                <button class="btn btn-primary" @onclick="CreateAsync" disabled="@string.IsNullOrWhiteSpace(_newName)">Anlegen</button>
            </div>
        </div>
    }

    <div class="tab-row" role="tablist" aria-label="Themenbereich wählen">
        <button class="chip @(_tab == "own" ? "chip-active" : "")" role="tab" aria-selected="@(_tab == "own")" @onclick='() => _tab = "own"'>Meine Themen (@_overview.Own.Count)</button>
        <button class="chip @(_tab == "shared" ? "chip-active" : "")" role="tab" aria-selected="@(_tab == "shared")" @onclick='() => _tab = "shared"'>Mit mir geteilt (@_overview.Shared.Count)</button>
        <button class="chip @(_tab == "assigned" ? "chip-active" : "")" role="tab" aria-selected="@(_tab == "assigned")" @onclick='() => _tab = "assigned"'>Mir zugewiesen (@_overview.Assigned.Count)</button>
        <button class="chip @(_tab == "global" ? "chip-active" : "")" role="tab" aria-selected="@(_tab == "global")" @onclick='() => _tab = "global"'>Globale Themen (@_overview.Global.Count)</button>
        @if (_tab == "own")
        {
            <label class="chip-check"><input type="checkbox" checked="@_archived" @onchange="async e => { _archived = (bool)(e.Value ?? false); await LoadAsync(); }" /> Archivierte anzeigen</label>
        }
    </div>

    @if (_loading)
    {
        <div class="spinner-wrap" aria-busy="true"><div class="spinner" role="status"></div></div>
    }
    else if (Current.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon" aria-hidden="true">🧭</div>
            <h2>@EmptyTitle</h2>
            <p>@EmptyText</p>
        </div>
    }
    else
    {
        var shown = Shown();
        var groups = ListGrouping.By(shown, GroupKey());
        <ListToolbar Placeholder="Themen suchen" @bind-Query="_q" @bind-Sort="_sort" SortOptions="SortOpts" @bind-Group="_group" GroupOptions="GroupOpts" @bind-FavoritesOnly="_favOnly" FavoriteCount="@Current.Count(t => _favs.Contains(t.Topic.Id))"
                     @bind-View="_view" StorageKey="view.topics" Total="@Current.Count" Shown="@shown.Count">
            <Filters>
                <select class="input compact" @bind="_flt" aria-label="Filter">
                    <option value="">Alle Stände</option>
                    <option value="mandatory">Nur Pflicht</option>
                    <option value="open">Nicht abgeschlossen</option>
                    <option value="done">Abgeschlossen</option>
                    <option value="global">Global</option>
                </select>
            </Filters>
        </ListToolbar>
        @if (shown.Count == 0)
        {
            <div class="empty-state"><p class="empty-title">Keine Treffer.</p><p class="muted">Suche oder Filter anpassen@(_favOnly ? " bzw. „Favoriten“ ausschalten" : "").</p></div>
        }
        else if (_view == "list")
        {
            <div class="card table-wrap list-view">
                <table class="table">
                    <caption class="sr-only">Themen</caption>
                    <thead><tr><th class="sr-only">Favorit</th><th>Thema</th><th>Stand</th><th>Umfang</th><th>Fortschritt</th><th>Fällig</th><th><span class="sr-only">Aktionen</span></th></tr></thead>
                    <tbody>
                        @foreach (var g in groups)
                        {
                        @if (g.Title.Length > 0) { <tr class="group-row"><th colspan="7" scope="colgroup">@g.Title (@g.Items.Count)</th></tr> }
                        @foreach (var t in g.Items)
                        {
                            var pct = t.Progress is { ModulesTotal: > 0 } pr ? pr.ModulesCompleted * 100 / pr.ModulesTotal : 0;
                            <tr class="clickable" tabindex="0" @onclick='() => Nav.NavigateTo("/topics/" + t.Topic.Id)' @onkeydown='e => { if (e.Key == "Enter") Nav.NavigateTo("/topics/" + t.Topic.Id); }'>
                                <td><FavoriteButton Active="_favs.Contains(t.Topic.Id)" Label="@t.Topic.Name" OnToggle="() => ToggleFav(t.Topic.Id)" /></td>
                                <td><div class="name-cell"><div><strong>@t.Topic.Name</strong>@if (t.Topic.Description.Length > 0) { <small>@t.Topic.Description</small> }</div></div></td>
                                <td>
                                    @if (t.Version > 0) { <span class="badge">v@(t.Version)</span> } else { <span class="badge badge-draft">Entwurf</span> }
                                    @if (t.GlobalStatus == "active") { <span class="badge badge-pass">global</span> }
                                    @if (t.Mandatory) { <span class="badge badge-warn">Pflicht</span> }
                                    @if (t.NewerVersionAvailable) { <span class="badge badge-warn">neue Version</span> }
                                </td>
                                <td>@t.Stats.Modules Module · @t.Stats.Cards Karten</td>
                                <td>@if (t.Progress is not null) { <span class="progress-mini" aria-hidden="true"><span style="width:@(pct)%"></span></span><span>@pct %</span> } else { <span class="muted">—</span> }</td>
                                <td>@(t.DueAt is DateTime due ? due.ToLocalTime().ToString("dd.MM.yyyy") + (t.Overdue ? " · überfällig" : "") : "")</td>
                                <td class="actions"><a class="btn btn-ghost btn-sm" href="/topics/@t.Topic.Id" @onclick:stopPropagation="true">Öffnen</a></td>
                            </tr>
                        }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
        @foreach (var g in groups)
        {
        @if (g.Title.Length > 0) { <h3 class="group-head">@g.Title <span class="count">(@g.Items.Count)</span></h3> }
        <div class="module-grid">
            @foreach (var t in g.Items)
            {
                <a class="module-card topic-card" href="/topics/@t.Topic.Id" aria-label="@($"Thema {t.Topic.Name} öffnen")">
                    <FavoriteButton Active="_favs.Contains(t.Topic.Id)" Label="@t.Topic.Name" OnToggle="() => ToggleFav(t.Topic.Id)" />
                    <h2>@t.Topic.Name</h2>
                    @if (t.Topic.Description.Length > 0)
                    {
                        <p class="muted topic-desc">@t.Topic.Description</p>
                    }
                    <p class="topic-badges">
                        @if (t.Version > 0) { <span class="badge">Version @t.Version</span> } else { <span class="badge badge-draft">Entwurf</span> }
                        @if (t.Topic.Status == "archived") { <span class="badge badge-draft">archiviert</span> }
                        @if (t.Section == "own" && t.Topic.HasUnpublishedChanges) { <span class="badge badge-warn">unveröffentlichte Änderungen</span> }
                        @if (t.GlobalStatus == "active") { <span class="badge badge-pass">global</span> }
                        else if (t.GlobalStatus == "pending_approval") { <span class="badge badge-warn">Freigabe offen</span> }
                        else if (t.GlobalStatus == "rejected") { <span class="badge badge-warn">global abgelehnt</span> }
                        @if (t.NewerVersionAvailable) { <span class="badge badge-warn">neue Version verfügbar</span> }
                        @if (t.Section != "own")
                        {
                            @if (t.Mandatory) { <span class="badge badge-warn">Pflicht</span> }
                            else if (t.Relation == "assigned_voluntary") { <span class="badge">zugewiesen · freiwillig</span> }
                            else if (t.Relation == "shared") { <span class="badge">freigegeben</span> }
                            else { <span class="badge">global · freiwillig</span> }
                            @if (t.DueAt is DateTime due) { <span class="badge @(t.Overdue ? "badge-warn" : "")">fällig @due.ToLocalTime().ToString("dd.MM.yyyy")@(t.Overdue ? " · überfällig" : "")</span> }
                            @if (t.Progress is { } sp) { <span class="badge @(sp.Status == "completed" ? "badge-pass" : "")">@(sp.Status == "completed" ? "abgeschlossen" : sp.Status == "in_progress" ? "in Bearbeitung" : "nicht begonnen")</span> }
                        }
                        @if (t.Section != "own" && t.Topic.OwnerName.Length > 0) { <span class="muted">von @t.Topic.OwnerName</span> }
                    </p>
                    <ul class="topic-stats" aria-label="Umfang">
                        <li><strong>@t.Stats.Modules</strong> Module</li>
                        <li><strong>@t.Stats.Cards</strong> Lernkarten</li>
                        <li><strong>@t.Stats.ChoiceQuestions</strong> Multiple-Choice-Fragen</li>
                        <li><strong>@t.Stats.FinalExamQuestions</strong> Abschlussprüfungsfragen</li>
                    </ul>
                    @if (t.Progress is { } p)
                    {
                        <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="@p.ModulesTotal" aria-valuenow="@p.ModulesCompleted" aria-label="Lernfortschritt">
                            <div class="progress-fill" style="width:@(p.ModulesTotal == 0 ? 0 : p.ModulesCompleted * 100 / p.ModulesTotal)%"></div>
                        </div>
                        <p class="progress-meta">@p.ModulesCompleted von @p.ModulesTotal Modulen abgeschlossen@(p.FinalExamPassed ? " · Abschlussprüfung bestanden" : "")</p>
                    }
                    @if (t.Section == "own" && (t.SharedWithCount > 0 || t.AssignedCount > 0))
                    {
                        <p class="muted">@t.SharedWithCount geteilt · @t.AssignedCount zugewiesen</p>
                    }
                    @if (t.Section == "own")
                    {
                        <span class="btn btn-ghost btn-sm" role="link">Öffnen</span>
                    }
                </a>
            }
        </div>
        }
        }
    }
</div>

@code {
    private TopicService.TopicOverview _overview = new();
    private string _tab = "own";
    private bool _loading = true;
    private bool _showCreate;
    private string _q = "", _sort = "fav", _view = "tiles", _flt = "";
    /// <summary>Direktlink auf eine Ansicht: <c>?view=list</c> bzw. <c>?view=tiles</c> (überschreibt die gemerkte Ansicht beim Start).</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    /// <summary>Direktlink auf einen Bereich: <c>?tab=own|shared|assigned|global</c> (z. B. Startziel nach der Anmeldung).</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
    private bool _favOnly;
    private HashSet<string> _favs = new(StringComparer.OrdinalIgnoreCase);
    private static readonly (string Value, string Label)[] SortOpts = { ("fav", "Favoriten zuerst"), ("name", "Name A–Z"), ("name_desc", "Name Z–A"), ("due", "Fälligkeit"), ("updated", "Zuletzt geändert") };
    private static readonly (string Value, string Label)[] GroupOpts = { ("", "keine"), ("status", "Lernstatus"), ("pub", "Veröffentlichung"), ("due", "Fälligkeit"), ("date", "Änderungsmonat") };
    private string _group = "";

    private Func<TopicSummary, (int Order, string Title)>? GroupKey() => _group switch
    {
        "status" => t => t.Overdue ? (0, "Pflicht überfällig") : t.Mandatory && t.Progress?.Status != "completed" ? (1, "Pflicht offen") : t.Progress?.Status == "in_progress" ? (2, "In Bearbeitung") : t.Progress?.Status == "completed" ? (4, "Abgeschlossen") : (3, "Nicht begonnen"),
        "pub" => t => t.GlobalStatus == "pending_approval" ? (0, "Veröffentlichung offen (Freigabe ausstehend)") : t.GlobalStatus == "rejected" ? (1, "Global abgelehnt") : t.Version == 0 ? (2, "Entwurf") : t.Section == "own" && t.Topic.HasUnpublishedChanges ? (3, "Veröffentlicht, mit unveröffentlichten Änderungen") : t.GlobalStatus == "active" ? (5, "Global veröffentlicht") : (4, "Veröffentlicht"),
        "due" => t => t.DueAt is not DateTime d ? (3, "Ohne Frist") : t.Overdue ? (0, "Überfällig") : d.ToUniversalTime() < DateTime.UtcNow.AddDays(7) ? (1, "Diese Woche fällig") : (2, "Später fällig"),
        "date" => t => ListGrouping.Month(t.Topic.UpdatedAt),
        _ => null,
    };

    private List<TopicSummary> Shown()
    {
        var q = _q.Trim();
        IEnumerable<TopicSummary> r = Current.Where(t =>
            (q.Length == 0 || t.Topic.Name.Contains(q, StringComparison.CurrentCultureIgnoreCase) || t.Topic.Description.Contains(q, StringComparison.CurrentCultureIgnoreCase))
            && (!_favOnly || _favs.Contains(t.Topic.Id))
            && (_flt switch
            {
                "mandatory" => t.Mandatory,
                "open" => t.Progress is null || t.Progress.Status != "completed",
                "done" => t.Progress is { Status: "completed" },
                "global" => t.GlobalStatus == "active",
                _ => true,
            }));
        var cmp = StringComparer.CurrentCultureIgnoreCase;
        r = _sort switch
        {
            "name" => r.OrderBy(t => t.Topic.Name, cmp),
            "name_desc" => r.OrderByDescending(t => t.Topic.Name, cmp),
            "due" => r.OrderBy(t => t.DueAt ?? DateTime.MaxValue).ThenBy(t => t.Topic.Name, cmp),
            "updated" => r.OrderByDescending(t => t.Topic.UpdatedAt).ThenBy(t => t.Topic.Name, cmp),
            _ => r.OrderByDescending(t => _favs.Contains(t.Topic.Id)).ThenBy(t => t.Topic.Name, cmp),
        };
        return r.ToList();
    }

    private async Task ToggleFav(string id)
    {
        try { if (await Favs.ToggleAsync(_userId, "topic", id)) _favs.Add(id); else _favs.Remove(id); }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException) { _message = e.Message; _error = true; }
    }
    private bool _restricted;
    private bool _archived;
    private string _newName = "", _newDescription = "";
    private string? _message;
    private bool _error;
    private string _userId = "";
    private bool _importing;

    private async Task ImportJsonAsync(InputFileChangeEventArgs e)
    {
        _importing = true; _message = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 28 * 1024 * 1024));
            var topic = await TopicApi.CreateFromDefinitionAsync(_userId, await reader.ReadToEndAsync());
            Nav.NavigateTo($"/topics/{topic.Id}/edit");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException or IOException) { Fail(ex.Message); }
        _importing = false;
    }

    private List<TopicSummary> Current => _tab switch
    {
        "shared" => _overview.Shared, "assigned" => _overview.Assigned, "global" => _overview.Global, _ => _overview.Own,
    };

    private string EmptyTitle => _tab switch
    {
        "shared" => "Noch nichts mit dir geteilt", "assigned" => "Keine zugewiesenen Themen", "global" => "Noch keine globalen Themen", _ => "Noch kein Thema",
    };

    private string EmptyText => _tab switch
    {
        "shared" => "Themen, die andere Benutzer für dich freigeben, erscheinen hier.",
        "assigned" => "Themen, die dir als Lernaufgabe zugewiesen werden, erscheinen hier.",
        "global" => "Vom Administrator freigegebene Themen erscheinen hier.",
        _ => "Lege ein Thema an und ordne deine Lernmodule zu.",
    };

    protected override async Task OnInitializedAsync()
    {
        if (ViewQuery is "tiles" or "list") _view = ViewQuery;
        if (TabQuery is "own" or "shared" or "assigned" or "global") _tab = TabQuery;
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId = auth.User.GetUserId() ?? throw new UnauthorizedAccessException();
        _restricted = await Repo.IsRestrictedLearnerAsync(_userId);   // externe Lernprofile: kein Anlegen, kein Import
        _favs = await Favs.ListAsync(_userId, "topic");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _overview = await TopicApi.ListOverviewAsync(_userId, _archived); }
        catch (Exception ex) when (ex is not OperationCanceledException) { Fail(ex.Message); }
        _loading = false;
    }

    private async Task CreateAsync()
    {
        try
        {
            var topic = await TopicApi.CreateAsync(_userId, _newName, _newDescription);
            Nav.NavigateTo($"/topics/{topic.Id}/edit");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException) { Fail(ex.Message); }
    }

    private void Fail(string text) { _message = text; _error = true; }
}
