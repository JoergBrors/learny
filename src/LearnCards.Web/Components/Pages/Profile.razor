        if (_genBusy) return;
        if (_gallery.Count >= MaxVariants) { _message = $"❌ Du hast schon {MaxVariants} Vorschläge. Übernimm einen oder verwirf einen."; _messageOk = false; return; }
        _genBusy = true; _genNote = null;
