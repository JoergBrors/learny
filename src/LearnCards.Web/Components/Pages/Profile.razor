@page "/profile"
@attribute [Authorize]
@rendermode InteractiveServer
@inject UserService Users
@inject McpLinkService McpLinks
@inject SharingService Sharing
@inject CardRepository Repo
@inject CertificateService Certs
@inject AuthenticationStateProvider AuthState
@inject UserUiState UiState
@inject AvatarGeneratorService AvatarGen

<PageTitle>Mein Profil — LearnCards</PageTitle>

<div class="container">
    <div class="page-head">
        <div>
            <h1>Mein Profil</h1>
            <p class="muted">Persönliche Angaben, Rollen, eigene Inhalte und Lernergebnisse</p>
        </div>
        <div class="page-head-actions">
            <a class="btn btn-ghost" href="/">← Module</a>
            @if (_user is { IsAdmin: true })
            {
                <a class="btn btn-ghost" href="/admin">🛠 Administration</a>
            }
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="alert @(_messageOk ? "alert-ok" : "alert-error")" role="status">@_message</div>
    }

    @if (_user is null)
    {
        <p class="muted">Profil wird geladen …</p>
    }
    else
    {
        <div class="card panel" id="avatar">
            <h2 class="panel-title">Mein Avatar</h2>
            <p class="muted">Dein freundlicher Lernbegleiter im Dashboard. Die Auswahl ist freiwillig und rein dekorativ: sie ändert keine Rechte, Lernstände oder Bewertungen. Ohne Auswahl siehst du deine Initialen.</p>
            <div class="avatar-layout">
                <div class="avatar-preview">
                    <Avatar Preset="@UiState.AvatarPreset" Hidden="@UiState.AvatarHidden" Name="@_user.DisplayName" Size="120" State="@_avState" />
                    <div class="role-toggles" role="group" aria-label="Stimmung der Vorschau">
                        @foreach (var st in new[] { ("neutral", "Neutral"), ("happy", "Freundlich"), ("motivating", "Motivierend"), ("success", "Erfolgreich"), ("encouraging", "Ermutigend") })
                        {
                            var key = st.Item1;
                            <button type="button" class="chip @(_avState == key ? "chip-active" : "")" aria-pressed="@(_avState == key ? "true" : "false")" @onclick="() => _avState = key">@st.Item2</button>
                        }
                    </div>
                </div>
                <div>
                    <div class="avatar-picker" role="radiogroup" aria-label="Avatar auswählen">
                        @foreach (var a in Avatars.All)
                        {
                            var id = a.Id;
                            <button type="button" role="radio" class="avatar-choice" aria-checked="@(UiState.AvatarPreset == id ? "true" : "false")" title="@a.Name" @onclick="() => PickAvatarAsync(id)">
                                <Avatar Preset="@id" Name="@a.Name" Size="64" Animate="false" /><span>@a.Name</span>
                            </button>
                        }
                    </div>
                    <div class="avatar-gen" style="margin-top:1rem">
                        <h3 class="panel-subtitle">Avatar-Generator</h3>
                        <p class="muted">Beschreibe deinen Avatar in einem Satz. @(AvatarGen.AiAvailable ? "Die KI wählt passende Merkmale aus dem Baukasten; der Text wird dazu an den KI-Dienst gesendet (nicht gespeichert)." : "Die KI ist nicht eingerichtet: Es werden Stichwörter ausgewertet (Offline-Hilfe).") Es entstehen keine Fotos oder freien Bilder.</p>
                        <div class="actions" role="group" aria-label="Beispielbeschreibungen">
                            @foreach (var ex in AvatarExamples)
                            {
                                var text = ex;
                                <button type="button" class="chip" @onclick="() => _genText = text">@text</button>
                            }
                        </div>
                        <label class="field" style="margin-top:.5rem"><span class="muted">Beschreibung (änderbar)</span>
                            <textarea rows="2" maxlength="@AvatarGeneratorService.MaxDescriptionLength" @bind="_genText" @bind:event="oninput" placeholder="z. B. freundliche Person mit roten Locken, Brille und grünem Pullover"></textarea></label>
                        <div class="actions" style="margin-top:.5rem">
                            <button type="button" class="btn btn-primary btn-sm" disabled="@(_genBusy || string.IsNullOrWhiteSpace(_genText))" @onclick="GenerateAvatarAsync">@(_genBusy ? "Erstelle …" : "Vorschlag erstellen")</button>
                        </div>
                        @if (_genId is not null)
                        {
                            <p class="muted" style="margin-top:.6rem" aria-live="polite">@_genSummary</p>
                            <div class="avatar-moods" role="group" aria-label="Der Vorschlag in allen Stimmungen">
                                @foreach (var st in new[] { ("neutral", "Neutral"), ("happy", "Freundlich"), ("motivating", "Motivierend"), ("success", "Erfolgreich"), ("encouraging", "Ermutigend") })
                                {
                                    <figure class="avatar-mood"><Avatar Preset="@_genId" Name="@st.Item2" Size="72" State="@st.Item1" /><figcaption>@st.Item2</figcaption></figure>
                                }
                            </div>
                            <div class="actions" style="margin-top:.5rem">
                                <button type="button" class="btn btn-primary btn-sm" @onclick="AcceptGeneratedAsync">Übernehmen</button>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="GenerateAvatarAsync" disabled="@_genBusy">Neu erzeugen</button>
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _genId = null">Verwerfen</button>
                            </div>
                        }
                    </div>
                    <div class="actions" style="margin-top:.8rem">
                        <label class="pick"><input type="checkbox" checked="@UiState.AvatarHidden" @onchange="e => HideAvatarAsync(e.Value is true)" /> Avatar ausblenden (nur Initialen)</label>
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="ResetAvatarAsync">Zurücksetzen</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card panel">
            <h2 class="panel-title">Persönliche Angaben</h2>
            <label class="form-label" for="displayName">Anzeigename</label>
            <div class="form-row">
                <input id="displayName" class="input" maxlength="80" @bind="_displayName" />
                <button class="btn btn-primary" @onclick="SaveName" disabled="@string.IsNullOrWhiteSpace(_displayName)">Speichern</button>
            </div>
            <dl class="kv">
                <dt>E-Mail</dt><dd>@(string.IsNullOrEmpty(_user.Email) ? "—" : _user.Email)</dd>
                <dt>Status</dt><dd>@(_user.IsActive ? "Aktiv" : "Gesperrt")</dd>
                <dt>Benutzer-ID</dt><dd><code>@_user.Id</code></dd>
                <dt>Mitglied seit</dt><dd>@_user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</dd>
                <dt>Letzte Anmeldung</dt><dd>@_user.LastLoginAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>
        </div>

        <div class="card panel">
            <h2 class="panel-title">Rollen</h2>
            <p>
                @foreach (var role in _user.Roles)
                {
                    <span class="badge badge-@role">@RoleLabel(role)</span>
                }
            </p>
            <p class="muted">Rollen werden von Administratoren oder über die App-Rollen in Entra ID vergeben (bei jeder Anmeldung abgeglichen) und können hier nicht geändert werden.</p>
            @if (_identities.Count > 0)
            {
                <h3>Verknüpfte Anmeldungen</h3>
                <ul class="plain-list">
                    @foreach (var i in _identities)
                    {
                        <li><code>@i.Provider</code> · @Shorten(i.Subject)</li>
                    }
                </ul>
            }
        </div>

        <div class="card panel">
            <h2 class="panel-title">Meine privaten Lerninhalte</h2>
            <p>
                <strong>@_summary.Modules</strong> Module ·
                <strong>@_summary.ActiveCards</strong> aktive Karten ·
                <strong>@_summary.ArchivedCards</strong> archivierte Karten
            </p>
            <p class="muted">Alle Module und Karten sind privat. Nur du siehst sie.</p>
        </div>

        <div class="card panel">
            <h2 class="panel-title">Freigaben</h2>
            <h3>Von mir geteilt</h3>
            @if (_outgoing.Count == 0)
            {
                <p class="muted">Du hast noch kein Modul freigegeben. Öffne ein eigenes Modul und wähle „Modul freigeben“.</p>
            }
            else
            {
                <ul class="plain-list share-results">
                    @foreach (var s in _outgoing)
                    {
                        <li>
                            <span><a href="/module/@s.ModuleId"><strong>@s.ModuleName</strong></a> → @s.RecipientName <span class="muted">(@s.RecipientEmail)</span></span>
                            <button class="btn btn-ghost btn-sm" @onclick="() => RevokeShare(s)">Widerrufen</button>
                        </li>
                    }
                </ul>
            }
            <h3>Mit mir geteilt</h3>
            @if (_incoming.Count == 0)
            {
                <p class="muted">Niemand hat bisher ein Modul für dich freigegeben.</p>
            }
            else
            {
                <ul class="plain-list share-results">
                    @foreach (var m in _incoming)
                    {
                        <li><span><a href="/module/@m.Id"><strong>@m.Name</strong></a> <span class="muted">von @m.OwnerName · nur lernen</span></span></li>
                    }
                </ul>
            }
        </div>

        <div class="card panel" id="certificates">
            <h2 class="panel-title">Meine Zertifikate</h2>
            <p class="muted">Für jedes bestandene Modulquiz erhältst du ein Zertifikat mit Note (1–6; bestanden ab der Bestehensgrenze des Moduls). Wähle, welche Ergebnisse du sehen möchtest.</p>
            <label class="form-label">Anzeigen
                <select class="input cert-filter" value="@_minGrade" @onchange="e => _minGrade = int.TryParse(e.Value?.ToString(), out var g) ? g : 0" aria-label="Zertifikate filtern">
                    <option value="0">Alle bestandenen Module</option>
                    <option value="4">Bestanden mit mindestens Note 4 (ausreichend)</option>
                    <option value="3">Mindestens Note 3 (befriedigend)</option>
                    <option value="2">Mindestens Note 2 (gut)</option>
                    <option value="1">Nur Note 1 (sehr gut)</option>
                </select>
            </label>
            @{ var shown = _certificates.Where(c => _minGrade == 0 || c.Grade <= _minGrade).ToList(); }
            @if (shown.Count == 0)
            {
                <p class="muted">@(_certificates.Count == 0 ? "Noch kein Modul bestanden." : "Kein Zertifikat entspricht dem Filter.")</p>
            }
            else
            {
                <table class="table">
                    <thead><tr><th>Modul</th><th>Datum</th><th>Ergebnis</th><th>Note</th><th>Nummer</th><th>Status</th><th>Download</th></tr></thead>
                    <tbody>
                        @foreach (var c in shown)
                        {
                            <tr>
                                <td>@c.ModuleName@(c.ModuleVersion > 0 ? $" (Version {c.ModuleVersion})" : "")</td>
                                <td>@c.IssuedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td>@c.ScorePercent.ToString("0.#") %</td>
                                <td><span class="badge badge-pass">@c.Grade — @GermanGrade.Label(c.Grade)</span></td>
                                <td>@c.Number</td>
                                <td>@ChainStatus.Label(c.ChainStatus, c.IsRevoked)</td>
                                <td class="actions">
                                    <a class="btn btn-ghost btn-sm" href="/api/certificates/@c.Id/certificate.html" download>🎓 Zertifikat</a>
                                    <a class="btn btn-ghost btn-sm" href="/api/certificates/@c.Id/certificate.pdf" download title="Signiertes PDF mit eingebetteten Credentials">PDF (signiert)</a>
                                    @if (c.IsTopic) { <a class="btn btn-ghost btn-sm" href="/api/certificates/@c.Id/clr" download title="Comprehensive Learner Record (CLR 2.0)">CLR (JSON-LD)</a> }
                                    <a class="btn btn-ghost btn-sm" href="/api/certificates/@c.Id/badge" download>Badge (JSON)</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="card panel">
            <h2 class="panel-title">Meine Lernergebnisse</h2>
            @if (_results.Count == 0)
            {
                <p class="muted">Noch keine Quiz-Ergebnisse.</p>
            }
            else
            {
                <table class="table">
                    <thead><tr><th>Datum</th><th>Modul</th><th>Kategorie</th><th>Punkte</th><th>Note</th></tr></thead>
                    <tbody>
                        @foreach (var r in _results)
                        {
                            <tr>
                                <td>@r.CompletedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@(_moduleNames.TryGetValue(r.ModuleId, out var n) ? n : "—")</td>
                                <td>@(string.IsNullOrEmpty(r.Category) ? "Alle" : r.Category)</td>
                                <td>@r.Score.ToString("0.#") / @r.MaxScore.ToString("0.#")</td>
                                <td>@r.Grade</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (_mcpAllowed)
        {
        <div class="card panel">
            <h2 class="panel-title">MCP-Verknüpfungen</h2>
            <p class="muted">
                MCP-Clients arbeiten ausschließlich in deinem Namen und sehen nur deine eigenen Module und Karten.
                Clients mit OAuth-Unterstützung verbinden sich über die Anmeldung bei Learny; für stdio-Clients (z. B. Claude Desktop) erzeugst du ein persönliches Token.
                Tokens werden nie im Klartext gespeichert: In der Datenbank liegt nur eine geschützte Prüfsumme, die ohne den Server-Schlüssel wertlos ist. Die „Kennung“ hilft nur beim Wiedererkennen und enthält keinen Teil des Tokens.
            </p>

            @if (_newToken is not null)
            {
                <div class="alert alert-ok" role="status">
                    <strong>Neues Token — wird nur jetzt angezeigt, bitte sofort kopieren:</strong><br />
                    <code>@_newToken</code>
                    <p>Für stdio setzt du die Umgebungsvariable <code>LEARNCARDS_MCP_TOKEN</code> auf diesen Wert. Für HTTP sendest du <code>Authorization: Bearer @_newToken</code>.</p>
                </div>
            }

            @if (_links.Count == 0)
            {
                <p>Noch keine MCP-Zugänge.</p>
            }
            else
            {
                <table class="table">
                    <thead><tr><th>Name</th><th>Art</th><th>Kennung</th><th>Erstellt</th><th>Gültig bis</th><th>Zuletzt genutzt</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var l in _links)
                        {
                            <tr>
                                <td>@l.Name</td>
                                <td>@(l.Kind == "oauth" ? "OAuth-Anmeldung" : "Persönliches Token")</td>
                                <td><code>@l.TokenHint</code></td>
                                <td>@l.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td>@l.ExpiresAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td>@(l.LastUsedAt is null ? "—" : l.LastUsedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</td>
                                <td>@(l.RevokedAt is not null ? "widerrufen" : l.IsActive ? "aktiv" : "abgelaufen")</td>
                                <td class="actions">
                                    @if (l.IsActive)
                                    {
                                        <button class="btn btn-ghost btn-sm" @onclick="() => RevokeLink(l.Id)">Widerrufen</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h3>Persönliches Token erzeugen</h3>
            <div class="form-row">
                <input class="input" maxlength="80" placeholder="Name, z. B. Claude Desktop" @bind="_tokenName" />
                <select class="input" @bind="_tokenDays">
                    <option value="30">30 Tage</option>
                    <option value="90">90 Tage</option>
                    <option value="365">365 Tage</option>
                </select>
                <button class="btn btn-primary" @onclick="CreateToken">Token erzeugen</button>
            </div>
        </div>
        }
        else
        {
            <div class="card panel"><h2 class="panel-title">MCP-Verknüpfungen</h2><p class="muted">Für externe Lernprofile stehen keine MCP-Zugänge zur Verfügung.</p></div>
        }
    }
</div>

@code {
    private AppUser? _user;
    private string _displayName = "";
    private List<UserIdentityInfo> _identities = new();
    private OwnedContentSummary _summary = new();
    private List<QuizResultRecord> _results = new();
    private Dictionary<string, string> _moduleNames = new(StringComparer.OrdinalIgnoreCase);
    private List<ShareInfo> _outgoing = new();
    private List<ModuleInfo> _incoming = new();
    private List<McpLink> _links = new();
    private bool _mcpAllowed;
    private string _avState = "happy";

        private static readonly string[] AvatarExamples =
    {
        "freundliche Person mit roten Locken, Brille und grünem Pullover",
        "ruhiger Mensch mit schwarzem Dutt, Kopfhörern und lila Hoodie",
        "sportliche Person mit kurzen blonden Haaren, Kappe und blauem Shirt",
        "Person mit dunkler Haut, langen schwarzen Haaren und gelber Jacke",
    };
    private string _genText = "";
    private string? _genId, _genSummary;
    private bool _genBusy;

    private async Task GenerateAvatarAsync()
    {
        _genBusy = true;
        try { var r = await AvatarGen.GenerateAsync(_genText); _genId = r.Id; _genSummary = r.Summary; }
        catch (ArgumentException ex) { _message = "❌ " + ex.Message; _messageOk = false; }
        finally { _genBusy = false; }
    }

    private async Task AcceptGeneratedAsync()
    {
        if (_genId is null) return;
        try { await Repo.SaveAvatarAsync(_user!.Id, _genId, false); UiState.SetAvatar(_genId, false); _message = "✅ Avatar gespeichert."; _messageOk = true; _genId = null; }
        catch (ArgumentException ex) { _message = "❌ " + ex.Message; _messageOk = false; }
    }

    private async Task PickAvatarAsync(string id)
    {
        try { await Repo.SaveAvatarAsync(_user!.Id, id, false); UiState.SetAvatar(id, false); _message = "✅ Avatar gespeichert."; _messageOk = true; }
        catch (ArgumentException e) { _message = "❌ " + e.Message; _messageOk = false; }
    }

    private async Task HideAvatarAsync(bool hidden)
    {
        await Repo.SaveAvatarAsync(_user!.Id, UiState.AvatarPreset, hidden);
        UiState.SetAvatar(UiState.AvatarPreset, hidden);
        _message = hidden ? "✅ Avatar ausgeblendet." : "✅ Avatar wieder eingeblendet."; _messageOk = true;
    }

    private async Task ResetAvatarAsync()
    {
        await Repo.SaveAvatarAsync(_user!.Id, "", false);
        UiState.SetAvatar("", false);
        _message = "✅ Avatar zurückgesetzt (Initialen)."; _messageOk = true;
    }
    private string _tokenName = "";
    private int _tokenDays = 90;
    private string? _newToken;
    private string? _message;
    private bool _messageOk;

    private List<Certificate> _certificates = new();
    private int _minGrade;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var uid = auth.User.GetUserId() ?? throw new UnauthorizedAccessException();
        _user = await Users.GetAsync(uid) ?? throw new UnauthorizedAccessException();
        _displayName = _user.DisplayName;
        _identities = await Users.GetIdentitiesAsync(uid);
        _summary = await Repo.GetOwnedSummaryAsync(uid);
        _results = await Repo.QuizHistoryAsync(uid, limit: 10);
        _certificates = await Certs.ListForUserAsync(uid);
        _mcpAllowed = await McpLinks.IsAllowedAsync(uid);
        _links = await McpLinks.ListAsync(uid);
        _outgoing = await Sharing.ListOutgoingSharesAsync(uid);
        _incoming = await Repo.ListSharedWithMeAsync(uid);
        _moduleNames = (await Repo.ListModulesAsync(uid)).ToDictionary(m => m.Id, m => m.Name, StringComparer.OrdinalIgnoreCase);
    }

    private async Task RevokeShare(ShareInfo s)
    {
        if (_user is null) return;
        var ok = await Sharing.RevokeShareAsync(_user.Id, s.ModuleId, s.RecipientUserId);
        _message = ok ? $"✅ Freigabe für {s.RecipientName} widerrufen." : "❌ Freigabe nicht gefunden.";
        _messageOk = ok;
        _outgoing = await Sharing.ListOutgoingSharesAsync(_user.Id);
    }

    private async Task CreateToken()
    {
        if (_user is null) return;
        var (token, _) = await McpLinks.CreateLinkAsync(_user.Id, _tokenName, "token", TimeSpan.FromDays(_tokenDays));
        _newToken = token;
        _tokenName = "";
        _links = await McpLinks.ListAsync(_user.Id);
    }

    private async Task RevokeLink(string id)
    {
        if (_user is null) return;
        var ok = await McpLinks.RevokeAsync(_user.Id, id);
        _message = ok ? "✅ MCP-Zugang widerrufen." : "❌ MCP-Zugang nicht gefunden.";
        _messageOk = ok;
        _links = await McpLinks.ListAsync(_user.Id);
    }

    private async Task SaveName()
    {
        if (_user is null) return;
        try
        {
            await Users.SetDisplayNameAsync(_user.Id, _displayName);
            _user.DisplayName = _displayName.Trim();
            _message = "✅ Anzeigename gespeichert.";
            _messageOk = true;
        }
        catch (ArgumentException e)
        {
            _message = "❌ " + e.Message;
            _messageOk = false;
        }
    }

    private static string RoleLabel(string role) => role switch
    {
        Roles.Admin => "Administrator",
        Roles.Auditor => "Global Learny Auditor",
        Roles.TopicAdmin => "Themen-Admin",
        _ => "Benutzer",
    };

    private static string Shorten(string s) => s.Length <= 14 ? s : s[..6] + "…" + s[^6..];
}
