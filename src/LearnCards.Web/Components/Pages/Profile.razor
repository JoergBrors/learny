    private bool CanGenerateImage =>
        (_imgSource == "text" ? !string.IsNullOrWhiteSpace(_imgText)
        : _imgSource == "photo" ? _imgPhoto is not null && _imgConsent
        : _imgPhoto is not null && _imgConsent && !string.IsNullOrWhiteSpace(_imgText));

    private void ClearImgPhoto() { _imgPhoto = null; _imgPhotoMime = null; _imgConsent = false; }

    private async Task OnImgPhotoSelected(InputFileChangeEventArgs e)
    {
        _imgError = null; ClearImgPhoto();
