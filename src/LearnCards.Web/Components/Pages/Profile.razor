        try { await JS.InvokeVoidAsync("learnyScrollTo", "avatar-variants"); } catch (JSException) { /* rein optisch */ } catch (InvalidOperationException) { /* Schaltkreis getrennt */ }
    }
    private void DiscardSelected()
    {
        var idx = _gallery.FindIndex(v => v.Id == _selId);
        if (idx < 0) idx = _gallery.Count - 1;
        if (idx >= 0) _gallery.RemoveAt(idx);
        _selId = _gallery.Count > 0 ? _gallery[Math.Min(idx, _gallery.Count - 1)].Id : Guid.Empty;
        if (_gallery.Count == 0) { ClearPhoto(); ClearImgPhoto(); }
    }
    private void DiscardAll() { _gallery.Clear(); _selId = Guid.Empty; ClearPhoto(); ClearImgPhoto(); }
    private LearnCards.Web.Components.Shared.AvatarGalleryPanel? _galleryPanel;
    private string _batchGroup = Guid.NewGuid().ToString("N");   // Vorschläge eines Generatorlaufs werden in der Galerie als Varianten einer Gruppe geführt

    private NewGalleryEntry ToEntry(Variant v) => v.IsImage
        ? new NewGalleryEntry("image", v.Label + " " + DateTime.Now.ToString("dd.MM. HH:mm"), "", v.Style ?? "", v.Bytes, null)
        : new NewGalleryEntry("svg", "Baukasten " + DateTime.Now.ToString("dd.MM. HH:mm"), "", "svg", null, v.SvgId);

    /// <summary>Speichert Vorschläge in der persönlichen Galerie (nie ersetzend); bereits vorhandene Bilder/Figuren werden wiederverwendet. Liefert die Galerie-Kennung je Vorschlag.</summary>
    private async Task<Dictionary<Guid, string>> StoreAsync(IReadOnlyList<Variant> variants)
    {
        var existing = await Galleries.ListAsync(_user!.Id);
        var map = new Dictionary<Guid, string>(); var fresh = new List<(Variant V, NewGalleryEntry E)>();
        foreach (var v in variants)
        {
            var hit = v.IsImage ? existing.FirstOrDefault(e => e.IsImage && e.Sha256 == Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(v.Bytes!)).ToLowerInvariant())
                                : existing.FirstOrDefault(e => !e.IsImage && e.SvgId == v.SvgId);
            if (hit is not null) map[v.Id] = hit.Id; else fresh.Add((v, ToEntry(v) with { GroupKey = _batchGroup }));
        }
        if (fresh.Count > 0)
        {
            var added = await Galleries.AddAsync(_user.Id, fresh.Select(f => f.E).ToList());
            for (var i = 0; i < added.Count; i++) map[fresh[i].V.Id] = added[i].Id;
        }
        return map;
    }

    private async Task SaveSelectedToGalleryAsync()
    {
        var v = _gallery.FirstOrDefault(x => x.Id == _selId) ?? _gallery.LastOrDefault();
        if (v is null) return;
        try { await StoreAsync(new[] { v }); _gallery.Remove(v); AfterGalleryChange("✅ In der Galerie gespeichert (Profilavatar unverändert)."); }
        catch (ArgumentException ex) { _message = "❌ " + ex.Message; _messageOk = false; }
        if (_galleryPanel is not null) await _galleryPanel.ReloadAsync();
    }

    /// <summary>Speichert den Vorschlag als neutrales Hauptbild einer Figur und öffnet in der Galerie die kostenpflichtige Erzeugung der weiteren Stimmungen — gestartet wird erst nach ausdrücklicher Bestätigung dort.</summary>
    private async Task SaveAndPlanMoodsAsync()
    {
        var v = _gallery.FirstOrDefault(x => x.Id == _selId) ?? _gallery.LastOrDefault();
        if (v is null || !v.IsImage) return;
        try
        {
            var map = await StoreAsync(new[] { v });
            _gallery.Remove(v); AfterGalleryChange("✅ In der Galerie gespeichert. Bestätige dort die Erzeugung der Stimmungen.");
            if (_galleryPanel is not null) { await _galleryPanel.ReloadAsync(); await _galleryPanel.RequestMoodsAsync(map[v.Id]); }
            try { await JS.InvokeVoidAsync("learnyScrollTo", "avatar-gallery"); } catch (JSException) { } catch (InvalidOperationException) { }
        }
        catch (ArgumentException ex) { _message = "❌ " + ex.Message; _messageOk = false; }
    }

    private async Task SaveAllPendingAsync()
    {
        if (_gallery.Count == 0) return;
        try { var all = _gallery.ToList(); await StoreAsync(all); _gallery.Clear(); AfterGalleryChange($"✅ {all.Count} Vorschläge in der Galerie gespeichert (Profilavatar unverändert)."); }
        catch (ArgumentException ex) { _message = "❌ " + ex.Message; _messageOk = false; }
        if (_galleryPanel is not null) await _galleryPanel.ReloadAsync();
    }

    private void AfterGalleryChange(string message)
    {
        _message = message; _messageOk = true;
        _selId = _gallery.Count > 0 ? _gallery[^1].Id : Guid.Empty;
        if (_gallery.Count == 0) { ClearPhoto(); ClearImgPhoto(); _batchGroup = Guid.NewGuid().ToString("N"); }
    }

    /// <summary>„Übernehmen“: speichert den ausgewählten Vorschlag in der Galerie und verwendet ihn als Profilavatar. Andere Vorschläge und Galerieeinträge bleiben unberührt.</summary>
    private async Task AcceptSelectedAsync()
    {
        var v = _gallery.FirstOrDefault(x => x.Id == _selId) ?? _gallery.LastOrDefault();
        if (v is null) return;
        try
        {
            var map = await StoreAsync(new[] { v });
            var preset = await Galleries.ActivateAsync(_user!.Id, map[v.Id]);
            UiState.SetAvatar(preset, false);
            UiState.SetMoods(await Galleries.ActiveMoodsAsync(_user.Id));
            _gallery.Remove(v);
            AfterGalleryChange(v.IsImage ? "✅ KI-Avatar gespeichert und als Profilavatar übernommen." : "✅ Avatar gespeichert und als Profilavatar übernommen.");
        }
        catch (ArgumentException ex) { _imgError = ex.Message; _message = "❌ " + ex.Message; _messageOk = false; }
        if (_galleryPanel is not null) await _galleryPanel.ReloadAsync();
    }
    private bool _genBusy;

    private string? _genNote, _photoError;
    private byte[]? _photo;          // nur im Arbeitsspeicher dieser Sitzung; wird nie gespeichert (ADR 0055)
    private string? _photoMime;
    private bool _photoConsent;
    private string PhotoPreview => _photo is null ? "" : $"data:{_photoMime};base64,{Convert.ToBase64String(_photo)}";

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        _photoError = null; ClearPhoto();
