    private string? MoodMissingHint => (Avatars.IsGalleryId(UiState.AvatarPreset) || Avatars.IsImageId(UiState.AvatarPreset)) && !UiState.AvatarHidden && _avState != "neutral" && !UiState.AvatarMoods.Contains(_avState)
