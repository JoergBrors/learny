        if (file.Size > AvatarPhoto.MaxBytes) { _photoError = $"Das Foto ist zu groß (höchstens {AvatarPhoto.MaxBytes / (1024 * 1024)} MB)."; return; }
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(AvatarPhoto.MaxBytes).CopyToAsync(ms);
            var bytes = ms.ToArray();
