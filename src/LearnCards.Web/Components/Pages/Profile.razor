        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(AvatarPhoto.MaxBytes).CopyToAsync(ms);
            var bytes = ms.ToArray();
            var mime = AvatarPhoto.DetectMime(bytes);   // Inhalt zählt, nicht Dateiname oder gemeldeter Typ
            if (mime is null) { _imgError = $"Das ist keine gültige Bilddatei. Erlaubt sind {AvatarPhoto.AllowedFormatsText}."; return; }
            _imgPhoto = bytes; _imgPhotoMime = mime;
        }
        catch (IOException) { _imgError = $"Das Foto konnte nicht gelesen werden (höchstens {AvatarPhoto.MaxBytes / (1024 * 1024)} MB)."; }
    }

    private async Task GenerateImageAsync()
    {
        if (_imgBusy || !CanGenerateImage) return;   // Mehrfachklicks erzeugen keine zweite Anfrage
        if (_gallery.Count >= MaxVariants) { _imgError = $"Du hast schon {MaxVariants} Vorschläge. Übernimm einen oder verwirf einen, um eine neue Variante zu erstellen."; return; }
        _imgBusy = true; _imgError = null;
        try
        {
            var usePhoto = _imgSource != "text" && _imgConsent ? _imgPhoto : null;
            var useText = _imgSource != "photo" ? _imgText : null;
            var r = await ImgGen.GenerateAsync(_user!.Id, _imgStyle, useText, usePhoto);
            var label = AvatarImageStyles.All.First(x => x.Id == r.Style).Label;
            await AddVariantAsync(new Variant(Guid.NewGuid(), true, label, null, null, Bytes: r.Bytes, Model: r.Model, Style: r.Style, Src: $"data:{r.Mime};base64,{Convert.ToBase64String(r.Bytes)}"));
        }
        catch (AvatarImageException ex) { _imgError = ex.Message; }   // der bisherige Avatar bleibt unverändert
        finally { _imgBusy = false; }
    }

    private async Task GenerateAvatarAsync()
