        var (savedAvatar, savedHidden) = await Repo.GetAvatarAsync(uid);   // der Layout-Zustand lebt im statischen Render-Bereich; die interaktive Seite lädt den gespeicherten Avatar selbst
        UiState.SetAvatar(savedAvatar, savedHidden);
