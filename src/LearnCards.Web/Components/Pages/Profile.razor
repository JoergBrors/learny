    // Vorschläge (flüchtig, nur Arbeitsspeicher dieser Sitzung): KI-Bilder und SVG-Baukasten in einer Galerie; Auswahl getrennt vom gespeicherten Avatar (UiState)
    private sealed record Variant(Guid Id, bool IsImage, string Label, string? Summary, string? Note, string? SvgId = null, byte[]? Bytes = null, string? Model = null, string? Style = null, string? Src = null);
