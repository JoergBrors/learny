            else await AddVariantAsync(new Variant(Guid.NewGuid(), false, "Baukasten (SVG)", r.Summary, r.Note, SvgId: r.Id));
        }
        catch (ArgumentException ex) { _message = "❌ " + ex.Message; _messageOk = false; }
        finally { _genBusy = false; }
    }

