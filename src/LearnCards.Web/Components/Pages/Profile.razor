            if (mime is null) { _photoError = $"Das ist keine gültige Bilddatei. Erlaubt sind {AvatarPhoto.AllowedFormatsText}."; return; }
            _photo = bytes; _photoMime = mime;
        }
        catch (IOException) { _photoError = $"Das Foto konnte nicht gelesen werden (höchstens {AvatarPhoto.MaxBytes / (1024 * 1024)} MB)."; }
    }

    private void ClearPhoto() { _photo = null; _photoMime = null; _photoConsent = false; }


    // ─── KI-Bildavatar (ADR 0056): echte Bilddatei; Vorschläge und Referenzfoto nur im Arbeitsspeicher, gespeichert wird erst „Übernehmen“ ───
    private string _imgStyle = AvatarImageStyles.Realistic, _imgSource = "photo", _imgText = "";
