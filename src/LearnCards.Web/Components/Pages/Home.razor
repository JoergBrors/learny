@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CardRepository Repo
@inject CertificateService Certs
@inject ModuleTransferService Transfer
@inject TopicService TopicSvc
@inject ModuleVersionService ModuleVersions
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject FavoritesService Favs

<PageTitle>Module — LearnCards</PageTitle>

<div class="container">
    <div class="page-head">
        <div>
            <h1>Module</h1>
            <p class="muted">Willkommen, @_userName · Module enthalten Lernkarten und Quizfragen; mehrere Module bündelst du unter <a href="/topics">Themen</a> zu einem Lernpfad.</p>
        </div>
        <div class="page-head-actions">
            <a class="btn btn-ghost" href="/help">❓ Hilfe & Templates</a>
            @if (!_restricted)
            {
            <label class="btn btn-primary file-btn">
                📥 JSON importieren
                <InputFile OnChange="HandleImport" accept=".json" disabled="@_importing" title="Karten-JSON (Kartenliste) oder vollständiges Modul-JSON (learny-module)" />
            </label>
            <button class="btn btn-ghost" @onclick="() => _showCreate = !_showCreate">＋ Neues Modul</button>
            }
        </div>
    </div>

    @if (_showCreate)
    {
        <div class="card panel create-module">
            <h2 class="panel-title">Neues Modul anlegen</h2>
            <div class="form-row">
                <input class="input" placeholder="Name, z. B. Azure Networking L400" @bind="_newName" />
                <input class="input" placeholder="Beschreibung (optional)" @bind="_newDescription" />
                <input class="input input-icon" placeholder="📚" maxlength="4" @bind="_newIcon" title="Icon (Emoji)" />
                <input class="input input-color" type="color" @bind="_newColor" title="Modulfarbe" />
                <button class="btn btn-primary" @onclick="CreateModule" disabled="@string.IsNullOrWhiteSpace(_newName)">Anlegen</button>
            </div>
        </div>
    }

    @if (_message is not null)
    {
        <div class="alert @(_messageOk ? "alert-ok" : "alert-error")" role="status">@_message</div>
    }

    @if (_importing)
    {
        <div class="card panel">
            <h2 class="panel-title">Import läuft</h2>
            <div class="progress-head" role="progressbar" aria-valuenow="@_importProgressPercent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-labels">
                    <span>@_importProgressLabel</span>
                    <span>@_importProgressPercent%</span>
                </div>
                <div class="progress-track"><div class="progress-fill" style="width:@($"{_importProgressPercent}%")"></div></div>
            </div>
        </div>
    }

    @if (_pendingModule is not null)
    {
        <div class="card panel create-module">
            <h2 class="panel-title">Modul-Import: @_importFileName</h2>
            <p class="muted">
                Modul „@_pendingModule.Name“ · @_pendingModule.Cards.Count Karten · @_pendingModule.Cards.Sum(c => c.Images?.Count ?? 0) Bilder ·
                @_pendingModule.Cards.Sum(c => c.Quiz.Count) Kartenquizfragen · @_pendingModule.PoolQuestions.Count zusätzliche Pool-Fragen.
                Es entsteht ein <strong>neues eigenes Modul</strong>; vorhandene Module werden nie überschrieben.
            </p>
            <div class="alert alert-ok" role="status">✅ Struktur und Inhalte sind gültig. Der Import wurde noch nicht ausgeführt.</div>
            <div class="page-head-actions">
                <button class="btn btn-primary" @onclick="ConfirmModuleImport" disabled="@_importing">Import bestätigen</button>
                <button class="btn btn-ghost" @onclick="CancelModuleImport" disabled="@_importing">Verwerfen</button>
            </div>
        </div>
    }

    @if (_showImportPreview && _importAnalysis is not null)
    {
        <div class="card panel create-module">
            <h2 class="panel-title">Import-Analyse: @_importFileName</h2>
            <p class="muted">
                @_importAnalysis.TotalCards Karten, @_importAnalysis.ModuleCount Module,
                @_importAnalysis.CategoryCount Kategorien, @_importAnalysis.ArchivedCount archiviert.
            </p>
            @if (_importAnalysis.ModuleNames.Count > 0)
            {
                <p class="muted">Module: @string.Join(", ", _importAnalysis.ModuleNames)</p>
            }
            @if (_importAnalysis.Errors.Count > 0)
            {
                <div class="alert alert-error" role="status">
                    ❌ Analyse fehlgeschlagen:
                    @string.Join(" | ", _importAnalysis.Errors)
                </div>
            }
            else
            {
                <div class="alert alert-ok" role="status">
                    ✅ JSON-Struktur ist gültig. Der Import wurde noch nicht ausgeführt.
                </div>
            }
            <div class="page-head-actions">
                <button class="btn btn-primary" @onclick="ConfirmImport" disabled="@(_importing || _importAnalysis.Errors.Count > 0)">Import bestätigen</button>
                <button class="btn btn-ghost" @onclick="CancelImport" disabled="@_importing">Verwerfen</button>
            </div>
        </div>
    }

    @if (_mandatory.Count > 0)
    {
        <section class="card panel mandatory-box" aria-labelledby="mandatory-title">
            <h2 class="panel-title" id="mandatory-title">Meine verpflichtenden Themen</h2>
            <p class="muted">Diese Themen wurden dir ausdrücklich zugewiesen. Alle anderen Funktionen bleiben nutzbar.</p>
            <ul class="mandatory-list">
                @foreach (var t in _mandatory)
                {
                    var st = t.Progress?.Status ?? "not_started";
                    <li class="mandatory-item @(t.Overdue ? "mandatory-overdue" : st == "in_progress" ? "mandatory-active" : "")">
                        <div>
                            <strong>@t.Topic.Name</strong> <span class="badge">Version @t.Version</span>
                            <span class="badge @(st == "in_progress" ? "badge-warn" : "")">@(st == "in_progress" ? "In Bearbeitung" : "Nicht begonnen")</span>
                            @if (t.DueAt is DateTime due) { <span class="badge @(t.Overdue ? "badge-warn" : "")">fällig @due.ToLocalTime().ToString("dd.MM.yyyy")@(t.Overdue ? " · überfällig" : "")</span> }
                            <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(t.Progress?.ProgressPercent ?? 0)" aria-label="Lernfortschritt"><div class="progress-fill" style="width:@(t.Progress?.ProgressPercent ?? 0)%"></div></div>
                            <span class="muted">@(t.Progress?.ProgressPercent ?? 0) % · @(t.Progress?.ModulesCompleted ?? 0) von @(t.Progress?.ModulesTotal ?? 0) Modulen abgeschlossen</span>
                        </div>
                        <a class="btn btn-primary btn-sm" href="/topics/@t.Topic.Id?version=@t.Version">@(st == "in_progress" ? "Fortsetzen" : "Beginnen")</a>
                    </li>
                }
            </ul>
        </section>
    }

    <div class="tab-row" role="tablist" aria-label="Modulbereich wählen">
        <button class="chip @(_tab == "private" ? "chip-active" : "")" role="tab" aria-selected="@(_tab == "private")" @onclick='() => _tab = "private"'>Meine Module (@_modules.Count)</button>
        <button class="chip @(_tab == "shared" ? "chip-active" : "")" role="tab" aria-selected="@(_tab == "shared")" @onclick='() => _tab = "shared"'>Mit mir geteilt (@_shared.Count)</button>
        <button class="chip @(_tab == "global" ? "chip-active" : "")" role="tab" aria-selected="@(_tab == "global")" @onclick='() => _tab = "global"'>Globale Module (@_global.Count)</button>
    </div>

    @if (_loading)
    {
        <div class="spinner-wrap" aria-busy="true"><div class="spinner" role="status"></div></div>
    }
    else if (Current.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon" aria-hidden="true">📚</div>
            @if (_tab == "private")
            {
                <p class="empty-title">Noch keine eigenen Module vorhanden.</p>
                <p class="muted">Importiere Karten via JSON oder MCP, um loszulegen. Deine Module sind privat, bis du sie freigibst.</p>
            }
            else if (_tab == "shared")
            {
                <p class="empty-title">Noch nichts mit dir geteilt.</p>
                <p class="muted">Sobald ein anderer Benutzer ein Modul für dich freigibt, erscheint es hier — zum Lernen, ohne es ändern zu können.</p>
            }
            else
            {
                <p class="empty-title">Noch keine globalen Module veröffentlicht.</p>
                <p class="muted">Globale Module werden von Administratoren aus eingereichten Modulen veröffentlicht. Reiche eines deiner Module im Dialog „Modul freigeben“ ein.</p>
            }
        </div>
    }
    else
    {
        var shown = Shown();
        var groups = ListGrouping.By(shown, GroupKey());
        <ListToolbar Placeholder="Module suchen" @bind-Query="_q" @bind-Sort="_sort" SortOptions="SortOpts" @bind-Group="_group" GroupOptions="GroupOpts" @bind-FavoritesOnly="_favOnly" FavoriteCount="@Current.Count(m => _favs.Contains(m.Id))"
                     @bind-View="_view" StorageKey="view.modules" Total="@Current.Count" Shown="@shown.Count">
            <Filters>
                <select class="input compact" @bind="_flt" aria-label="Filter">
                    <option value="">Alle Stände</option>
                    <option value="passed">Bestanden</option>
                    <option value="open">Noch nicht bestanden</option>
                    @if (_tab == "private") { <option value="unused">Ohne Thema</option> }
                </select>
            </Filters>
        </ListToolbar>
        @if (shown.Count == 0)
        {
            <div class="empty-state"><p class="empty-title">Keine Treffer.</p><p class="muted">Suche oder Filter anpassen@(_favOnly ? " bzw. „Favoriten“ ausschalten" : "").</p></div>
        }
        else if (_view == "list")
        {
            <div class="card table-wrap list-view">
                <table class="table">
                    <caption class="sr-only">Module</caption>
                    <thead><tr><th class="sr-only">Favorit</th><th>Modul</th><th>Bereich</th><th>Karten</th><th>Stand</th><th><span class="sr-only">Aktionen</span></th></tr></thead>
                    <tbody>
                        @foreach (var g in groups)
                        {
                        @if (g.Title.Length > 0) { <tr class="group-row"><th colspan="6" scope="colgroup">@g.Title (@g.Items.Count)</th></tr> }
                        @foreach (var mod in g.Items)
                        {
                            <tr class="clickable" tabindex="0" @onclick="() => Open(mod.Id)" @onkeydown='e => { if (e.Key == "Enter") Open(mod.Id); }'>
                                <td><FavoriteButton Active="_favs.Contains(mod.Id)" Label="@mod.Name" OnToggle="() => ToggleFav(mod.Id)" /></td>
                                <td><div class="name-cell"><span class="icon" aria-hidden="true">@mod.Icon</span><div><strong>@mod.Name</strong>@if (!string.IsNullOrEmpty(mod.Description)) { <small>@mod.Description</small> }</div></div></td>
                                <td><span class="badge @(_tab == "private" ? "badge-private" : "badge-" + mod.Context)">@(_tab == "private" ? "Eigenes" : mod.Context == "shared" ? "Freigegeben" : "Global")</span>@if (_tab == "shared") { <small class="muted">von @mod.OwnerName</small> }</td>
                                <td>@mod.ActiveCount aktiv@(mod.CardCount - mod.ActiveCount > 0 ? $" · {mod.CardCount - mod.ActiveCount} archiviert" : "")</td>
                                <td>
                                    @if (_certs.TryGetValue(mod.Id, out var cert)) { <span class="badge badge-pass">✔ Note @cert.Grade</span> }
                                    @if (_tab == "private" && _latestVersions.TryGetValue(mod.Id, out var lv)) { <span class="pill">V@(lv)</span> } else if (_tab == "private") { <span class="pill">Entwurf</span> } else if (_tab == "global") { <span class="pill">V@(mod.GlobalVersion)</span> }
                                </td>
                                <td class="actions">
                                    @if (_tab == "global") { <button class="btn btn-ghost btn-sm" @onclick:stopPropagation="true" @onclick="() => CloneAsync(mod)" disabled="@_cloning" title="Erzeugt eine eigene private Kopie">⧉ Klonen</button> }
                                    @if (_tab != "shared") { <a class="btn btn-ghost btn-sm" href="/api/modules/@mod.Id/export" download="@(FileName(mod.Name)).json" @onclick:stopPropagation="true" aria-label="@($"{mod.Name} als JSON exportieren")">⬇ JSON</a> }
                                    @if (_tab == "shared")
                                    {
                                        @if (_pendingDeleteModuleId == mod.Id)
                                        {
                                            <button class="btn btn-danger btn-sm" @onclick:stopPropagation="true" @onclick="() => ConfirmDeleteModule(mod.Id)">Löschen</button>
                                            <button class="btn btn-ghost btn-sm" @onclick:stopPropagation="true" @onclick="CancelDeleteModule">Abbrechen</button>
                                        }
                                        else { <button class="icon-btn" title="Modul löschen" aria-label="@($"{mod.Name} löschen")" @onclick:stopPropagation="true" @onclick="() => AskDeleteModule(mod.Id)">🗑</button> }
                                    }
                                </td>
                            </tr>
                        }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
        @foreach (var g in groups)
        {
        @if (g.Title.Length > 0) { <h3 class="group-head">@g.Title <span class="count">(@g.Items.Count)</span></h3> }
        <div class="module-grid">
            @foreach (var mod in g.Items)
            {
                <article class="module-card" tabindex="0" role="link"
                         aria-label="@($"Modul {mod.Name}: {mod.ActiveCount} aktive Karten")"
                         @onclick="() => Open(mod.Id)"
                         @onkeydown='e => { if (e.Key == "Enter") Open(mod.Id); }'>
                    <div class="module-stripe" style="background:@mod.Color" aria-hidden="true"></div>
                    <FavoriteButton Active="_favs.Contains(mod.Id)" Label="@mod.Name" OnToggle="() => ToggleFav(mod.Id)" />
                    <div class="module-body">
                        <div class="module-actions">
                            @if (_tab != "private")
                            {
                                <span class="badge badge-@mod.Context">@(mod.Context == "shared" ? "Freigegeben" : "Global")</span>
                            }
                            @if (_tab == "global")
                            {
                                <button class="btn btn-ghost btn-sm" @onclick:stopPropagation="true" @onclick="() => CloneAsync(mod)" disabled="@_cloning"
                                        title="Erzeugt eine eigene private Kopie, die du bearbeiten und in Themen verwenden kannst">⧉ In eigene Module klonen</button>
                            }
                            @if (_tab != "shared")
                            {
                                <a class="btn btn-ghost btn-sm" href="/api/modules/@mod.Id/export" download="@(FileName(mod.Name)).json" @onclick:stopPropagation="true"
                                   aria-label="@($"{mod.Name} als JSON exportieren")">⬇ Als JSON exportieren</a>
                            }
                            else if (_pendingDeleteModuleId == mod.Id)
                            {
                                <button class="btn btn-danger btn-sm" @onclick:stopPropagation="true" @onclick="() => ConfirmDeleteModule(mod.Id)">Löschen</button>
                                <button class="btn btn-ghost btn-sm" @onclick:stopPropagation="true" @onclick="CancelDeleteModule">Abbrechen</button>
                            }
                            else
                            {
                                <button class="icon-btn" title="Modul löschen" aria-label="@($"{mod.Name} löschen")"
                                        @onclick:stopPropagation="true" @onclick="() => AskDeleteModule(mod.Id)">
                                    🗑
                                </button>
                            }
                        </div>
                        <div class="module-top">
                            <span class="module-icon" aria-hidden="true">@mod.Icon</span>
                            <span class="pill">@mod.ActiveCount Karten</span>
                            @if (_tab == "private" && _latestVersions.TryGetValue(mod.Id, out var lv)) { <span class="pill" title="Neueste veröffentlichte Modulversion">V@(lv)</span> }
                            else if (_tab == "private") { <span class="pill" title="Noch keine Modulversion veröffentlicht">Entwurf</span> }
                        </div>
                        <h2>@mod.Name</h2>
                        @if (_tab == "private" && _usage.TryGetValue(mod.Id, out var uses) && uses.Count > 0)
                        {
                            <div class="module-usage" @onclick:stopPropagation="true">
                                <span class="muted">Verwendet in @uses.Count @(uses.Count == 1 ? "Thema" : "Themen"):</span>
                                @foreach (var u in uses)
                                {
                                    <a class="badge" href="@UsageHref(u)"
                                       title="@UsageTitle(u)">@u.TopicName@(u.InDraft ? " · Entwurf" : "")@(u.Versions.Count > 0 ? " · V" + string.Join("/", u.Versions) : "")</a>
                                }
                            </div>
                        }
                        @if (_certs.TryGetValue(mod.Id, out var cert))
                        {
                            <p class="module-pass">
                                <span class="badge badge-pass" title="Das Modul-Quiz wurde bestanden">✔ Bestanden · Note @cert.Grade (@GermanGrade.Label(cert.Grade))</span>
                                <a class="btn btn-ghost btn-sm" href="/api/certificates/@cert.Id/certificate.html" download @onclick:stopPropagation="true"
                                   aria-label="@($"Zertifikat für {mod.Name} herunterladen")">🎓 Zertifikat</a>
                            </p>
                        }
                        @if (_tab == "shared")
                        {
                            <p class="module-origin">von @mod.OwnerName · nur lernen</p>
                        }
                        else if (_tab == "global")
                        {
                            <p class="module-origin">Version @mod.GlobalVersion · Herkunft: @mod.OwnerName</p>
                        }
                        @if (!string.IsNullOrEmpty(mod.Description))
                        {
                            <p class="module-desc">@mod.Description</p>
                        }
                        <div class="module-meta">
                            <span>@mod.ActiveCount aktiv</span>
                            <span class="dot">·</span>
                            <span>@(mod.CardCount - mod.ActiveCount) archiviert</span>
                        </div>
                    </div>
                </article>
            }
        </div>
        }
        }
    }
</div>

@code {
    private List<ModuleInfo> _modules = new();
    private Dictionary<string, int> _latestVersions = new();
    private List<ModuleInfo> _shared = new();
    private List<ModuleInfo> _global = new();
    private string _tab = "private";
    private string _q = "", _sort = "fav", _view = "tiles", _flt = "";
    /// <summary>Direktlink auf eine Ansicht: <c>?view=list</c> bzw. <c>?view=tiles</c> (überschreibt die gemerkte Ansicht beim Start).</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? ViewQuery { get; set; }
    /// <summary>Suchbegriff aus dem Suchfeld im Kopfbereich (<c>/?q=</c>): filtert die Module, die der Benutzer sehen darf.</summary>
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    private bool _favOnly;
    private HashSet<string> _favs = new(StringComparer.OrdinalIgnoreCase);
    private static readonly (string Value, string Label)[] SortOpts = { ("fav", "Favoriten zuerst"), ("name", "Name A–Z"), ("name_desc", "Name Z–A"), ("cards", "Meiste Karten"), ("updated", "Zuletzt geändert"), ("created", "Zuletzt angelegt") };
    private static readonly (string Value, string Label)[] GroupOpts = { ("", "keine"), ("status", "Stand (bestanden/offen)"), ("topic", "Thema"), ("pub", "Veröffentlichung"), ("date", "Änderungsmonat") };
    private string _group = "";

    private Func<ModuleInfo, (int Order, string Title)>? GroupKey() => _group switch
    {
        "status" => m => _certs.ContainsKey(m.Id) ? (0, "Bestanden") : (1, "Noch nicht bestanden"),
        "topic" => m => _usage.TryGetValue(m.Id, out var u) && u.Count > 0 ? (0, u[0].TopicName) : (1, "Ohne Thema"),
        "pub" => m => _tab == "global" ? (0, "Global veröffentlicht") : _tab == "shared" ? (0, "Freigegeben") : _latestVersions.ContainsKey(m.Id) ? (0, "Als Modulversion veröffentlicht") : (1, "Entwurf (nicht veröffentlicht)"),
        "date" => m => ListGrouping.Month(m.UpdatedAt),
        _ => null,
    };

    private List<ModuleInfo> Shown()
    {
        var q = _q.Trim();
        IEnumerable<ModuleInfo> r = Current.Where(m =>
            (q.Length == 0 || m.Name.Contains(q, StringComparison.CurrentCultureIgnoreCase) || (m.Description ?? "").Contains(q, StringComparison.CurrentCultureIgnoreCase))
            && (!_favOnly || _favs.Contains(m.Id))
            && (_flt switch { "passed" => _certs.ContainsKey(m.Id), "open" => !_certs.ContainsKey(m.Id), "unused" => !_usage.TryGetValue(m.Id, out var u) || u.Count == 0, _ => true }));
        var cmp = StringComparer.CurrentCultureIgnoreCase;
        r = _sort switch
        {
            "name" => r.OrderBy(m => m.Name, cmp),
            "name_desc" => r.OrderByDescending(m => m.Name, cmp),
            "cards" => r.OrderByDescending(m => m.ActiveCount).ThenBy(m => m.Name, cmp),
            "updated" => r.OrderByDescending(m => m.UpdatedAt).ThenBy(m => m.Name, cmp),
            "created" => r.OrderByDescending(m => m.CreatedAt).ThenBy(m => m.Name, cmp),
            _ => r.OrderByDescending(m => _favs.Contains(m.Id)).ThenBy(m => m.Name, cmp),
        };
        return r.ToList();
    }

    private async Task ToggleFav(string id)
    {
        try { if (await Favs.ToggleAsync(_userId, "module", id)) _favs.Add(id); else _favs.Remove(id); }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException) { _message = e.Message; _messageOk = false; }
    }
    private List<ModuleInfo> Current => _tab switch { "shared" => _shared, "global" => _global, _ => _modules };
    private bool _loading = true;
    private bool _importing;
    private string? _message;
    private bool _messageOk;
    private string _userName = "";
    private bool _showCreate;
    private string _newName = "";
    private string _newDescription = "";
    private string _newIcon = "📚";
    private string _newColor = "#2AA79B";
    private List<CardJson>? _pendingImportCards;
    private ImportAnalysis? _importAnalysis;
    private bool _showImportPreview;
    private string _importFileName = "";
    private int _importProgressPercent;
    private string _importProgressLabel = "";
    private string? _pendingDeleteModuleId;
    private static string UsageHref(ModuleTopicUsage u) => u.Versions.Count > 0 ? "/topics/" + u.TopicId + "?version=" + u.Versions.Max() : "/topics/" + u.TopicId + "/edit";
    private static string UsageTitle(ModuleTopicUsage u) => (u.InDraft ? "im Entwurf" : "nur in veröffentlichten Versionen") + (u.Versions.Count > 0 ? ", veröffentlicht in Version " + string.Join(", ", u.Versions) : "") + (u.GlobalActive ? ", global aktiv" : "");
    private List<TopicSummary> _mandatory = new();
    private Dictionary<string, List<ModuleTopicUsage>> _usage = new(StringComparer.OrdinalIgnoreCase);
    private ModuleDefinition? _pendingModule;
    private string _pendingModuleJson = "";
    private bool _cloning;

    private static string FileName(string name) => new string(name.Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray()).Trim('-').ToLowerInvariant();

    protected override async Task OnInitializedAsync()
    {
        if (ViewQuery is "tiles" or "list") _view = ViewQuery;
        if (!string.IsNullOrWhiteSpace(SearchQuery)) _q = SearchQuery.Trim()[..Math.Min(SearchQuery.Trim().Length, 100)];
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userName = auth.User.Identity?.Name ?? "";
        _userId = auth.User.GetUserId() ?? throw new UnauthorizedAccessException();
        _restricted = await Repo.IsRestrictedLearnerAsync(_userId);   // externe Lernprofile: keine Anlage, kein Import
        _favs = await Favs.ListAsync(_userId, "module");
        await ReloadAsync();
    }

    private string _userId = "";
    private bool _restricted;
    private Dictionary<string, Certificate> _certs = new(StringComparer.OrdinalIgnoreCase);

    private async Task ReloadAsync()
    {
        _loading = true;
        _modules = await Repo.ListModulesAsync(_userId);
        _latestVersions = await ModuleVersions.ListLatestVersionNumbersAsync(_userId);
        _shared = await Repo.ListSharedWithMeAsync(_userId);
        _global = await Repo.ListGlobalModulesAsync(_userId);
        // bestandene Module: jüngstes Zertifikat je Modul (bei globalen Modulen gehört es zur jeweiligen Version)
        try
        {
            // Pflichtthemen und Modulverwendung: ausschließlich serverseitig für den angemeldeten Benutzer; ein Fehler blockiert die Startseite nie
            _mandatory = (await TopicSvc.ListOverviewAsync(_userId)).Mandatory;
            _usage = await TopicSvc.ListModuleUsageAsync(_userId);
        }
        catch (Exception) { _mandatory = new(); _usage = new(StringComparer.OrdinalIgnoreCase); }
        _certs = (await Certs.ListForUserAsync(_userId)).Where(c => !c.IsRevoked).GroupBy(c => c.ModuleId, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(c => c.IssuedAt).First(), StringComparer.OrdinalIgnoreCase);
        _loading = false;
    }

    private void Open(string id) => Nav.NavigateTo($"/module/{id}");

    private async Task CreateModule()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        await Repo.CreateModuleAsync(new ModuleCreateRequest
        {
            Name = _newName, Description = _newDescription, Icon = _newIcon, Color = _newColor,
        }, _userId);
        _newName = ""; _newDescription = ""; _showCreate = false;
        await ReloadAsync();
    }

    private async Task HandleImport(InputFileChangeEventArgs e)
    {
        _message = null;
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 28 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            if (LooksLikeModuleDefinition(content))
            {
                // vollständiges Modul-JSON (ADR 0028): validieren, Vorschau, erst nach Bestätigung importieren
                _pendingModule = ModuleTransferService.Parse(content);
                _pendingModuleJson = content;
                _importFileName = e.File.Name;
                _message = null;
                return;
            }
            var cards = Api.ApiEndpoints.ParseCardsJson(content);
            _pendingImportCards = cards;
            _importFileName = e.File.Name;
            _importAnalysis = AnalyzeImport(cards);
            _showImportPreview = true;
            _message = _importAnalysis.Errors.Count == 0
                ? $"Analyse abgeschlossen: {_importAnalysis.TotalCards} Karten in {_importAnalysis.ModuleCount} Modulen."
                : "Analyse abgeschlossen: Import wegen Validierungsfehlern noch nicht freigegeben.";
            _messageOk = _importAnalysis.Errors.Count == 0;
        }
        catch (IOException)
        {
            _message = "❌ Die Datei ist zu groß (höchstens 28 MB). Teile den Inhalt auf mehrere Dateien auf oder verwende kleinere Bilder.";
            _messageOk = false;
            CancelImport();
            CancelModuleImport();
        }
        catch (Exception ex)
        {
            _message = $"❌ Fehler: {ex.Message}";
            _messageOk = false;
            CancelImport();
            CancelModuleImport();
        }
    }

    private static bool LooksLikeModuleDefinition(string content)
    {
        var head = content.AsSpan(0, Math.Min(content.Length, 4096));
        return head.TrimStart().StartsWith("{") && head.Contains("\"learny-module\"", StringComparison.Ordinal);
    }

    private async Task ConfirmModuleImport()
    {
        if (_pendingModule is null) return;
        _importing = true;
        try
        {
            var module = await Transfer.ImportJsonAsync(_userId, _pendingModuleJson);
            _message = $"✅ Modul „{module.Name}“ importiert ({module.ActiveCount} Karten).";
            _messageOk = true;
            CancelModuleImport();
            _tab = "private";
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException or Services.ImageStorage.ImageStorageException)
        {
            _message = $"❌ {ex.Message}";
            _messageOk = false;
        }
        finally { _importing = false; }
    }

    private void CancelModuleImport() { _pendingModule = null; _pendingModuleJson = ""; _importFileName = ""; }

    private async Task CloneAsync(ModuleInfo source)
    {
        _cloning = true;
        try
        {
            var clone = await Transfer.CloneGlobalAsync(_userId, source.Id);
            _message = $"✅ „{source.Name}“ wurde als eigenes Modul „{clone.Name}“ geklont ({clone.ActiveCount} Karten) und kann jetzt in Themen verwendet werden.";
            _messageOk = true;
            _tab = "private";
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or KeyNotFoundException or UnauthorizedAccessException or Services.ImageStorage.ImageStorageException)
        {
            _message = $"❌ {ex.Message}";
            _messageOk = false;
        }
        finally { _cloning = false; }
    }

    private async Task ConfirmImport()
    {
        if (_pendingImportCards is null || _importAnalysis is null || _importAnalysis.Errors.Count > 0) return;

        _importing = true;
        _message = null;
        _importProgressPercent = 0;
        _importProgressLabel = "Import wird vorbereitet";
        try
        {
            var (created, updated, skipped) = await Repo.ImportAsync(_pendingImportCards, overwriteExisting: false, ownerId: _userId, progress: async progress =>
            {
                _importProgressPercent = Math.Clamp((int)Math.Round(progress.Processed * 100d / Math.Max(progress.Total, 1)), 0, 100);
                _importProgressLabel = $"Karte {progress.Processed} von {progress.Total}: {progress.Module} / {progress.Term}";
                await InvokeAsync(StateHasChanged);
            });
            _message = $"✅ {created} erstellt, {updated} aktualisiert, {skipped} übersprungen";
            _messageOk = true;
            CancelImport();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = $"❌ Fehler: {ex.Message}";
            _messageOk = false;
        }
        finally { _importing = false; }
    }

    private void CancelImport()
    {
        _pendingImportCards = null;
        _importAnalysis = null;
        _showImportPreview = false;
        _importFileName = "";
        _importProgressPercent = 0;
        _importProgressLabel = "";
    }

    private void AskDeleteModule(string id) => _pendingDeleteModuleId = id;

    private void CancelDeleteModule() => _pendingDeleteModuleId = null;

    private async Task ConfirmDeleteModule(string id)
    {
        _pendingDeleteModuleId = null;
        try
        {
            var deleted = await Repo.DeleteModuleAsync(id, _userId);
            _message = deleted == 0 ? "❌ Modul wurde nicht gefunden." : "✅ Modul wurde gelöscht.";
            _messageOk = deleted > 0;
        }
        catch (InvalidOperationException e)
        {
            _message = "❌ " + e.Message;
            _messageOk = false;
        }
        await ReloadAsync();
    }

    private static ImportAnalysis AnalyzeImport(List<CardJson> cards)
    {
        var modules = cards.Select(c => c.Module?.Trim() ?? "")
            .Where(m => m.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(m => m)
            .ToList();
        var categories = cards.Select(c => $"{c.Module}::{c.Category}".Trim())
            .Where(c => c.Length > 2)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var archivedCount = cards.Count(c => c.Archived);
        var errors = new List<string>();

        for (var i = 0; i < cards.Count; i++)
        {
            var (ok, error) = cards[i].Validate();
            if (!ok) errors.Add($"Eintrag {i + 1}: {error}");
        }

        return new ImportAnalysis(
            cards.Count,
            modules.Count,
            categories.Count,
            archivedCount,
            modules,
            errors);
    }

    private sealed record ImportAnalysis(
        int TotalCards,
        int ModuleCount,
        int CategoryCount,
        int ArchivedCount,
        List<string> ModuleNames,
        List<string> Errors);
    }
}
