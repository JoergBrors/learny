@page "/admin/credentials"
@attribute [Authorize]
@rendermode InteractiveServer
@using LearnCards.Web.Services.Certificates
@inject CredentialRegisterService Register
@inject CertificateService Certs
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Zertifikate &amp; Nachweise — LearnCards</PageTitle>

<div class="container">
    <div class="page-head">
        <div>
            <h1>Zertifikate &amp; Nachweise</h1>
            <p class="muted">
                Ausstellungsregister, Testnachweise und gezielter Widerruf (ADR 0037). Das Register zeigt <strong>nur Administratoren</strong>, wer wann welchen Nachweis für wen ausgestellt hat.
                Es enthält keine Credentials, Antworten oder Lerninhalte.
            </p>
        </div>
        <div class="page-head-actions"><a class="btn btn-ghost" href="/admin">← Administration</a> <a class="btn btn-ghost" href="/admin/pki">PKI</a></div>
    </div>

    @if (!_isAdmin)
    {
        <div class="alert alert-error" role="status">Für diese Seite fehlen die Rechte (Administrator).</div>
    }
    else
    {
        <div class="tabs" role="tablist">
            @foreach (var (key, label) in Tabs)
            {
                <button class="btn @(_tab == key ? "btn-primary" : "btn-ghost") btn-sm" role="tab" aria-selected="@(_tab == key)" @onclick="() => SetTab(key)">@label</button>
            }
        </div>
        @if (_message is not null)
        {
            <div class="alert @(_error ? "alert-error" : "alert-ok")" role="status">@_message</div>
        }

        @if (_tab == "overview")
        {
            <div class="card panel">
                <h2 class="panel-title">Übersicht</h2>
                <ul>
                    <li><strong>Register:</strong> alle ausgestellten Nachweise (Open Badges, Master-Badges, CLR, signierte PDFs) mit Aussteller, Empfänger, Fingerprint und Status.</li>
                    <li><strong>Testnachweise</strong> sind mit <span class="badge-test">TEST</span> gekennzeichnet, belegen keine Lernleistung, enthalten kein Ergebnis und keine Kompetenz und zählen in keiner Statistik.</li>
                    <li><strong>Widerruf</strong> trifft genau einen Nachweis (Credential-ID). X.509-Signaturzertifikate werden nur in der <a href="/admin/pki">PKI</a> widerrufen.</li>
                </ul>
                <p><button class="btn btn-primary" @onclick='() => SetTab("register")'>Zum Register</button> <button class="btn btn-ghost" @onclick='() => SetFilter("revoked")'>Widerrufene Nachweise</button></p>
            </div>
        }
        else if (_tab == "test")
        {
            <div class="card panel">
                <h2 class="panel-title">Testnachweis ausstellen</h2>
                <p class="muted">
                    Erzeugt einen signierten Testnachweis mit einem eigenen <em>Testsubjekt</em> (Empfänger „TEST-Subjekt“, Konto: Sie als Ausstellende/r). Es werden keine Prüfungen umgangen und keine Abschlüsse markiert.
                    Zum Prüfen mit externen Validatoren laden Sie danach JSON und JWT herunter.
                </p>
                <p>
                    <button class="btn btn-primary" disabled="@_busy" @onclick='() => IssueTestAsync("badge")'>Open Badge 3.0 – Modul</button>
                    <button class="btn btn-primary" disabled="@_busy" @onclick='() => IssueTestAsync("topic")'>Master-Badge &amp; CLR 2.0 – Themenabschluss (mit zwei Modul-Badges)</button>
                </p>
                <p class="muted">Ein signiertes Zertifikats-PDF erzeugen Sie anschließend in der Detailansicht des Test-Themenabschlusses („PDF“).</p>
            </div>
        }
        else if (_tab == "validator")
        {
            <div class="card panel">
                <h2 class="panel-title">Prüfung und Validatorstatus</h2>
                <ul>
                    <li>Neue Credentials: VC-JWT nach Open Badges 3.0 / CLR 2.0 §„JSON Web Token Proof Format“ (ES256, <code>typ: JWT</code>, <code>iss</code>/<code>jti</code>/<code>nbf</code>/<code>sub</code>); die JSON-Datei enthält keinen eigenen Proof, das <code>.jwt</code> ist der Proof.</li>
                    <li>Ältere Credentials (Profil <code>vc+jwt</code>) bleiben unverändert und prüfbar.</li>
                    <li>Die Spezifikation fordert RS256 als Minimum; Learny signiert mit ES256 („schränkt die Interoperabilität ein“). Ob der 1EdTech-Validator ES256 annimmt, ist <strong>nicht belegt</strong> — bitte mit einem Testnachweis prüfen.</li>
                    <li>Learny ist nicht von 1EdTech oder LinkedIn zertifiziert. Details: <code>docs/credential-validation.md</code>.</li>
                </ul>
            </div>
        }
        else
        {
            <div class="card panel">
                <h2 class="panel-title">Ausgestellte Zertifikate und Nachweise</h2>
                <div class="filter-grid">
                    <label>Suche (ID, Nummer, Fingerprint, Name)<input class="input" @bind="_q.Text" @bind:event="oninput" @onkeydown="OnKey" /></label>
                    <label>Credential-ID<input class="input" @bind="_q.Id" /></label>
                    <label>Fingerprint (SHA-256, ab 8 Zeichen)<input class="input" @bind="_q.Fingerprint" /></label>
                    <label>X.509-Thumbprint<input class="input" @bind="_q.Thumbprint" /></label>
                    <label>Zertifikatsnummer<input class="input" @bind="_q.Number" /></label>
                    <label>Empfänger<input class="input" @bind="_q.Recipient" /></label>
                    <label>Aussteller<input class="input" @bind="_q.Issuer" /></label>
                    <label>Modul / Thema<input class="input" @bind="_q.Module" /></label>
                    <label>Status<select class="input" @bind="_q.Status"><option value="">alle</option><option value="active">aktiv</option><option value="revoked">widerrufen</option></select></label>
                    <label>Test / Regulär<select class="input" @bind="_q.Test"><option value="">alle</option><option value="test">Test</option><option value="regular">regulär</option></select></label>
                    <label>Typ<select class="input" @bind="_q.Kind"><option value="">alle</option><option value="badge">Badge (Modul)</option><option value="master">Master-Badge</option><option value="clr">CLR</option><option value="pdf">PDF / X.509</option></select></label>
                    <label>Von<input class="input" type="date" @bind="_q.From" /></label>
                    <label>Bis<input class="input" type="date" @bind="_q.To" /></label>
                    <label>Sortierung<select class="input" @bind="_q.Sort"><option value="desc">neueste zuerst</option><option value="asc">älteste zuerst</option></select></label>
                </div>
                <p><button class="btn btn-primary" disabled="@_busy" @onclick="SearchAsync">Suchen</button> <button class="btn btn-ghost" @onclick="ResetAsync">Zurücksetzen</button></p>

                @if (_page is null) { <p class="muted">Lade …</p> }
                else if (_page.Items.Count == 0) { <p class="muted">Keine Nachweise gefunden.</p> }
                else
                {
                    <div class="table-wrap">
                        <table class="table">
                            <thead><tr><th>Status</th><th>Typ</th><th>TEST/Regulär</th><th>Zertifikat / Nachweis</th><th>Empfänger</th><th>Aussteller</th><th>Ausgestellt am (UTC)</th><th>Fingerprint / Thumbprint</th><th>Widerrufen am</th><th>Aktionen</th></tr></thead>
                            <tbody>
                            @foreach (var r in _page.Items)
                            {
                                <tr class="@(r.Status == "revoked" ? "row-revoked" : "")">
                                    <td><span class="@(r.Status == "revoked" ? "pill pill-bad" : "pill pill-ok")">@(r.Status == "revoked" ? "widerrufen" : "aktiv")</span></td>
                                    <td>@r.TypeLabel@(r.HasPdf ? " + PDF" : "")</td>
                                    <td>@if (r.IsTest) { <span class="badge-test">TEST</span> } else { <span>regulär</span> }</td>
                                    <td><strong>@r.Number</strong><br /><span class="muted">@r.Title@(r.Version > 0 ? $" (v{r.Version})" : "")</span></td>
                                    <td>@r.Recipient</td>
                                    <td>@r.IssuerName<br /><span class="muted">@SourceLabel(r.Source)</span></td>
                                    <td>@r.IssuedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><code title="@r.Fingerprint">@Short(r.Fingerprint)</code>@if (r.Thumbprint is { } tp) { <br /><code title="@tp">X.509 @Short(tp)</code> }</td>
                                    <td>@(r.RevokedAt?.ToString("yyyy-MM-dd HH:mm") ?? "–")</td>
                                    <td class="actions">
                                        <button class="btn btn-ghost btn-sm" @onclick="() => ShowAsync(r.Id)">Details</button>
                                        <a class="btn btn-ghost btn-sm" href="/verify/@r.Id" target="_blank" rel="noopener">Prüfseite</a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <p class="muted">@_page.Total Treffer · Seite @_page.PageNumber von @Math.Max(1, (int)Math.Ceiling(_page.Total / (double)_page.PageSize))
                        <button class="btn btn-ghost btn-sm" disabled="@(_page.PageNumber <= 1)" @onclick="() => GoPage(_page.PageNumber - 1)">‹ zurück</button>
                        <button class="btn btn-ghost btn-sm" disabled="@(_page.PageNumber * _page.PageSize >= _page.Total)" @onclick="() => GoPage(_page.PageNumber + 1)">weiter ›</button></p>
                }
            </div>

            @if (_detail is { } d)
            {
                <div class="card panel" id="detail">
                    <h2 class="panel-title">Details @d.Row.Number @if (d.Row.IsTest) { <span class="badge-test">TEST</span> }</h2>
                    <dl class="kv">
                        <dt>Nachweis-ID</dt><dd><code>@d.Row.Id</code></dd>
                        <dt>Typ</dt><dd>@d.Row.TypeLabel · @d.Row.Title (Version @d.Row.Version)</dd>
                        <dt>Aussteller</dt><dd>@d.Row.IssuerName (@SourceLabel(d.Row.Source))@(d.Row.IssuerId is { } iid ? $" · ID {iid}" : "")</dd>
                        <dt>Empfänger</dt><dd>@d.Row.Recipient</dd>
                        <dt>Ausgestellt (UTC)</dt><dd>@d.Row.IssuedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        <dt>Fingerprint (SHA-256 der signierten JWS)</dt><dd><code>@d.Row.Fingerprint</code> <button class="btn btn-ghost btn-sm" @onclick="() => CopyAsync(d.Row.Fingerprint)">Kopieren</button></dd>
                        @if (d.Row.ClrFingerprint is { } cf) { <dt>CLR-Fingerprint</dt><dd><code>@cf</code> <button class="btn btn-ghost btn-sm" @onclick="() => CopyAsync(cf)">Kopieren</button></dd> }
                        @if (d.Row.PdfSha256 is { } pf) { <dt>PDF (SHA-256)</dt><dd><code>@pf</code> <button class="btn btn-ghost btn-sm" @onclick="() => CopyAsync(pf)">Kopieren</button></dd> }
                        @if (d.Row.Thumbprint is { } t) { <dt>X.509-Thumbprint (PDF-Signatur)</dt><dd><code>@t</code> <button class="btn btn-ghost btn-sm" @onclick="() => CopyAsync(t)">Kopieren</button>@(d.PkiCertificateId is { } pid ? $" · PKI-Zertifikat {d.PkiStatus}" : "") <a href="/admin/pki">PKI öffnen</a></dd> }
                        <dt>Signatur</dt><dd>@d.Alg · Schlüssel <code>@d.KeyId</code> · Profil @d.Profile · @(d.SignatureValid ? "gültig" : "UNGÜLTIG: " + d.SignatureError)@(d.ClrSignatureValid is { } cs ? $" · CLR-Signatur {(cs ? "gültig" : "UNGÜLTIG")}" : "")</dd>
                        <dt>Prüfstatus (lokal)</dt>
                        <dd>
                            <ul class="plain">
                                <li><strong>Signaturformat:</strong> @d.Validation.Format</li>
                                <li><strong>Signatur:</strong> @d.Validation.Signature</li>
                                <li><strong>Aussteller:</strong> @d.Validation.Issuer</li>
                                <li><strong>Schlüssel-URL (kid):</strong> <code>@d.Validation.KeyUrl</code> — @d.Validation.KeyAccess</li>
                                <li><strong>Widerruf:</strong> @d.Validation.Revocation</li>
                                <li><strong>Externe 1EdTech-Prüfung:</strong> @d.Validation.External</li>
                            </ul>
                        </dd>
                        <dt>Status</dt><dd>@(d.Row.Status == "revoked" ? $"widerrufen am {d.Row.RevokedAt:yyyy-MM-dd HH:mm} UTC von {d.RevokedByName} — {d.RevokedReason}" : "aktiv")</dd>
                        <dt>Öffentliche Prüfadresse</dt><dd><a href="@d.VerifyUrl" target="_blank" rel="noopener">@d.VerifyUrl</a></dd>
                        @if (d.Parent is { } p) { <dt>Übergeordnet</dt><dd><button class="btn btn-ghost btn-sm" @onclick="() => ShowAsync(p.Id)">@p.Number — @p.Title</button></dd> }
                        @if (d.Children.Count > 0) { <dt>Verknüpfte Nachweise</dt><dd>@foreach (var c in d.Children) { <button class="btn btn-ghost btn-sm" @onclick="() => ShowAsync(c.Id)">@c.Number (@c.Status)</button> }</dd> }
                    </dl>
                    @if (d.Row.IsTest && d.Row.IssuerId == _userId)
                    {
                        <p>Downloads:
                            <a class="btn btn-ghost btn-sm" href="@(d.Row.Kind == "topic" ? $"/api/certificates/{d.Row.Id}/badge" : $"/api/certificates/{d.Row.Id}/badge")">JSON</a>
                            <a class="btn btn-ghost btn-sm" href="/api/certificates/@d.Row.Id/badge.jwt">JWT</a>
                            @if (d.Row.Kind == "topic") { <a class="btn btn-ghost btn-sm" href="/api/certificates/@d.Row.Id/clr">CLR (JSON)</a> <a class="btn btn-ghost btn-sm" href="/api/certificates/@d.Row.Id/clr.jwt">CLR (JWT)</a> }
                            <a class="btn btn-ghost btn-sm" href="/api/certificates/@d.Row.Id/certificate.pdf">PDF</a></p>
                    }
                    else { <p class="muted">Downloads stehen nur den Empfängern (bzw. beim Testnachweis den Ausstellenden) zur Verfügung; die öffentliche Prüfseite zeigt nur den Status.</p> }

                    <h3>Auditverlauf</h3>
                    @if (d.Audit.Count == 0) { <p class="muted">Keine Einträge (Altbestand).</p> }
                    else { <ul>@foreach (var a in d.Audit) { <li>@a.At.ToString("yyyy-MM-dd HH:mm:ss") UTC · <code>@a.Action</code> · @a.ActorName</li> }</ul> }

                    @if (d.Row.Status == "active")
                    {
                        <h3>Widerruf</h3>
                        <p class="muted">@d.Impact</p>
                        <div class="alert alert-warn">Der Widerruf ist dauerhaft. Die signierten Daten bleiben unverändert, die Prüfung meldet den Nachweis aber als widerrufen. Eine erneute Ausstellung benötigt eine neue Nachweis-ID.</div>
                        <label>Grund<select class="input" @bind="_reasonPreset"><option>Ausstellung irrtümlich</option><option>Fehlerhafte Angaben</option><option>Missbrauch / Täuschung</option><option>Testnachweis nicht mehr benötigt</option></select></label>
                        <label>Ergänzung (optional)<input class="input" maxlength="300" @bind="_reasonExtra" /></label>
                        <label>Zur Bestätigung die Nachweisnummer <code>@d.Row.Number</code> eingeben<input class="input" @bind="_confirm" /></label>
                        <p><button class="btn btn-danger" disabled="@(_busy || !string.Equals(_confirm.Trim(), d.Row.Number, StringComparison.OrdinalIgnoreCase))" @onclick="() => RevokeAsync(d.Row.Id)">Nachweis widerrufen</button></p>
                    }
                </div>
            }
        }
    }
</div>

@code {
    private static readonly (string, string)[] Tabs = { ("overview", "Übersicht"), ("test", "Testnachweis ausstellen"), ("register", "Ausstellungsregister"), ("validator", "Prüfung und Validatorstatus") };
    private string _userId = "", _tab = "overview", _confirm = "", _reasonPreset = "Ausstellung irrtümlich", _reasonExtra = "";
    private bool _isAdmin, _busy, _error;
    private string? _message;
    private readonly CredentialRegisterService.Query _q = new() { Sort = "desc" };
    private CredentialRegisterService.Page? _page;
    private CredentialRegisterService.Detail? _detail;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId = auth.User.GetUserId() ?? throw new UnauthorizedAccessException();
        _isAdmin = auth.User.IsInRole(Roles.Admin);   // nur zur Anzeige; jede Aktion prüft der Dienst gegen die Rollen in der Datenbank
    }

    private static string Short(string s) => s.Length <= 20 ? s : s[..10] + "…" + s[^6..];
    private static string SourceLabel(string s) => s switch { "admin" => "Administrator", "exam" => "Prüfsystem (reguläre Prüfung)", _ => "Altbestand, Aussteller nicht erfasst" };

    private async Task SetTab(string tab) { _tab = tab; _message = null; if (tab == "register" && _page is null) await SearchAsync(); }
    private async Task SetFilter(string status) { _q.Status = status; _tab = "register"; _q.Page = 1; await SearchAsync(); }
    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") { _q.Page = 1; await SearchAsync(); } }
    private async Task GoPage(int p) { _q.Page = Math.Max(1, p); await SearchAsync(); }
    private async Task ResetAsync() { _q.Text = _q.Id = _q.Fingerprint = _q.Thumbprint = _q.Number = _q.Recipient = _q.Issuer = _q.Module = _q.Status = _q.Test = _q.Kind = null; _q.From = _q.To = null; _q.Sort = "desc"; _q.Page = 1; await SearchAsync(); }

    private async Task SearchAsync()
    {
        _busy = true; _message = null;
        try { _page = await Register.SearchAsync(_userId, _q); }
        catch (UnauthorizedAccessException) { _message = "Administratorrechte erforderlich."; _error = true; }
        _busy = false;
    }

    private async Task ShowAsync(string id)
    {
        try { _detail = await Register.GetDetailAsync(_userId, id); _confirm = ""; }
        catch (UnauthorizedAccessException) { _message = "Administratorrechte erforderlich."; _error = true; }
    }

    private async Task IssueTestAsync(string type)
    {
        _busy = true; _message = null;
        try
        {
            var c = await Certs.IssueTestAsync(_userId, type, Guid.NewGuid().ToString("N"));
            _message = $"Testnachweis {c.Number} ausgestellt."; _error = false;
            _tab = "register"; _q.Test = "test"; _q.Page = 1;
            await SearchAsync(); await ShowAsync(c.Id);
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or ArgumentException) { _message = ex.Message; _error = true; }
        _busy = false;
    }

    private async Task RevokeAsync(string id)
    {
        _busy = true; _message = null;
        try
        {
            var reason = _reasonPreset + (string.IsNullOrWhiteSpace(_reasonExtra) ? "" : " — " + _reasonExtra.Trim());
            var o = await Register.RevokeAsync(_userId, id, reason, _confirm, Guid.NewGuid().ToString("N"));
            _message = o.Changed ? $"Nachweis {o.Number} wurde widerrufen." : $"Nachweis {o.Number} war bereits widerrufen.";
            _error = false;
            await SearchAsync(); await ShowAsync(id);
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or ArgumentException or KeyNotFoundException) { _message = ex.Message; _error = true; }
        _busy = false;
    }

    private async Task CopyAsync(string text) { try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); _message = "In die Zwischenablage kopiert."; _error = false; } catch (JSException) { _message = "Kopieren nicht möglich – bitte den Wert markieren."; _error = true; } }
}
