@page "/module/{ModuleId}/edit"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CardRepository Repo
@inject QuizService Quiz
@inject TopicService TopicSvc
@inject ModuleVersionService ModuleVersions
@inject CompetencyService CompetencySvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@using LearnCards.Web.Services.ImageStorage
@implements IAsyncDisposable

<PageTitle>Karten bearbeiten — @(_module?.Name ?? "Modul") — LearnCards</PageTitle>
<NavigationLock OnBeforeInternalNavigation="OnBeforeNavigateAsync" />

<div class="container editor-page">
    @if (_loading)
    {
        <div class="spinner-wrap" aria-busy="true"><div class="spinner" role="status"></div></div>
    }
    else if (_module is null)
    {
        <div class="alert alert-error" role="alert">Das Modul wurde nicht gefunden oder du darfst es nicht bearbeiten. Nur Eigentümer können ihre Module bearbeiten — freigegebene und globale Module sind schreibgeschützt.</div>
        <a class="btn btn-ghost" href="/">← Zur Übersicht</a>
    }
    else
    {
        var dirty = IsDirty;
        <section class="card panel editor-head">
            <p class="muted breadcrumb"><a href="/">Module</a> › <a href="/module/@ModuleId">@_module.Name</a> › Bearbeiten</p>
            <div class="editor-head-row">
                <h1>✏ Karten bearbeiten <span class="badge badge-private">@_module.Name</span></h1>
                <div class="page-head-actions">
                    <a class="btn btn-ghost" href="/module/@ModuleId">← Zum Modul</a>
                    <button class="btn btn-ghost" @onclick="ToggleConfig">⚙ Quiz-Einstellungen</button>
                    <button class="btn btn-primary" @onclick="NewCardAsync">+ Neue Karte</button>
                </div>
            </div>
            @if (_mv is not null)
            {
                <div class="module-versions" role="group" aria-label="Modulversionen">
                    <span class="badge @(_mv.HasUnpublishedChanges ? "badge-draft" : "")">@(_mv.LatestVersion == 0 ? "Noch nicht veröffentlicht" : $"Version {_mv.LatestVersion}")@(_mv.HasUnpublishedChanges && _mv.LatestVersion > 0 ? " + Entwurf mit Änderungen" : "")</span>
                    <button class="btn btn-ghost btn-sm" @onclick="PublishModuleVersionAsync" disabled="@(!_mv.HasUnpublishedChanges || _versionBusy)"
                            title="Friert den aktuellen Stand (Karten, Bilder, Quiz, Konfiguration, Fragenpool) als unveränderliche Modulversion ein.">⬆ Version veröffentlichen</button>
                    @if (_mv.Versions.Count > 0)
                    {
                        <span class="muted">Frühere Stände (nur lesbar):</span>
                        @foreach (var v in _mv.Versions)
                        {
                            <a class="badge" href="/module/@v.SnapshotModuleId" title="@VersionTitle(v)">V@(v.VersionNumber)</a>
                        }
                    }
                    @if (_versionMessage is not null) { <span class="muted" role="status">@_versionMessage</span> }
                </div>
            }
            <div class="module-competencies">
                <button class="btn btn-ghost btn-sm" @onclick="() => _compOpen = !_compOpen" aria-expanded="@_compOpen">🎯 Lernziele &amp; Kompetenzen (@_model.Competencies.Count)</button>
                @if (_compOpen)
                {
                    <div class="card panel" role="group" aria-label="Lernziele und Kompetenzen">
                        <p class="muted">Kompetenzen werden Karten zugeordnet (im Karteneditor). Im Zertifikat steht nur, was im verifizierten Modulquiz ausreichend geprüft und bestanden wurde — „Modul bestanden“ allein bescheinigt keine Kompetenz.</p>
                        <h3>Lernziele</h3>
                        @foreach (var o in _model.Objectives.ToList())
                        {
                            <div class="form-row">
                                <input class="input" style="max-width:9rem" aria-label="Lernziel-ID" @bind="o.Id" />
                                <input class="input" aria-label="Lernziel" placeholder="Lernziel" @bind="o.Text" />
                                <button class="icon-btn" title="Entfernen" aria-label="Lernziel entfernen" @onclick="() => _model.Objectives.Remove(o)">✕</button>
                            </div>
                        }
                        <button class="btn btn-ghost btn-sm" @onclick="AddObjective">+ Lernziel</button>
                        <h3>Kompetenzen</h3>
                        @foreach (var c in _model.Competencies.ToList())
                        {
                            <div class="form-row">
                                <input class="input" style="max-width:9rem" aria-label="Kompetenz-ID" @bind="c.Id" />
                                <input class="input" aria-label="Bezeichnung" placeholder="Bezeichnung" @bind="c.Name" />
                                <select class="input" style="max-width:14rem" aria-label="Lernziel" @bind="c.ObjectiveId">
                                    <option value="">(ohne Lernziel)</option>
                                    @foreach (var o in _model.Objectives) { <option value="@o.Id">@o.Id – @o.Text</option> }
                                </select>
                                <label>ab <input class="input" style="max-width:5rem" type="number" min="1" max="100" @bind="c.PassPercent" /> %</label>
                                <label>≥ <input class="input" style="max-width:4rem" type="number" min="1" max="50" @bind="c.MinQuestions" /> Fragen</label>
                                <button class="icon-btn" title="Entfernen" aria-label="Kompetenz entfernen" @onclick="() => _model.Competencies.Remove(c)">✕</button>
                            </div>
                        }
                        <button class="btn btn-ghost btn-sm" @onclick="AddCompetency">+ Kompetenz</button>
                        <p><button class="btn btn-primary" @onclick="SaveCompetenciesAsync">Speichern</button>
                            @if (_compMessage is not null) { <span class="@(_compError ? "alert alert-error" : "muted")" role="status">@_compMessage</span> }</p>
                    </div>
                }
            </div>
            @if (_usage.Count > 0)
            {
                <div class="module-usage">
                    <span class="muted">Verwendet in @_usage.Count @(_usage.Count == 1 ? "Thema" : "Themen"):</span>
                    @foreach (var u in _usage)
                    {
                        <a class="badge" href="@UsageHref(u)">@u.TopicName@(u.InDraft ? " · Entwurf" : "")@(u.Versions.Count > 0 ? " · veröffentlicht in V" + string.Join("/", u.Versions) : "")</a>
                    }
                    <span class="muted">Themen verwenden festgelegte Modulversionen: Änderungen am Modul wirken erst nach einer neuen Modulversion und der ausdrücklichen Übernahme im Thema.</span>
                </div>
            }
        </section>

        @if (_configOpen)
        {
            <QuizConfigPanel ModuleId="@ModuleId" OnClose="CloseConfig" />
        }

        <div class="editor-layout">
            <aside class="card panel editor-list" aria-label="Karten des Moduls">
                <div class="editor-list-head">
                    <h2 class="panel-title">Karten</h2>
                    <label class="check"><input type="checkbox" checked="@_showArchived" @onchange="ToggleArchivedAsync" /> Archiv anzeigen</label>
                </div>
                @if (_cards.Count == 0)
                {
                    <p class="muted">Noch keine Karten. Lege mit „+ Neue Karte“ die erste an.</p>
                }
                @foreach (var group in _cards.GroupBy(c => c.Category))
                {
                    <h3 class="editor-group">@(string.IsNullOrWhiteSpace(group.Key) ? "(ohne Kategorie)" : group.Key)</h3>
                    <ul class="editor-cards">
                        @foreach (var c in group)
                        {
                            var card = c;
                            <li class="editor-card @(_draft?.Id == card.Id ? "editor-card-active" : "") @(card.Archived ? "editor-card-archived" : "")">
                                <button type="button" class="editor-card-main" @onclick="() => SelectAsync(card.Id)" aria-current="@(_draft?.Id == card.Id ? "true" : "false")">
                                    <strong>@card.Term</strong>
                                    <span class="muted">@(card.Archived ? "archiviert · " : "")@(card.SlideNumber is { } sn ? $"Folie {sn} · " : "")@(card.Images.Count > 0 ? $"🖼 {card.Images.Count} · " : "")@(card.Quiz.Count > 0 ? $"❓ {card.Quiz.Count}" : "")</span>
                                </button>
                                <div class="editor-card-actions">
                                    @if (!card.Archived)
                                    {
                                        <button type="button" class="btn btn-ghost btn-sm" aria-label="@card.Term nach oben" title="Nach oben" @onclick="() => MoveAsync(card.Id, -1)">↑</button>
                                        <button type="button" class="btn btn-ghost btn-sm" aria-label="@card.Term nach unten" title="Nach unten" @onclick="() => MoveAsync(card.Id, 1)">↓</button>
                                    }
                                    <button type="button" class="btn btn-ghost btn-sm" aria-label="@card.Term duplizieren" title="Duplizieren" @onclick="() => DuplicateAsync(card.Id)">⧉</button>
                                    <button type="button" class="btn btn-ghost btn-sm" aria-label="@card.Term @(card.Archived ? "wiederherstellen" : "archivieren")" title="@(card.Archived ? "Wiederherstellen" : "Archivieren")" @onclick="() => ArchiveAsync(card.Id, !card.Archived)">@(card.Archived ? "↩" : "🗂")</button>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </aside>

            <section class="card panel editor-main" aria-label="Karte bearbeiten">
                @if (_draft is null)
                {
                    <p class="muted">Wähle links eine Karte oder lege eine neue an.</p>
                }
                else
                {
                    <div class="editor-bar" role="status" aria-live="polite">
                        <span class="editor-state @(dirty ? "editor-state-dirty" : "editor-state-clean")">@(dirty ? "● Ungespeicherte Änderungen" : (_draft.Id is null ? "Neue Karte" : "Gespeichert"))</span>
                        <div class="editor-bar-actions">
                            <button class="btn btn-ghost" @onclick="TogglePreview">@(_preview ? "Vorschau schließen" : "👁 Vorschau")</button>
                            <button class="btn btn-ghost" @onclick="DiscardAsync" disabled="@(!dirty)">Änderungen verwerfen</button>
                            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Speichert…" : "Speichern")</button>
                        </div>
                    </div>

                    @if (_error is not null)
                    {
                        <div class="alert alert-error" role="alert">@_error
                            @if (_conflict) { <button class="btn btn-ghost btn-sm" @onclick="ReloadAsync">Neu laden (eigene Änderungen verwerfen)</button> }
                        </div>
                    }
                    @if (_status is not null) { <div class="alert alert-ok" role="status">@_status</div> }

                    <div class="editor-form">
                        <fieldset class="editor-section">
                            <legend>Grunddaten</legend>
                            <div class="form-grid">
                                <label>Kategorie <input class="input" list="editor-categories" maxlength="200" @bind="_draft.Category" @bind:event="oninput" /></label>
                                <label>Begriff (Titel) <input class="input" maxlength="300" @bind="_draft.Term" @bind:event="oninput" /></label>
                            </div>
                            <datalist id="editor-categories">@foreach (var cat in _cards.Select(c => c.Category).Distinct()) { <option value="@cat"></option> }</datalist>
                            <label class="form-label">Frage auf der Kartenvorderseite
                                <textarea class="input" rows="2" @bind="_draft.Question" @bind:event="oninput"></textarea>
                            </label>
                        </fieldset>

                        <fieldset class="editor-section">
                            <legend>Texte (formatierbar)</legend>
                            <RichTextEditor Label="Antwort / Definition" Value="@_draft.Definition" ValueChanged="v => SetText(t => t.Definition = v)" />
                            <RichTextEditor Label="Wie funktioniert es?" Value="@_draft.HowItWorks" ValueChanged="v => SetText(t => t.HowItWorks = v)" />
                            <RichTextEditor Label="Kontext" Value="@_draft.Context" ValueChanged="v => SetText(t => t.Context = v)" />
                            <RichTextEditor Label="Key Fact" Value="@_draft.KeyFact" ValueChanged="v => SetText(t => t.KeyFact = v)" />
                            <RichTextEditor Label="Referenzantwort (für die Quizbewertung)" Value="@_draft.ReferenceAnswer" ValueChanged="v => SetText(t => t.ReferenceAnswer = v)" />
                            <label class="form-label">Chat-Prompt (Anweisung für den KI-Chat dieser Karte)
                                <textarea class="input" rows="2" @bind="_draft.ChatPrompt" @bind:event="oninput"></textarea>
                            </label>
                        </fieldset>

                        <fieldset class="editor-section">
                            <legend>Offizielle Quellen</legend>
                            @for (var i = 0; i < _draft.Sources.Count; i++)
                            {
                                var src = _draft.Sources[i];
                                var si = i;
                                <div class="editor-source">
                                    <input class="input" placeholder="Titel" aria-label="Quelle @(si + 1) Titel" @bind="src.Title" @bind:event="oninput" />
                                    <input class="input" placeholder="https://…" aria-label="Quelle @(si + 1) Adresse" @bind="src.Url" @bind:event="oninput" />
                                    <input class="input" placeholder="Herausgeber" aria-label="Quelle @(si + 1) Herausgeber" @bind="src.Publisher" @bind:event="oninput" />
                                    <button type="button" class="btn btn-ghost btn-sm" aria-label="Quelle @(si + 1) entfernen" @onclick="() => RemoveSource(si)">✕</button>
                                </div>
                            }
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="AddSource">+ Quelle</button>
                        </fieldset>

                        @if (_model.Competencies.Count > 0)
                        {
                            <fieldset class="editor-section">
                                <legend>Kompetenzen dieser Karte</legend>
                                <p class="muted">Fragen dieser Karte zählen im Modulquiz als Nachweis für die gewählten Kompetenzen.</p>
                                @foreach (var comp in _model.Competencies)
                                {
                                    var cid = comp.Id;
                                    <label class="check"><input type="checkbox" checked="@_draft.Competencies.Contains(cid)" @onchange="e => ToggleCompetency(cid, e.Value is true)" /> @comp.Name <span class="muted">(@cid)</span></label>
                                }
                            </fieldset>
                        }
                        <fieldset class="editor-section">
                            <legend>Folienmodus (optional)</legend>
                            <div class="form-grid">
                                <label>Foliennummer <input class="input" type="number" min="1" @bind="_draft.SlideNumber" /></label>
                                <label>Zielzeit (Sekunden) <input class="input" type="number" min="1" @bind="_draft.TargetTimeSec" /></label>
                            </div>
                        </fieldset>

                        <fieldset class="editor-section">
                            <legend>Bilder (@_draft.Images.Count von @CardImageLimits.MaxImagesPerCard)</legend>
                            <p class="muted">PNG, JPEG oder WebP, höchstens 2 MiB je Bild. Alternativtext beschreibt das Bild für Screenreader; die Bildunterschrift erscheint unter dem Bild.</p>
                            @for (var i = 0; i < _draft.Images.Count; i++)
                            {
                                var img = _draft.Images[i];
                                var ii = i;
                                <div class="editor-image">
                                    <img src="@ImageSrc(img)" alt="@(string.IsNullOrWhiteSpace(img.Alt) ? "Bildvorschau" : img.Alt)" class="editor-image-thumb" />
                                    <div class="editor-image-fields">
                                        <label>Alternativtext <input class="input" maxlength="300" @bind="img.Alt" @bind:event="oninput" /></label>
                                        <label>Bildunterschrift <input class="input" maxlength="300" @bind="img.Caption" @bind:event="oninput" /></label>
                                        <div class="editor-image-actions">
                                            <button type="button" class="btn btn-ghost btn-sm" aria-label="Bild @(ii + 1) nach oben" disabled="@(ii == 0)" @onclick="() => MoveImage(ii, -1)">↑</button>
                                            <button type="button" class="btn btn-ghost btn-sm" aria-label="Bild @(ii + 1) nach unten" disabled="@(ii == _draft.Images.Count - 1)" @onclick="() => MoveImage(ii, 1)">↓</button>
                                            @if (img.ConfirmRemove)
                                            {
                                                <span class="muted">Bild wirklich entfernen?</span>
                                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveImage(ii)">Ja, entfernen</button>
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => img.ConfirmRemove = false">Abbrechen</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => img.ConfirmRemove = true">Bild entfernen</button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (_draft.Images.Count < CardImageLimits.MaxImagesPerCard)
                            {
                                <label class="btn btn-ghost editor-upload">🖼 Bild hinzufügen
                                    <InputFile OnChange="OnImagesSelected" accept="image/png,image/jpeg,image/webp" class="visually-hidden" aria-label="Bild hochladen" />
                                </label>
                            }
                            @if (_imageError is not null) { <div class="alert alert-error" role="alert">@_imageError</div> }
                        </fieldset>

                        <fieldset class="editor-section">
                            <legend>Feste Quizfragen dieser Karte (Teil des Karten-JSON)</legend>
                            <p class="muted">Diese Fragen stehen im <code>quiz[]</code> der Karte (Import/Export) und werden <strong>mit der Karte</strong> gespeichert. Das Karten-<code>quiz[]</code> ist ihre einzige Quelle; der Fragenpool enthält davon nur eine Kopie.</p>
                            @for (var i = 0; i < _draft.Quiz.Count; i++)
                            {
                                var q = _draft.Quiz[i];
                                var qi = i;
                                <div class="editor-question">
                                    <div class="editor-question-head"><strong>Frage @(qi + 1)</strong>
                                        <button type="button" class="btn btn-ghost btn-sm" aria-label="Frage @(qi + 1) entfernen" @onclick="() => RemoveCardQuestion(qi)">Entfernen</button></div>
                                    <QuizQuestionForm Model="q" FixedFourOptions="true" OnChanged="Touch" />
                                </div>
                            }
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="AddCardQuestion">+ Feste Frage</button>
                        </fieldset>

                        <fieldset class="editor-section">
                            <legend>Weitere Fragen im Fragenpool (Editor und KI)</legend>
                            @if (_draft.Id is null)
                            {
                                <p class="muted">Speichere die Karte zuerst, dann kannst du ihr Fragen aus dem Fragenpool zuordnen.</p>
                            }
                            else
                            {
                                <p class="muted">Diese Fragen liegen im zentralen <strong>Fragenpool</strong> des Moduls (unabhängig vom Karten-JSON) und werden <strong>sofort einzeln</strong> gespeichert — nicht mit dem Button „Speichern“ der Karte. KI-generierte Fragen kannst du hier prüfen und korrigieren.</p>
                                @if (_poolError is not null) { <div class="alert alert-error" role="alert">@_poolError</div> }
                                @foreach (var pq in _poolQs)
                                {
                                    var p = pq;
                                    <div class="editor-question @(p.Active ? "" : "editor-question-off")">
                                        <div class="editor-question-head">
                                            <span><span class="pill pill-muted">@(p.Origin == "ai" ? "KI" : "Editor")</span> <strong>@p.Question</strong> <span class="muted">(@TypeLabel(p.Type)@(p.Active ? "" : ", deaktiviert"))</span></span>
                                            <span class="editor-question-actions">
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => EditPoolAsync(p)">Bearbeiten</button>
                                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => TogglePoolActiveAsync(p)">@(p.Active ? "Deaktivieren" : "Aktivieren")</button>
                                            </span>
                                        </div>
                                        @if (_poolEditId == p.Id && _poolEdit is not null)
                                        {
                                            <QuizQuestionForm Model="_poolEdit" />
                                            <div class="modal-actions">
                                                <button class="btn btn-ghost btn-sm" @onclick="CancelPoolEdit">Abbrechen</button>
                                                <button class="btn btn-primary btn-sm" @onclick="SavePoolAsync">Frage speichern</button>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (_poolEdit is not null && _poolEditId is null)
                                {
                                    <div class="editor-question">
                                        <strong>Neue Frage</strong>
                                        <QuizQuestionForm Model="_poolEdit" />
                                        <div class="modal-actions">
                                            <button class="btn btn-ghost btn-sm" @onclick="CancelPoolEdit">Abbrechen</button>
                                            <button class="btn btn-primary btn-sm" @onclick="SavePoolAsync">Frage speichern</button>
                                        </div>
                                    </div>
                                }
                                else if (_poolEdit is null)
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="NewPoolQuestion">+ Neue Frage im Fragenpool</button>
                                }
                            }
                        </fieldset>
                    </div>
                }
            </section>
        </div>

        @if (_preview && _draft is not null)
        {
            var overlayDirty = IsDirty;
            <div class="preview-overlay" id="preview-overlay" role="dialog" aria-label="Live-Vorschau" aria-modal="false">
                <div class="preview-overlay-head" id="preview-overlay-head">
                    <strong>👁 Live-Vorschau</strong>
                    <span class="muted preview-overlay-hint">verschiebbar · zeigt Änderungen sofort</span>
                    <span class="preview-overlay-actions">
                        <button type="button" class="btn btn-ghost btn-sm" title="Position zurücksetzen" aria-label="Position der Vorschau zurücksetzen" @onclick="ResetPreviewPosition">⟲</button>
                        <button type="button" class="btn btn-ghost btn-sm" aria-label="Vorschau schließen" @onclick="TogglePreview">✕</button>
                    </span>
                </div>
                <div class="preview-overlay-body">
            <article class="editor-preview" aria-label="Vorschau">
                <span class="pill pill-brand">@_draft.Category</span>
                <h2>@_draft.Term</h2>
                <p class="editor-preview-q">@_draft.Question</p>
                <RichTextView Value="@_draft.Definition" />
                @if (!string.IsNullOrWhiteSpace(_draft.HowItWorks)) { <h3>Wie funktioniert es?</h3><RichTextView Value="@_draft.HowItWorks" /> }
                @if (!string.IsNullOrWhiteSpace(_draft.Context)) { <h3>Kontext</h3><RichTextView Value="@_draft.Context" /> }
                @if (!string.IsNullOrWhiteSpace(_draft.KeyFact)) { <div class="keyfact">🎯 <strong>Key Fact:</strong><RichTextView Value="@_draft.KeyFact" /></div> }
                @foreach (var img in _draft.Images)
                {
                    <figure class="card-image">
                        <img src="@ImageSrc(img)" alt="@img.Alt" loading="lazy" />
                        @if (!string.IsNullOrWhiteSpace(img.Caption)) { <figcaption>@img.Caption</figcaption> }
                    </figure>
                }
                @if (_draft.Quiz.Count + _poolQs.Count > 0)
                {
                    <h3>Quizfragen (richtige Antworten markiert)</h3>
                    <ol class="editor-quiz-preview">
                        @foreach (var q in _draft.Quiz) { <li>@PreviewQuestion(q)</li> }
                        @foreach (var q in _poolQs.Where(p => p.Active)) { <li>@PreviewQuestion(QuizPoolService.ToInput(q)) <span class="pill pill-muted">@(q.Origin == "ai" ? "KI" : "Editor")</span></li> }
                    </ol>
                }
                @if (_draft.Id is not null)
                {
                    <button class="btn btn-ghost" @onclick="OpenQuizPreview" disabled="@overlayDirty" title="@(overlayDirty ? "Erst speichern, dann ausprobieren" : "Quiz dieser Karte ausprobieren")">📝 Quiz dieser Karte ausprobieren</button>
                    @if (overlayDirty) { <span class="muted"> — erst speichern</span> }
                }
            </article>
                </div>
            </div>
        }

        @if (_quizPreviewOpen && _draft?.Id is not null)
        {
            <CardQuizPanel CardId="@_draft.Id" CardTerm="@_draft.Term" OnClose="CloseQuizPreview" />
        }
    }
</div>

@code {
    [Parameter] public string ModuleId { get; set; } = "";
    [SupplyParameterFromQuery(Name = "card")] public string? CardParam { get; set; }

    private sealed class DraftImage
    {
        public string ImageId = "";
        public string Mime = "";
        public string? Data;   // nur bei neu hochgeladenen Bildern (Base64); vorhandene Bilder werden über /api/images/{id} gezeigt
        public string Alt = "", Caption = "";
        public bool ConfirmRemove;
    }

    private sealed class Draft
    {
        public string? Id;
        public DateTime? UpdatedAt;
        public bool Archived;
        public string Category = "", Term = "", Question = "", Definition = "", HowItWorks = "", Context = "", KeyFact = "", ReferenceAnswer = "", ChatPrompt = "";
        public int? SlideNumber, TargetTimeSec;
        public int SortOrder;
        public List<OfficialSource> Sources = new();
        public List<DraftImage> Images = new();
        public List<QuizQuestionInput> Quiz = new();
        public HashSet<string> Competencies = new(StringComparer.Ordinal);
    }

    private ModuleInfo? _module;
    private List<ModuleTopicUsage> _usage = new();
    private ModuleCompetencyModel _model = new();
    private bool _compOpen;
    private string? _compMessage;
    private bool _compError;

    private void ToggleCompetency(string id, bool on)
    {
        if (_draft is null) return;
        if (on) _draft.Competencies.Add(id); else _draft.Competencies.Remove(id);
