    private void AddObjective() => _model.Objectives.Add(new LearningObjective { Id = "lz" + (_model.Objectives.Count + 1), Text = "" });
    private void AddCompetency() => _model.Competencies.Add(new Competency { Id = "k" + (_model.Competencies.Count + 1), Name = "", PassPercent = 60, MinQuestions = 1 });

    private async Task SaveCompetenciesAsync()
    {
        _compMessage = null; _compError = false;
        try
        {
            await CompetencySvc.SaveModelAsync(_userSub, ModuleId, _model);
            _model = await CompetencySvc.GetModelRawAsync(ModuleId);
            await LoadVersionsAsync();
            _compMessage = "Lernziele und Kompetenzen gespeichert (Entwurf; sie gelten für Nachweise ab der nächsten Modulversion).";
        }
        catch (Exception e) when (e is ArgumentException or KeyNotFoundException) { _compMessage = e.Message; _compError = true; }
    }

    private ModuleVersionOverview? _mv;
    private bool _versionBusy;
    private string? _versionMessage;

    private static string VersionTitle(ModuleVersionInfo v) =>
        v.PublishedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") + (v.Note.Length > 0 ? " · " + v.Note : "") + " · " + v.Cards + " Karten";

    private async Task LoadVersionsAsync()
    {
        try { _mv = _module is null ? null : await ModuleVersions.GetOverviewAsync(_userSub, _module.Id); }
        catch (KeyNotFoundException) { _mv = null; }
    }

    private async Task PublishModuleVersionAsync()
    {
        _versionBusy = true; _versionMessage = null;
        try
        {
            var v = await ModuleVersions.PublishAsync(_userSub, ModuleId);
            _versionMessage = $"Version {v.VersionNumber} veröffentlicht.";
        }
        catch (Exception e) when (e is InvalidOperationException or KeyNotFoundException) { _versionMessage = e.Message; }
        await LoadVersionsAsync();
        _versionBusy = false;
