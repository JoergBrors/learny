    private void AddSource() => _draft?.Sources.Add(new OfficialSource());
    private void RemoveSource(int i) => _draft?.Sources.RemoveAt(i);

    private static string ImageSrc(DraftImage img) => img.Data is null ? "/api/images/" + img.ImageId : $"data:{img.Mime};base64,{img.Data}";

    private async Task OnImagesSelected(InputFileChangeEventArgs e)
    {
        _imageError = null;
        if (_draft is null) return;
        foreach (var file in e.GetMultipleFiles(CardImageLimits.MaxImagesPerCard))
        {
            if (_draft.Images.Count >= CardImageLimits.MaxImagesPerCard) { _imageError = $"Höchstens {CardImageLimits.MaxImagesPerCard} Bilder pro Karte."; break; }
            if (file.Size > CardImageLimits.MaxDecodedBytes) { _imageError = $"„{file.Name}“ ist größer als 2 MiB."; continue; }
            try
            {
                await using var stream = file.OpenReadStream(CardImageLimits.MaxDecodedBytes + 1);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var candidate = new CardImage { MimeType = file.ContentType, DataBase64 = Convert.ToBase64String(ms.ToArray()), AltText = "", Caption = "" };
                var (ok, error) = CardImageValidator.ValidateAndNormalize(new List<CardImage> { candidate });   // dieselbe Prüfung wie beim Speichern (Typ, Signatur, Größe)
                if (!ok) { _imageError = $"„{file.Name}“: {error}"; continue; }
                _draft.Images.Add(new DraftImage { Mime = candidate.MimeType, Data = candidate.DataBase64, Alt = "", Caption = "" });
            }
            catch (IOException) { _imageError = $"„{file.Name}“ konnte nicht gelesen werden."; }
        }
    }

    private void MoveImage(int i, int delta)
    {
        if (_draft is null) return;
        var t = i + delta;
        if (t < 0 || t >= _draft.Images.Count) return;
        (_draft.Images[i], _draft.Images[t]) = (_draft.Images[t], _draft.Images[i]);
    }

    private void RemoveImage(int i) => _draft?.Images.RemoveAt(i);

    private void AddCardQuestion() => _draft?.Quiz.Add(new QuizQuestionInput { Type = QuizTypes.SingleChoice, Options = new() { "", "", "", "" }, CorrectIndexes = new() { 0 } });
    private void RemoveCardQuestion(int i) => _draft?.Quiz.RemoveAt(i);

    // ─── Fragenpool (Editor- und KI-Fragen): sofort gespeichert über QuizService/QuizPoolService ─────

    private void NewPoolQuestion()
    {
        _poolError = null; _poolEditId = null;
        _poolEdit = new QuizQuestionInput { CardId = _draft?.Id, Type = QuizTypes.SingleChoice, Options = new() { "", "", "", "" }, CorrectIndexes = new() { 0 } };
    }

    private Task EditPoolAsync(QuizPoolQuestion q)
    {
        _poolError = null; _poolEditId = q.Id;
        _poolEdit = QuizPoolService.ToInput(q);
        return Task.CompletedTask;
    }

    private void CancelPoolEdit() { _poolEdit = null; _poolEditId = null; _poolError = null; }

    private async Task SavePoolAsync()
    {
        if (_poolEdit is null || _draft?.Id is null) return;
        _poolError = null;
        _poolEdit.CardId = _draft.Id;
        try
        {
            if (_poolEditId is null) await Quiz.CreateQuestionAsync(ModuleId, _poolEdit, _userSub);
            else await Quiz.UpdateQuestionAsync(ModuleId, _poolEditId, _poolEdit, _userSub);
            await LoadPoolAsync();
            _status = "Frage im Fragenpool gespeichert.";
        }
        catch (Exception e) when (e is ArgumentException or InvalidOperationException or KeyNotFoundException or UnauthorizedAccessException) { _poolError = e.Message; }
    }

    private async Task TogglePoolActiveAsync(QuizPoolQuestion q)
    {
        try { await Quiz.SetQuestionActiveAsync(ModuleId, q.Id, !q.Active, _userSub); await LoadPoolAsync(); }
        catch (Exception e) when (e is KeyNotFoundException or UnauthorizedAccessException) { _poolError = e.Message; }
    }

    private static string TypeLabel(string type) => type switch { QuizTypes.SingleChoice => "Single Choice", QuizTypes.MultipleResponse => "Multiple Response", _ => "Freitext" };

    private static RenderFragment PreviewQuestion(QuizQuestionInput q) => builder =>
    {
        builder.AddContent(0, $"{q.Question} ({TypeLabel(q.Type)})");
        if (q.Type == QuizTypes.FreeText) { builder.OpenElement(1, "div"); builder.AddAttribute(2, "class", "muted"); builder.AddContent(3, "Musterlösung: " + q.Explanation); builder.CloseElement(); return; }
        builder.OpenElement(4, "ul");
        for (var i = 0; i < q.Options.Count; i++)
        {
            builder.OpenElement(5, "li");
            if (q.CorrectIndexes.Contains(i)) builder.AddAttribute(6, "class", "editor-correct");
            builder.AddContent(7, (q.CorrectIndexes.Contains(i) ? "✓ " : "") + q.Options[i]);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("lcRte.setBeforeUnload", false); } catch (Exception e) when (e is JSDisconnectedException or InvalidOperationException) { }
    }
