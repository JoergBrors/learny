    private static string UsageHref(ModuleTopicUsage u) => u.Versions.Count > 0 ? "/topics/" + u.TopicId + "?version=" + u.Versions.Max() : "/topics/" + u.TopicId + "/edit";
    private string _userSub = "";
    private bool _loading = true, _configOpen, _showArchived, _preview, _saving, _conflict, _quizPreviewOpen;
    private List<Card> _cards = new();
    private Draft? _draft;
    private string _baseline = "";
    private string? _error, _status, _imageError, _poolError;
    private List<QuizPoolQuestion> _poolQs = new();
    private QuizQuestionInput? _poolEdit;
    private string? _poolEditId;
    private bool _beforeUnloadSet;

    // ─── Laden ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userSub = auth.User.GetUserId() ?? throw new UnauthorizedAccessException();
        _module = await Repo.GetModuleAsync(ModuleId, _userSub);
        _usage = _module is null ? new() : (await TopicSvc.ListModuleUsageAsync(_userSub)).GetValueOrDefault(_module.Id) ?? new();   // nur eigene Module (Besitzprüfung in der SQL-Abfrage)
        await LoadVersionsAsync();
        _model = _module is null ? new() : await CompetencySvc.GetModelRawAsync(_module.Id);
        if (_module is not null)
        {
            await LoadCardsAsync();
            var first = !string.IsNullOrEmpty(CardParam) ? _cards.FirstOrDefault(c => c.Id == CardParam) : null;
            if (first is not null) await LoadDraftAsync(first.Id);
        }
        _loading = false;
    }

    private async Task LoadCardsAsync()
    {
        var active = await Repo.ListCardsAsync(_userSub, ModuleId, null, archived: false);
        var all = new List<Card>(active);
        if (_showArchived) all.AddRange(await Repo.ListCardsAsync(_userSub, ModuleId, null, archived: true));
        _cards = all;
    }

    private async Task LoadDraftAsync(string cardId)
    {
        var card = await Repo.GetCardAsync(cardId, _userSub);
        if (card is null) { _draft = null; return; }
        _draft = new Draft
        {
            Id = card.Id, UpdatedAt = card.UpdatedAt, Archived = card.Archived, Category = card.Category, Term = card.Term, Question = card.Question, Definition = card.Definition,
            HowItWorks = card.HowItWorks, Context = card.Context, KeyFact = card.KeyFact, ReferenceAnswer = card.ReferenceAnswer, ChatPrompt = card.ChatPrompt,
            SlideNumber = card.SlideNumber, TargetTimeSec = card.TargetTimeSec, SortOrder = card.SortOrder,
            Sources = card.OfficialSources.Select(s => new OfficialSource { Title = s.Title, Url = s.Url, Publisher = s.Publisher }).ToList(),
            Images = card.Images.OrderBy(i => i.SortOrder).Select(i => new DraftImage { ImageId = i.ImageId, Mime = i.MimeType, Alt = i.AltText, Caption = i.Caption }).ToList(),
            Quiz = card.Quiz.Select(q => QuizPoolService.FromCardQuiz(card.Id, q)).ToList(),
            Competencies = card.Competencies.ToHashSet(StringComparer.Ordinal),
        };
        await LoadPoolAsync();
        ResetBaseline();
    }

    private void NewDraft(string category = "")
    {
        _draft = new Draft { Category = category };
        _poolQs = new();
        _poolEdit = null; _poolEditId = null;
        ResetBaseline();
    }

    private async Task LoadPoolAsync()
    {
        _poolEdit = null; _poolEditId = null; _poolError = null;
        _poolQs = _draft?.Id is null ? new() : (await Quiz.ListQuestionsAsync(ModuleId, _userSub, _draft.Id))
            .Where(q => q.Source != QuizSources.CardJson).ToList();   // card_json-Fragen gehören dem Karten-JSON und werden oben mit der Karte bearbeitet
    }

    private void ResetBaseline() { _baseline = Snapshot(); _error = null; _status = null; _conflict = false; _imageError = null; }

    // ─── Ungespeicherte Änderungen ─────────────────────────────────────────

    private string Snapshot() => _draft is null ? "" : System.Text.Json.JsonSerializer.Serialize(new
    {
        _draft.Category, _draft.Term, _draft.Question, _draft.Definition, _draft.HowItWorks, _draft.Context, _draft.KeyFact, _draft.ReferenceAnswer, _draft.ChatPrompt,
        _draft.SlideNumber, _draft.TargetTimeSec,
        Sources = _draft.Sources.Select(s => new { s.Title, s.Url, s.Publisher }),
        Images = _draft.Images.Select(i => new { i.ImageId, i.Mime, i.Alt, i.Caption, New = i.Data is not null, Len = i.Data?.Length ?? 0 }),
        Quiz = _draft.Quiz,
        Competencies = _draft.Competencies.OrderBy(c => c, StringComparer.Ordinal),
    });

    private bool IsDirty => _draft is not null && Snapshot() != _baseline;

    private bool _overlayInit;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_preview && !_overlayInit)
        {
            _overlayInit = true;
            try { await JS.InvokeVoidAsync("lcRte.dragInit", "preview-overlay", "preview-overlay-head"); } catch (JSDisconnectedException) { }
        }
        else if (!_preview) _overlayInit = false;
        var dirty = !_loading && IsDirty;
        if (dirty != _beforeUnloadSet)
        {
            _beforeUnloadSet = dirty;
            try { await JS.InvokeVoidAsync("lcRte.setBeforeUnload", dirty); } catch (JSDisconnectedException) { }
        }
    }

    private async Task<bool> ConfirmDiscardAsync() =>
        !IsDirty || await JS.InvokeAsync<bool>("confirm", "Es gibt ungespeicherte Änderungen. Wirklich verwerfen?");

    private async Task OnBeforeNavigateAsync(LocationChangingContext context)
    {
        if (await JS.InvokeAsync<bool>("lcRte.wasConfirmed")) return;   // Linkklick wurde bereits bestätigt
        if (!await ConfirmDiscardAsync()) context.PreventNavigation();
    }

    private void Touch() => StateHasChanged();
    private void SetText(Action<Draft> set) { if (_draft is not null) set(_draft); StateHasChanged(); }

    // ─── Kartenliste ───────────────────────────────────────────────────────

    private async Task SelectAsync(string cardId)
    {
        if (_draft?.Id == cardId) return;
        if (!await ConfirmDiscardAsync()) return;
        await LoadDraftAsync(cardId);
    }

    private async Task NewCardAsync()
    {
        if (!await ConfirmDiscardAsync()) return;
        NewDraft(_draft?.Category ?? _cards.FirstOrDefault()?.Category ?? "");
    }

    private async Task ToggleArchivedAsync(ChangeEventArgs e)
    {
        _showArchived = e.Value is true;
        await LoadCardsAsync();
    }

    private async Task MoveAsync(string cardId, int delta)
    {
        // Reihenfolge gilt je Kategorie (Anzeige: Kategorie, dann sort_order) — vertauscht wird nur innerhalb der Kategorie
        var active = (await Repo.ListCardsAsync(_userSub, ModuleId, null, archived: false)).ToList();
        var card = active.FirstOrDefault(c => c.Id == cardId);
        if (card is null) return;
        var group = active.Where(c => c.Category == card.Category).ToList();
        var idx = group.FindIndex(c => c.Id == cardId);
        var target = idx + delta;
        if (target < 0 || target >= group.Count) return;
        (group[idx], group[target]) = (group[target], group[idx]);
        var ordered = new List<string>();
        foreach (var cat in active.Select(c => c.Category).Distinct())
            ordered.AddRange(cat == card.Category ? group.Select(c => c.Id) : active.Where(c => c.Category == cat).Select(c => c.Id));
        try { await Repo.ReorderCardsAsync(ModuleId, ordered, _userSub); await LoadCardsAsync(); if (_draft?.Id == cardId && !IsDirty) await LoadDraftAsync(cardId); }
        catch (Exception e) when (e is ArgumentException or KeyNotFoundException) { _error = e.Message; }
    }

    private async Task DuplicateAsync(string cardId)
    {
        if (!await ConfirmDiscardAsync()) return;
        var copy = await Repo.DuplicateCardAsync(cardId, _userSub);
        await LoadCardsAsync();
        if (copy is not null) { await LoadDraftAsync(copy.Id); _status = "Karte dupliziert."; }
    }

    private async Task ArchiveAsync(string cardId, bool archive)
    {
        if (_draft?.Id == cardId && !await ConfirmDiscardAsync()) return;
        await Repo.SetArchivedAsync(cardId, archive, _userSub);
        await LoadCardsAsync();
        if (_draft?.Id == cardId)
        {
            if (archive && !_showArchived) { _draft = null; _poolQs = new(); _baseline = ""; }
            else await LoadDraftAsync(cardId);
            _status = archive ? "Karte archiviert." : "Karte wiederhergestellt.";
        }
    }

    // ─── Speichern ─────────────────────────────────────────────────────────

    private static CardQuizQuestion ToCardQuiz(QuizQuestionInput i) => new()
    {
        Type = i.Type, Question = i.Question.Trim(), Explanation = i.Explanation.Trim(),
        Options = i.Type == QuizTypes.FreeText ? new() : i.Options.Select(o => o.Trim()).ToList(),
        CorrectIndex = i.Type == QuizTypes.SingleChoice ? i.CorrectIndexes.FirstOrDefault() : 0,
        CorrectIndexes = i.Type == QuizTypes.MultipleResponse ? i.CorrectIndexes.Distinct().OrderBy(x => x).ToList() : null,
    };

    private CardJson BuildJson() => new()
    {
        Module = _module!.Name, Category = _draft!.Category.Trim(), Term = _draft.Term.Trim(), Question = _draft.Question.Trim(),
        Definition = RichText.Normalize(_draft.Definition).Trim(), HowItWorks = RichText.Normalize(_draft.HowItWorks).Trim(), Context = RichText.Normalize(_draft.Context).Trim(),
        KeyFact = RichText.Normalize(_draft.KeyFact).Trim(), ReferenceAnswer = RichText.Normalize(_draft.ReferenceAnswer).Trim(), ChatPrompt = _draft.ChatPrompt.Trim(),
        SlideNumber = _draft.SlideNumber, TargetTimeSec = _draft.TargetTimeSec, SortOrder = _draft.SortOrder, Archived = _draft.Archived,
        OfficialSources = _draft.Sources.Where(s => !string.IsNullOrWhiteSpace(s.Title) || !string.IsNullOrWhiteSpace(s.Url))
            .Select(s => new OfficialSource { Title = s.Title.Trim(), Url = s.Url.Trim(), Publisher = (s.Publisher ?? "").Trim() }).ToList(),
        Quiz = _draft.Quiz.Select(ToCardQuiz).ToList(),
        Competencies = _draft.Competencies.OrderBy(c => c, StringComparer.Ordinal).ToList(),
        // Immer die vollständige Liste senden: vorhandene Bilder per image_id behalten (inkl. neuer Texte/Reihenfolge), neue mit Daten — so geht beim Speichern nichts verloren
        Images = _draft.Images.Select(i => i.Data is null
            ? new CardImage { ImageId = i.ImageId, MimeType = i.Mime, AltText = i.Alt, Caption = i.Caption }
            : new CardImage { MimeType = i.Mime, DataBase64 = i.Data, AltText = i.Alt, Caption = i.Caption }).ToList(),
    };

    private async Task SaveAsync()
    {
        if (_draft is null || _module is null) return;
        _saving = true; _error = null; _status = null; _conflict = false;
        try
        {
            var data = BuildJson();
            var (ok, error) = data.Validate();
            if (!ok) { _error = error; return; }
            Card? saved;
            if (_draft.Id is null) saved = await Repo.CreateCardAsync(data, _userSub);
            else saved = await Repo.UpdateCardAsync(_draft.Id, data, _userSub, _draft.UpdatedAt);
            if (saved is null) { _error = "Die Karte wurde nicht gefunden."; return; }
            await LoadCardsAsync();
            await LoadDraftAsync(saved.Id);
            _status = "Karte gespeichert.";
        }
        catch (CardRepository.CardConflictException e) { _error = e.Message; _conflict = true; }
        catch (ArgumentException e) { _error = e.Message; }
        catch (ImageStorageException e) { _error = "Bild konnte nicht gespeichert werden: " + e.Message; }
        finally { _saving = false; }
    }

    private async Task DiscardAsync()
    {
        if (_draft is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Alle ungespeicherten Änderungen an dieser Karte verwerfen?")) return;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        if (_draft?.Id is { } id) await LoadDraftAsync(id); else NewDraft();
        _status = "Änderungen verworfen.";
    }

