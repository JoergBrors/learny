@page "/verify"
@page "/verify/{Id}"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@layout Layout.MainLayout
@using System.Text.Json
@using LearnCards.Web.Api
@using System.Text.Json.Nodes
@inject CertificateService Certs
@inject PdfVerificationService PdfVerifier

<PageTitle>Zertifikat prüfen — LearnCards</PageTitle>

<div class="card panel" style="max-width:46rem;margin:1.5rem auto">
    <h1 class="panel-title">Zertifikat prüfen</h1>
    <p class="muted">Öffentliche Prüfung ohne Anmeldung. Angezeigt werden nur Status und Nachweisdaten, keine Angaben zu Lernenden oder privaten Modulen.</p>

    @if (!string.IsNullOrEmpty(Id))
    {
        @if (_status is null)
        {
            <p class="badge" role="alert">Kein Zertifikat mit dieser Kennung gefunden.</p>
        }
        else
        {
            var revoked = Str("status") == "revoked";
            <p class="@(revoked ? "badge" : "badge badge-pass")" role="status">@(revoked ? "✖ Widerrufen" : "✔ Gültig — von LearnCards ausgestellt")</p>
            <dl>
                <dt>Zertifikatsnummer</dt><dd>@Str("number")</dd>
                @if (Str("module_name") is { Length: > 0 } mn) { <dt>Modul</dt><dd>@mn @(Str("module_version") is { Length: > 0 } mv && mv != "0" ? $"(Version {mv})" : "")</dd> }
                <dt>Ausgestellt am</dt><dd>@(DateTime.TryParse(Str("issued_at"), out var d) ? d.ToLocalTime().ToString("dd.MM.yyyy") : "")</dd>
                @if (revoked) { <dt>Widerrufen</dt><dd>@Str("revoked_reason")</dd> }
                <dt>Blockchain</dt><dd>@(_status["chain"]?["label"]?.GetValue<string>())@(_status["chain"]?["network_label"] is { } nl && _status["chain"]?["status"]?.GetValue<string>() == "confirmed" ? $" · {nl.GetValue<string>()}" : "")</dd>
                @if (_status["chain"]?["explorer_url"]?.GetValue<string>() is { Length: > 0 } ex && ex.StartsWith("https://")) { <dt>Transaktion</dt><dd><a href="@ex" rel="noopener noreferrer" target="_blank">Im Explorer ansehen</a></dd> }
                <dt>Prüfsumme (SHA-256)</dt><dd style="word-break:break-all"><code>@Str("badge_hash")</code></dd>
            </dl>
            <img src="/brand/learny-verified.svg" alt="Learny Verified – Digitally Signed Credential" height="40" />
            <LiveVerification CertId="@Id" />
            @if (_evidence is { } ev)
            {
                <h2 class="panel-title">Nachweise und Kompetenzen</h2>
                <p class="muted">Vom Inhaber freigegebener Prüfungsnachweis (@(Ev("format") == "learny-topic-completion-snapshot" ? "Themenabschluss" : "Modulabschluss")). Er enthält weder Antworten noch Lerninhalte noch Angaben zur Person.</p>
                @if (Ev("module.name") is { Length: > 0 } mname) { <p><strong>@mname</strong> @(Ev("module.version") is { Length: > 0 } mv2 && mv2 != "0" ? $"(Version {mv2})" : "") · Ergebnis @Ev("result.percent") % · Bestehensgrenze @Ev("exam.pass_percent") %</p> }
                @if (Ev("topic.name") is { Length: > 0 } tname) { <p><strong>@tname</strong> (Version @Ev("topic.version")) · Abschluss @Ev("completed_at")</p> }
                @foreach (var k in (ev["competencies"]?.AsArray() ?? new JsonArray()))
                {
                    <p style="margin:.2rem 0">@(k?["status"]?.ToString() == "demonstrated" ? "✔" : "—") <strong>@k?["name"]</strong> – @(k?["status"]?.ToString() switch { "demonstrated" => "nachgewiesen", "not_demonstrated" => "nicht nachgewiesen", _ => "nicht ausreichend geprüft" }) (@k?["percent"] %, @k?["questions_asked"] Fragen)</p>
                }
                @if (ev["modules"]?.AsArray() is { Count: > 0 } mods)
                {
                    <table class="table" aria-label="Module">
                        <thead><tr><th scope="col">Modul</th><th scope="col">Version</th><th scope="col">Ergebnis</th><th scope="col">Nachgewiesene Kompetenzen</th></tr></thead>
                        <tbody>
                        @foreach (var m in mods)
                        {
                            <tr><td>@m?["name"]</td><td>@m?["version"]</td><td>@(m?["percent"] is { } p ? $"{p} %" : "–")</td>
                                <td>@string.Join(", ", (m?["competencies"]?.AsArray() ?? new JsonArray()).Where(k => k?["status"]?.ToString() == "demonstrated").Select(k => k!["name"]!.ToString()))</td></tr>
                        }
                        </tbody>
                    </table>
                }
                <p class="muted" style="word-break:break-all">Snapshot-Hash (SHA-256): <code>@Str("snapshot_hash")</code> · Nachweis: <a href="/api/public/certificates/@Id/evidence">JSON</a></p>
            }
        }
    }

    <h2 class="panel-title">Badge-Datei prüfen</h2>
    <p class="muted">Füge den Inhalt einer heruntergeladenen Badge-Datei (JSON oder JWT) ein. Die Signatur wird mit dem Schlüssel dieser Installation geprüft.</p>
    <textarea class="input" rows="6" style="width:100%" @bind="_input" @bind:event="oninput" aria-label="Badge-Inhalt" maxlength="20000"></textarea>
    <p><button class="btn btn-primary" @onclick="CheckAsync" disabled="@string.IsNullOrWhiteSpace(_input)">Prüfen</button></p>
    @if (_result is { } v)
    {
        <p class="@(v.Valid ? "badge badge-pass" : "badge")" role="status">@(v.Valid ? "✔ Signatur gültig, Aussteller bestätigt" : "✖ Nicht gültig")</p>
        <ul>
            <li>Signatur: @(v.SignatureValid ? "gültig" : v.SignatureError ?? "ungültig")</li>
            <li>Inhalt unverändert: @(v.ContentMatches is null ? "nicht geprüft" : v.ContentMatches == true ? "ja" : "nein")</li>
            <li>Zertifikat bekannt: @(v.Known ? "ja" : "nein")@(v.Revoked ? " — widerrufen" : "")</li>
        </ul>
    }

    <h2 class="panel-title">Zertifikat-PDF prüfen</h2>
    <p class="muted">Lade ein von LearnCards ausgestelltes Zertifikats-PDF hoch (höchstens 25 MB). Geprüft werden die PDF-Signatur, ob die Datei seit der Signierung unverändert ist, die eingebetteten Credentials (CLR, Master-Badge, Modulnachweise), Referenzen und Hashes, Versionen und der aktuelle Widerrufsstatus — getrennt ausgewiesen. Die Datei wird nur im Speicher verarbeitet und nicht gespeichert.</p>
    <InputFile OnChange="CheckPdfAsync" accept="application/pdf,.pdf" aria-label="Zertifikats-PDF auswählen" />
    @if (_pdfBusy) { <p class="muted" role="status">Wird geprüft …</p> }
    @if (_pdfError is not null) { <p class="badge" role="alert">@_pdfError</p> }
    @if (_pdf is { } r)
    {
        <p class="@(Flag(r, "overall.valid") ? "badge badge-pass" : "badge")" role="status">@(Flag(r, "overall.valid") ? "✔ " : "✖ ")@Txt(r, "overall.summary")</p>
        <table class="table" aria-label="Prüfergebnis">
            <thead><tr><th scope="col">Prüfpunkt</th><th scope="col">Ergebnis</th></tr></thead>
            <tbody>
                <tr><td>1. PDF-Signatur gültig</td><td>@Mark(Flag(r, "pdf.signature_valid"))@(Flag(r, "pdf.signature_present") ? "" : " – keine Signatur vorhanden") @Txt(r, "pdf.signature_error")</td></tr>
                <tr><td>2. Datei seit der Signierung unverändert (inkl. Anhänge)</td><td>@Mark(Flag(r, "pdf.document_unchanged"))</td></tr>
                <tr><td>3. Eingebettetes CLR gültig</td><td>@Mark(Flag(r, "credentials.clr.valid"))@(Flag(r, "credentials.clr.present") || Txt(r, "credentials.clr.id").Length > 0 ? "" : " – nicht enthalten")</td></tr>
                <tr><td>4. Master-Badge gültig</td><td>@Mark(Flag(r, "credentials.master_badge.valid"))</td></tr>
                <tr><td>5. Modul-Credentials gültig</td><td>@Mark(ModulesOk(r))@ModulesText(r)</td></tr>
                <tr><td>6. Referenzen und Hashes stimmen überein</td><td>@Mark(Flag(r, "references.all_ok") && Flag(r, "attachments.hashes_match"))</td></tr>
                <tr><td>7. Aussteller / PDF-Unterzeichner</td><td>@(TrustText(Txt(r, "overall.signer_trust"))); Credentials @(Flag(r, "issuer.credentials_signed_by_this_installation") ? "mit dem Schlüssel dieser Installation signiert" : "nicht bestätigt")</td></tr>
                <tr><td>8. Widerruf</td><td>@(Flag(r, "revocation.any_revoked") ? "✖ widerrufen" : "✔ nicht widerrufen (Online-Abfrage)")</td></tr>
                <tr><td>9. Versionen stimmen überein</td><td>@Mark(Flag(r, "versions.match"))</td></tr>
            </tbody>
        </table>
        @if (r["pdf"]?["pki"] is { } pk)
        {
            <table class="table" aria-label="Learny-PKI">
                <thead><tr><th scope="col">Learny-PKI</th><th scope="col">Ergebnis</th></tr></thead>
                <tbody>
                    <tr><td>Kryptografisch gültig</td><td>@Mark(Flag(pk, "cryptographically_valid"))</td></tr>
                    <tr><td>Kette bis zum Learny-Vertrauensanker, Zertifikatsprofil</td><td>@Mark(Flag(pk, "chain_valid") && Flag(pk, "profile_ok"))</td></tr>
                    <tr><td>Aussteller durch die Learny-PKI bestätigt</td><td>@Mark(Flag(pk, "issuer_confirmed"))</td></tr>
                    <tr><td>Widerrufsprüfung (Register + CRL)</td><td>@(Txt(pk, "revocation") switch { "good" => "✔ nicht widerrufen, CRL aktuell", "revoked" => "✖ widerrufen (" + Txt(pk, "revocation_reason") + ")", _ => "⚠ unbekannt (CRL nicht aktuell oder nicht verfügbar)" })</td></tr>
                    <tr><td>Öffentlich vertrauenswürdige CA</td><td>✖ nein – die Learny-PKI wird nicht automatisch von Adobe, Betriebssystemen oder Vertrauenslisten anerkannt</td></tr>
                </tbody>
            </table>
        }
        @if (r["integrity_manifest"] is { } im)
        {
            <table class="table" aria-label="Integritätsmanifest und Zeitnachweis">
                <thead><tr><th scope="col">Integritätsmanifest (getrennt bewertet)</th><th scope="col">Ergebnis</th></tr></thead>
                <tbody>
                    <tr><td>Manifest vorhanden / gültig</td><td>@(Txt(im, "status") switch { "valid" => "✔ gültig", "absent" => "– nicht vorhanden (älteres Paket)", _ => "✖ ungültig" })</td></tr>
                    <tr><td>Manifest-JWS (ES256) und Nutzlast = Manifestbytes</td><td>@(im["jws"] is { } mj ? Mark(Flag(mj, "signature_valid") && Flag(mj, "payload_matches_manifest")) : "–")</td></tr>
                    <tr><td>Ausstellerschlüssel</td><td>@(Txt(im, "issuer_key.trust") switch { "installation" => "✔ entspricht dem Schlüssel dieser Installation", "unconfirmed" => "⚠ mathematisch gültig, Aussteller nicht bestätigt (fremder oder unbekannter Schlüssel)", "invalid" => "✖ ungültig", _ => "–" })</td></tr>
                    <tr><td>Alle Nutzdateien geschützt, keine zusätzlichen Anhänge</td><td>@(Txt(im, "status") == "absent" ? "–" : Mark(Flag(im, "files.hashes_match") && (At(im, "files.unlisted_attachments") as JsonArray)?.Count == 0))</td></tr>
                </tbody>
            </table>
            @if (At(im, "problems") is JsonArray ip && ip.Count > 0) { <ul class="muted">@foreach (var pr in ip) { <li>@pr?.ToString()</li> }</ul> }
        }
        @if (r["timestamp"] is { } ts)
        {
            <section aria-label="Unabhängiger Blockchain-Zeitnachweis">
                <h3>Unabhängiger Blockchain-Zeitnachweis</h3>
                <table class="table">
                    <tbody>
                        <tr><td>Protokoll / Blockchain / Hash</td><td>OpenTimestamps · Bitcoin · SHA-256</td></tr>
                        <tr><td>SHA-256 des signierten Integritätsmanifests (integrity-manifest.jws)</td><td><code>@(Txt(ts, "jws_sha256").Length > 0 ? Txt(ts, "jws_sha256") : Txt(r, "integrity_manifest.jws.sha256"))</code></td></tr>
                        <tr><td>Status</td><td>@(Txt(ts, "state") switch { "pending" => "Ausstehend", "anchored" => "Verankert", "confirmed" => "Bestätigt", "failed" => "Ungültig", "unverifiable" => "Nicht überprüfbar", _ => "Kein Zeitnachweis" }) – @Txt(ts, "note")</td></tr>
                        @if (Txt(ts, "bitcoin_height").Length > 0) { <tr><td>Blockhöhe / Blockzeit / Bestätigungstiefe</td><td>@Txt(ts, "bitcoin_height") · @Txt(ts, "bitcoin_block_time") · @Txt(ts, "confirmations") (Quelle: @Txt(ts, "bitcoin_source")) – @(Flag(ts, "independent") ? "unabhängig geprüft (eigener Bitcoin-Knoten)" : "nicht vollständig unabhängig: Kettenzugehörigkeit/Tiefe beruhen auf der genannten Quelle")</td></tr> }
                        <tr><td>OTS-Nachweisdatei</td><td>@(Flag(ts, "present") ? "integrity-manifest.jws.ots (eingebettet)" : "nicht eingebettet")</td></tr>
                        <tr><td>Prüfanleitung</td><td><a href="https://github.com/opentimestamps/opentimestamps-client" rel="noopener noreferrer">OpenTimestamps-Client</a> · Anleitung: docs/pdf-signature.md, Abschnitt „Langzeitverifikation“</td></tr>
                    </tbody>
                </table>
                <p class="muted">Der Blockchain-Zeitnachweis bestätigt die Existenz der kryptografisch gebundenen Daten spätestens zum nachgewiesenen Bitcoin-Zeitpunkt. Er bestätigt weder die Identität des Ausstellers noch die inhaltliche Richtigkeit des Lernnachweises.</p>
            </section>
        }
        @if (r["pdf"]?["signer"] is { } sg)
        {
            <p class="muted">Unterzeichner: @Txt(sg, "subject") · gültig @Txt(sg, "not_before")[..10] bis @Txt(sg, "not_after")[..10] · Fingerabdruck <code>@Txt(sg, "thumbprint")</code>@(Txt(r, "pdf.signing_time") is { Length: > 0 } st ? " · signiert " + st : "")</p>
        }
        <details><summary>Eingebettete Dateien (@Txt(r, "attachments.count"))</summary>
            <ul>@foreach (var f in r["attachments"]?["files"]?.AsArray() ?? new JsonArray()) { <li><code>@Txt(f, "name")</code> – @(Flag(f, "matches") ? "Prüfsumme stimmt" : "Prüfsumme weicht ab") <span class="muted">(@Txt(f, "sha256"))</span></li> }</ul>
        </details>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    private JsonNode? _status;
    private JsonNode? _evidence;

    private string Ev(string path) { JsonNode? n = _evidence; foreach (var p in path.Split('.')) n = (n as JsonObject)?[p]; return n?.ToString() ?? ""; }
    private string _input = "";
    private BadgeVerification? _result;

    private string Str(string key) => _status?[key]?.ToString() ?? "";

    protected override async Task OnParametersSetAsync()
    {
        _status = null;
        if (!string.IsNullOrEmpty(Id) && await Certs.GetPublicStatusAsync(Id) is { } s)
            _status = JsonSerializer.SerializeToNode(s, AppJson.Options);
        _evidence = !string.IsNullOrEmpty(Id) && _status is not null && await Certs.GetPublicEvidenceJsonAsync(Id) is { } evJson ? JsonNode.Parse(evJson) : null;
    }

    private JsonNode? _pdf;
    private bool _pdfBusy;
    private string? _pdfError;

    private static JsonNode? At(JsonNode? n, string path) { foreach (var p in path.Split('.')) n = n is JsonArray a ? (int.TryParse(p, out var i) && i < a.Count ? a[i] : null) : (n as JsonObject)?[p]; return n; }
    private static bool Flag(JsonNode? n, string path) => At(n, path)?.ToString() == "true" || At(n, path)?.ToString() == "True";
    private static string Txt(JsonNode? n, string path) => (At(n, path)?.ToString() ?? "").Trim('"');
    private static string TrustText(string t) => t switch { "learny_pki" => "✔ Zertifikat der Learny-PKI (Vertrauensanker aus dem Register dieser Installation)", "installation" => "✔ Unterzeichner ist diese Installation", "trusted_ca" => "✔ Zertifikat einer anerkannten Zertifizierungsstelle", "untrusted" => "⚠ Unterzeichner nicht vertrauenswürdig bestätigt (selbstsigniert/unbekannt)", _ => "✖ kein Unterzeichner" };
    private static string Mark(bool ok) => ok ? "✔ ja" : "✖ nein";
    private static bool ModulesOk(JsonNode r) => r["credentials"]?["modules"] is JsonArray m ? m.Count > 0 && m.All(x => Flag(x, "valid")) : Flag(r, "credentials.module_credential.valid");
    private static string ModulesText(JsonNode r) => r["credentials"]?["modules"] is JsonArray m ? $" ({m.Count(x => Flag(x, "valid"))} von {m.Count})" : "";

    private async Task CheckPdfAsync(InputFileChangeEventArgs e)
    {
        _pdf = null; _pdfError = null; _pdfBusy = true;
        try
        {
            using var ms = new MemoryStream();
            await e.File.OpenReadStream(PdfVerificationService.MaxPdfBytes).CopyToAsync(ms);
            _pdf = await PdfVerifier.VerifyAsync(ms.ToArray());
        }
        catch (IOException) { _pdfError = "Die Datei ist zu groß oder nicht lesbar (höchstens 25 MB)."; }
        finally { _pdfBusy = false; }
    }

    private async Task CheckAsync() => _result = await Certs.VerifyAsync(_input.Length > 20000 ? _input[..20000] : _input);
}
