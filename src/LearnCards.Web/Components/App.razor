<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <title>LearnCards</title>
    <link rel="icon" type="image/svg+xml" href="/brand/learny-verified-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#7C3AED" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet />
    <script>
        // Darstellung früh setzen, um Flackern zu vermeiden: gespeicherter Modus (system | light | dark), Standard „system“ = folgt dem Gerät
        (function () {
            var root = document.documentElement, mq = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null, mode = 'system';
            try { var v = localStorage.getItem('lc-theme'); if (v === 'light' || v === 'dark' || v === 'system') mode = v; } catch (e) { }
            root.dataset.themeMode = mode;
            root.dataset.theme = mode === 'system' ? (mq && mq.matches ? 'dark' : 'light') : mode;
        })();
    </script>
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["cards.js"]"></script>
    <script src="@Assets["rte.js"]"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
