<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <!-- Zusatzschutz (ADR 0009): Geheimnisse und Datenverzeichnisse sind nie per HTTP abrufbar, auch wenn sie versehentlich im Webroot liegen. -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".pem" allowed="false" />
          <add fileExtension=".key" allowed="false" />
          <add fileExtension=".initialized" allowed="false" />
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="data" />
          <add segment="logs" />
          <add segment="keys" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <aspNetCore processPath="dotnet"
                arguments=".\LearnCards.Web.dll"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess" />
  </system.webServer>
</configuration>
