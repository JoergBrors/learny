+	/** Copy of the CLR with each embedded Compact JWS replaced by a minimal stub credential, for the JSON schema step only. */
+	private static VerifiableCredential withEmbeddedJwsStubs(VerifiableCredential clr, VerifiableCredential.Builder builder, Resource resource) {
+		JsonNode copy = clr.getJson().deepCopy();
+		JsonNode subject = copy.path("credentialSubject");
+		if (subject instanceof ObjectNode) {
+			JsonNode vcs = subject.path("verifiableCredential");
+			if (vcs.isTextual()) {
+				((ObjectNode) subject).set("verifiableCredential", stubCredential());
+			} else if (vcs.isArray()) {
+				ArrayNode array = (ArrayNode) vcs;
+				for (int i = 0; i < array.size(); i++) {
+					if (array.get(i).isTextual()) array.set(i, stubCredential());
+				}
+			}
+		}
+		return builder.resource(resource).jsonData(copy).jwt(clr.getJwt().orElse(null)).build();
+	}
+
+	private static ObjectNode stubCredential() {
+		ObjectNode stub = JsonNodeFactory.instance.objectNode();
+		stub.putArray("@context").add("https://www.w3.org/ns/credentials/v2").add("https://purl.imsglobal.org/spec/ob/v3p0/context-3.0.3.json");
+		stub.putArray("type").add("VerifiableCredential").add("OpenBadgeCredential");
+		stub.putObject("issuer").put("id", "urn:learny:embedded-jws-stub");
+		stub.put("validFrom", "2000-01-01T00:00:00Z");
+		stub.putObject("credentialSubject").put("id", "urn:learny:embedded-jws-stub");
+		return stub;
+	}
