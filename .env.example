# ──────────────────────────────────────────────────────────
# LearnCards — Environment Configuration (.NET 10)
# Kopiere diese Datei zu .env und trage deine Werte ein.
# NIEMALS .env committen.
# ──────────────────────────────────────────────────────────

# ─── App ──────────────────────────────────────────────────
APP_DOMAIN=learncards.yourdomain.com
SECRET_KEY=replace-with-64-char-random-string
DEBUG=false

# ─── Datenbank ────────────────────────────────────────────
# auto = SQLite lokal ohne POSTGRES_HOST, sonst automatisch PostgreSQL.
DB_PROVIDER=auto
SQLITE_PATH=data/learncards.db

# Alternativ zu den POSTGRES_*-Einzelwerten: eine Verbindungs-URL (postgres://user:pass@host:5432/db?sslmode=require); die Einzelwerte überschreiben sie.
# DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=learncards
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=learncards
# disable | prefer | require  (Azure Database for PostgreSQL benötigt "require")
POSTGRES_SSLMODE=prefer

# ─── Authentifizierung ──────────────────────────────────────
# auto = "oidc" sobald OIDC_ISSUER/OIDC_CLIENT_ID gesetzt sind, sonst lokaler "dev"-Login.
AUTH_MODE=auto

# ─── OpenID Connect — Entra ID (Azure AD) ─────────────────
# Siehe README.md / docs/local-development.md für die Schritt-für-Schritt-Anleitung.
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
OIDC_CLIENT_ID=YOUR_APPLICATION_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_CLIENT_SECRET
OIDC_AUDIENCE=YOUR_APPLICATION_CLIENT_ID
OIDC_WEB_SCOPE=openid profile email api://YOUR_APPLICATION_CLIENT_ID/access_as_user

# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Benutzer & Rollen (ADR 0011) ──────────────────────────
# IdP-Subjects (OIDC "sub", kommagetrennt), die beim Login die Rolle "admin" erhalten.
# Im Dev-Modus ist der Standardbenutzer "local-dev-user" automatisch Admin. Keine E-Mail-Adressen verwenden.
ADMIN_SUBJECTS=
# Entra-ID-App-Rollen (Claim "roles") → interne Rollen, bei jedem Login abgeglichen (ADR 0012). Standard: Admin.All=admin
# OIDC_ROLE_MAP=Admin.All=admin,Auditor=auditor,Themen.Admin=themen_admin   # interne Rollen: admin, auditor, themen_admin

# ─── MCP-Server-API-Key ───────────────────────────────────
MCP_API_KEY=replace-with-strong-mcp-api-key
# Der Key ist nur ein Dienstschlüssel des MCP-Servers (Code-Tausch, Schema) und gewährt KEINEN Datenzugriff.
# Benutzer melden sich per OAuth am MCP-Server an oder erzeugen ein persönliches Token unter /profile (ADR 0013).
# Öffentliche Basis-URL(en) des MCP-Servers (kommagetrennt); nur Rückleitungen auf <URL>/oauth/callback sind erlaubt.
# Im Dev-Modus (AUTH_MODE=dev) ist http://127.0.0.1:8787 voreingestellt, mit OIDC muss der Wert gesetzt werden.
MCP_PUBLIC_URL=http://127.0.0.1:8787
# Gültigkeit benutzergebundener MCP-Tokens aus der OAuth-Anmeldung in Tagen (1-365)
MCP_TOKEN_DAYS=30
# PFLICHT außerhalb von Development (ADR 0025): Hauptschlüssel für MCP-Tokens, Einmal-Codes und OAuth-Clients in der Datenbank (Base64, mindestens 32 Byte).
# Erzeugen: openssl rand -base64 32. Nur hier/in der Geheimnisverwaltung ablegen — nie in der Datenbank oder deren Sicherungen. Verlust = alle MCP-Zugänge ungültig (Neuanmeldung).
# In Development (dotnet run) wird ohne Angabe einmalig data/mcp-token.key erzeugt.
MCP_TOKEN_KEY=
# Nach einer Schlüsselrotation: bisherige Schlüssel (kommagetrennt), nur zum Prüfen/Entschlüsseln. Standard: leer.
# MCP_TOKEN_KEY_PREVIOUS=
# Ende der Übergangsfrist für ältere MCP-Tokens (reiner SHA-256, vor ADR 0025): danach Neuanmeldung. ISO-Datum. Standard: 2027-01-31
# MCP_LEGACY_TOKEN_UNTIL=2027-01-31
LEARNCARDS_API_URL=http://localhost:5000/api

# ─── Bildspeicher (ADR 0017/0018) ──────────────────────────
# Provider für NEUE Bilder: database (Standard) | local | azureblob | s3 | sharepoint. Ein Wechsel migriert nichts automatisch (Admin-Migration unter /admin).
IMAGE_STORAGE_PROVIDER=database
# local: Verzeichnis (im Container auf einem persistenten Volume, Standard data/images)
# IMAGE_LOCAL_PATH=data/images
# Notausschalter für den Bild-Proxy GET /api/images/{id}
# IMAGE_PROXY_ENABLED=true
# IMAGE_HTTP_TIMEOUT_SECONDS=30
# Bild-Cache (nur entfernte Provider). Dateicache: IMAGE_CACHE_PATH (bei SharePoint Standard data/image-cache)
# IMAGE_CACHE_ENABLED=true
# IMAGE_CACHE_MAX_SIZE_MB=512
# IMAGE_CACHE_TTL_MINUTES=1440
# IMAGE_CACHE_MEMORY_MB=64
# IMAGE_CACHE_PATH=
# azureblob — in Produktion Managed Identity (Rollen: Storage Blob Data Contributor + Storage Blob Delegator); Lesen nur über Lese-SAS pro Blob
# IMAGE_AZUREBLOB_ACCOUNT=mystorageaccount
# IMAGE_AZUREBLOB_CONTAINER=learncards-images
# Auth: managedidentity | clientsecret | sharedkey (nur Entwicklung)
# IMAGE_AZUREBLOB_AUTH=managedidentity
# optional: Client-ID einer benutzerzugewiesenen Identität
# IMAGE_AZUREBLOB_CLIENT_ID=
# nur bei clientsecret:
# IMAGE_AZUREBLOB_TENANT_ID=
# IMAGE_AZUREBLOB_CLIENT_SECRET=
# Lebensdauer der Lese-SAS in Sekunden (10–600)
# IMAGE_AZURE_SAS_TTL_SECONDS=60
# Entwicklung gegen Azurite:
# IMAGE_AZUREBLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
# IMAGE_AZUREBLOB_ACCOUNT=devstoreaccount1
# IMAGE_AZUREBLOB_AUTH=sharedkey
# IMAGE_AZUREBLOB_ACCOUNT_KEY=<Azurite-Entwicklungsschlüssel>
# IMAGE_AZUREBLOB_ALLOW_HTTP=true
# IMAGE_AZUREBLOB_ALLOW_PRIVATE_NETWORK=true
# s3 (AWS oder kompatibel) — Zugangsdaten nur aus der Umgebung/Secret-Verwaltung
# IMAGE_S3_BUCKET=
# IMAGE_S3_REGION=eu-central-1
# IMAGE_S3_ACCESS_KEY_ID=
# IMAGE_S3_SECRET_ACCESS_KEY=
# IMAGE_S3_ENDPOINT=https://minio.example.com
# IMAGE_S3_PATH_STYLE=true
# IMAGE_S3_PRESIGN_TTL_SECONDS=60
# sharepoint (Microsoft Graph, App-only, Berechtigung Sites.Selected)
# IMAGE_SHAREPOINT_TENANT_ID=
# IMAGE_SHAREPOINT_CLIENT_ID=
# IMAGE_SHAREPOINT_CLIENT_SECRET=
# IMAGE_SHAREPOINT_SITE_ID=
# IMAGE_SHAREPOINT_DRIVE_ID=
# IMAGE_SHAREPOINT_FOLDER=LearnCards/images
# Private Endpoints/lokale Dienste ausdrücklich erlauben (sonst nur öffentliche Adressen): IMAGE_AZUREBLOB_ALLOW_PRIVATE_NETWORK, IMAGE_S3_ALLOW_PRIVATE_NETWORK, IMAGE_SHAREPOINT_ALLOW_PRIVATE_NETWORK

# ─── Zertifikate, Open Badges und Blockchain-Verankerung (ADR 0021/0022) ───
# Signaturschlüssel der Badges (ES256, PKCS#8-PEM). Produktion: aus Secret-Verwaltung/Key Vault setzen. Entwicklung: leer = Schlüsseldatei data/badge-signing-key.pem wird erzeugt.
# BADGE_SIGNING_KEY_PEM=
# BADGE_SIGNING_KEY_FILE=
# ─── Eigene Learny-PKI (ADR 0035) ───
# Beim ersten Start wird die PKI einmalig automatisch eingerichtet (Root CA → Issuing CA → PDF-Signaturzertifikat, CRL), sofern PKI_PUBLIC_URL (oder PUBLIC_BASE_URL) gesetzt ist
# bzw. in Development (lokale Adresse). Nie bei späteren Starts. Schlüssel: passwortgeschützte PKCS#12-Dateien in PKI_KEY_DIR (Standard data/pki), nie in der Datenbank.
# PDF_SIGNING_CERT_* (unten) hat Vorrang vor der PKI. Keine automatische öffentliche Anerkennung (Adobe/Betriebssysteme). Siehe docs/pki.md.
# PKI_PUBLIC_URL=https://learny.example.org
# PKI_AUTO_INIT=true
# PKI_KEY_DIR=data/pki
# PKI_KEY_PASSWORD=            (mind. 16 Zeichen; leer = beim Erststart erzeugt und neben den Schlüsseln abgelegt)
# PKI_ROOT_PASSPHRASE=         (mind. 16 Zeichen; Root-Schlüssel offline sichern und vom Server entfernen)
# PKI_KEY_ALGORITHM=rsa        (rsa | ecdsa)
# PKI_ORGANIZATION=Learny
# PKI_ROOT_VALIDITY_YEARS=20  PKI_ISSUING_VALIDITY_YEARS=10  PKI_SIGNING_VALIDITY_DAYS=730
# PKI_CRL_VALIDITY_DAYS=7  PKI_ROOT_CRL_VALIDITY_DAYS=365  PKI_CRL_RENEW_BEFORE_HOURS=48  PKI_EXPIRY_WARNING_DAYS=60
# PKI_TRUSTED_ROOT_SHA256=     (optionaler Vertrauensanker-Pin, SHA-256 der Root CA)
# ─── Signierte Zertifikats-PDFs (ADR 0033) ───
# Eigenes Signaturzertifikat (X.509, RSA oder ECDSA) für die PDF-Signatur — unabhängig vom Badge-Schlüssel. Ohne Zertifikat werden KEINE PDFs ausgeliefert (503);
# in Entwicklung (ASPNETCORE_ENVIRONMENT=Development) wird ersatzweise ein selbstsigniertes Zertifikat in data/pdf-signing-dev.pfx erzeugt (nicht vertrauenswürdig).
# Eine für Dritte vertrauenswürdige Signatur braucht ein Zertifikat einer anerkannten Zertifizierungsstelle (docs/pdf-signature.md). Privater Schlüssel nie einchecken.
# Variante A: PKCS#12 (.pfx/.p12) per Datei (Pfad) ...
# PDF_SIGNING_CERT_FILE=/run/secrets/learny-pdf-signing.pfx
# PDF_SIGNING_CERT_PASSWORD=
# Variante B: ... oder als Base64 (Secret-Verwaltung):  base64 -w0 signer.pfx
# PDF_SIGNING_CERT_PFX_BASE64=
# Variante C: PEM (Zertifikat samt Kette und privater Schlüssel, jeweils Text oder Dateipfad)
# PDF_SIGNING_CERT_PEM=
# PDF_SIGNING_KEY_PEM=
# Angaben in der Signatur (optional)
# PDF_SIGNING_NAME=Learny Verified
# PDF_SIGNING_REASON=Learny Verified – Digitally Signed Credential
# PDF_SIGNING_LOCATION=
# PDF_SIGNING_CONTACT=
# Entwicklungszertifikat erzwingen (true) bzw. verbieten (false); Standard: nur in Development
# PDF_SIGNING_DEV_CERT=

# Öffentliche Basis-URL (Aussteller-ID, Verifikationslinks, Widerrufsliste). In Entwicklung leer = tatsächliche Adresse (z. B. http://localhost:5000); für Test/Produktion setzen.
# Öffentlich erreichbar (ohne Anmeldung) sind nur /badges/issuer, /.well-known/jwks.json und /api/public/*; alle übrigen /api-Endpunkte verlangen Anmeldung.
# PUBLIC_BASE_URL=https://learny.example.org
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=polygon-amoy
BLOCKCHAIN_AUTO_ANCHOR=true
# Harte Obergrenze je Nachweis: höchstens 0.001 EUR (höhere Werte sind ungültig)
BLOCKCHAIN_MAX_COST_EUR=0.001
# Mainnet braucht zusätzlich BLOCKCHAIN_NETWORK=polygon-mainnet UND die ausdrückliche Freigabe durch einen Administrator
BLOCKCHAIN_MAINNET_ENABLED=false
BLOCKCHAIN_BATCH_ENABLED=true
BLOCKCHAIN_BATCH_MAX_SIZE=100
BLOCKCHAIN_BATCH_MAX_WAIT_MINUTES=60
# BLOCKCHAIN_RPC_URL_AMOY=https://rpc-amoy.polygon.technology
# BLOCKCHAIN_RPC_URL_MAINNET=https://polygon-rpc.com
# Öffentliche Wallet-Adresse (kein Geheimnis). Der private Schlüssel gehört NICHT in diese Datei.
# BLOCKCHAIN_WALLET_ADDRESS=0x...
# BLOCKCHAIN_CONFIRMATIONS=30
# BLOCKCHAIN_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=polygon-ecosystem-token&vs_currencies=eur
# BLOCKCHAIN_PRICE_JSON_PATH=polygon-ecosystem-token.eur
# BLOCKCHAIN_PRICE_MAX_AGE_MINUTES=15
# Lokale Simulation ohne Blockchain (nur Entwicklung; Anzeige „simuliert“)
# BLOCKCHAIN_SIMULATE=false
