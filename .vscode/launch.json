{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LearnCards.Web (dotnet run)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-web",
      "program": "${workspaceFolder}/src/LearnCards.Web/bin/Debug/net10.0/LearnCards.Web.dll",
      "cwd": "${workspaceFolder}/src/LearnCards.Web",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "console": "internalConsole"
    },
    {
      "name": "LearnCards.McpServer (lokal)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-mcp",
      "program": "${workspaceFolder}/src/LearnCards.McpServer/bin/Debug/net10.0/LearnCards.McpServer.dll",
      "cwd": "${workspaceFolder}/src/LearnCards.McpServer",
      "env": {
        "LEARNCARDS_MCP_CONFIG": "${workspaceFolder}/.vscode/mcpsettings.debug.json"
      },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "App",
      "configurations": ["LearnCards.Web (dotnet run)", "LearnCards.McpServer (lokal)"]
    }
  ]
}
