{
  // Start über das Debug-Dropdown. Empfohlen:
  //   "App (SQLite)"             Web + MCP-Server, lokale SQLite-Datei, kein Docker nötig
  //   "App (PostgreSQL Docker)"  Web + MCP-Server gegen PostgreSQL im Docker-Container (docker-compose.dev.yml, Port 55432)
  // Die Compounds starten die Datenbank (falls nötig) und bauen vorher. Details: docs/local-development.md
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web (SQLite)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/LearnCards.Web/bin/Debug/net10.0/LearnCards.Web.dll",
      "cwd": "${workspaceFolder}/src/LearnCards.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000",
        "DB_PROVIDER": "sqlite",
        "MCP_API_KEY": "change-me-mcp-key",
        "MCP_PUBLIC_URL": "http://127.0.0.1:8787"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "console": "internalConsole"
    },
    {
      "name": "Web (PostgreSQL Docker)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/LearnCards.Web/bin/Debug/net10.0/LearnCards.Web.dll",
      "cwd": "${workspaceFolder}/src/LearnCards.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000",
        "DB_PROVIDER": "postgres",
        "POSTGRES_HOST": "127.0.0.1",
        "POSTGRES_PORT": "55432",
        "POSTGRES_USER": "learncards",
        "POSTGRES_PASSWORD": "learncards",
        "POSTGRES_DB": "learncards",
        "POSTGRES_SSLMODE": "disable",
        "MCP_API_KEY": "change-me-mcp-key",
        "MCP_PUBLIC_URL": "http://127.0.0.1:8787"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "console": "internalConsole"
    },
    {
      "name": "MCP-Server (lokal)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/LearnCards.McpServer/bin/Debug/net10.0/LearnCards.McpServer.dll",
      "cwd": "${workspaceFolder}/src/LearnCards.McpServer",
      "env": {
        "LEARNCARDS_MCP_CONFIG": "${workspaceFolder}/.vscode/mcpsettings.debug.json"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "MCP-Health im Browser",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:8787/health"
    },
    {
      // Registrierungs-PoC (Administrations- und Benutzerportal), nur lokal: docs/entra-external-id/poc-portal.md
      // Geheimnisse stehen in poc/.secrets/portal.env (git-ignoriert); anlegen/ergänzen mit: pwsh poc/New-PortalEnv.ps1
      // Anmeldung als Administrator lokal über /admin/signin mit PORTAL_DEV_ADMIN_KEY aus der portal.env.
      "name": "Registrierungs-PoC Portal (lokal)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: poc portal",
      "program": "${workspaceFolder}/poc/InviteRegistration.Portal/bin/Debug/net10.0/InviteRegistration.Portal.dll",
      "cwd": "${workspaceFolder}/poc/InviteRegistration.Portal",
      "envFile": "${workspaceFolder}/poc/.secrets/portal.env",
      "env": {
        "PORTAL_MODE": "development",
        "PORTAL_URL": "http://localhost:5090",
        "PORTAL_DATA_DIR": "${workspaceFolder}/poc/.secrets/portal-data",
        "PORTAL_SEED_DEMO": "1",
        "PORTAL_OTP_ENABLED": "1",
        "PORTAL_CLAIMS_ENABLED": "1",
        "PORTAL_OTP_URL": "http://127.0.0.1:5080",
        "OTP_EXT_AUDIENCES": "1132ae90-fa71-4a16-b5df-15054b9e1ff0,api://learny-otp.brors.date/1132ae90-fa71-4a16-b5df-15054b9e1ff0",
        "PORTAL_ENTRA_TENANT_ID": "5fce2b3c-8e95-49b5-9cfd-fc223b7e8f63",
        "PORTAL_ENTRA_AUTHORITY": "https://learnyextidpoc.ciamlogin.com/5fce2b3c-8e95-49b5-9cfd-fc223b7e8f63/v2.0",
        "PORTAL_ENTRA_CLIENT_ID": "cb54157f-bcfb-4e78-9c81-b63ee7a0a03d",
        // Administratoranmeldung: dieselbe Entra-App wie Learny ("Learny-oid", Workforce-Tenant). Admin = App-Rolle Admin.All. Das Secret steht in poc/.secrets/portal.env (PORTAL_ADMIN_CLIENT_SECRET).
        "PORTAL_ADMIN_AUTHORITY": "https://login.microsoftonline.com/db88f9b6-c89a-41a3-a21d-b61458e234ff/v2.0",
        "PORTAL_ADMIN_TENANT_ID": "db88f9b6-c89a-41a3-a21d-b61458e234ff",
        "PORTAL_ADMIN_CLIENT_ID": "89e199e0-d6b4-4e49-8be5-daeb2a2fed75",
        "PORTAL_ADMIN_ROLES": "Admin.All",
        "PORTAL_ADMIN_REDIRECT": "http://localhost:5090/admin/callback"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "(https?://localhost:\\d+)\\s+\\(Modus",
        "uriFormat": "%s/admin/signin"
      },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "App (SQLite)",
      "preLaunchTask": "build: app",
      "stopAll": true,
      "configurations": ["Web (SQLite)", "MCP-Server (lokal)"]
    },
    {
      "name": "App (PostgreSQL Docker)",
      "preLaunchTask": "dev: postgres up + build",
      "stopAll": true,
      "configurations": ["Web (PostgreSQL Docker)", "MCP-Server (lokal)"]
    },
    {
      "name": "App (SQLite) + MCP-Health",
      "preLaunchTask": "build: app",
      "stopAll": true,
      "configurations": ["Web (SQLite)", "MCP-Server (lokal)", "MCP-Health im Browser"]
    },
    {
      "name": "App (PostgreSQL Docker) + MCP-Health",
      "preLaunchTask": "dev: postgres up + build",
      "stopAll": true,
      "configurations": ["Web (PostgreSQL Docker)", "MCP-Server (lokal)", "MCP-Health im Browser"]
    }
  ]
}
