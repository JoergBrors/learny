# nginx als TLS-Reverse-Proxy für Learny (Compose-Profil "proxy"). Beispiel nach nginx/nginx.conf im Repository.
# ${LEARNY_HOST} und ${MCP_HOST} setzt das nginx-Image beim Start aus den Compose-Variablen ein; $-Variablen von nginx bleiben unverändert.

limit_req_zone $binary_remote_addr zone=learny_api:10m rate=30r/m;

# Blazor Server (SignalR/WebSockets)
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 80;
  server_name ${LEARNY_HOST} ${MCP_HOST};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${LEARNY_HOST};

  ssl_certificate     /etc/nginx/certs/cert.pem;
  ssl_certificate_key /etc/nginx/certs/key.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  client_max_body_size 20m;

  location /api/ {
    limit_req zone=learny_api burst=20 nodelay;
    proxy_pass http://web:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_buffering off;          # Chat-Streaming (SSE)
    proxy_read_timeout 120s;
  }

  location / {
    proxy_pass http://web:8080;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 120s;
  }
}

# Optional (Profil "mcp"): öffentlicher MCP-Endpunkt https://${MCP_HOST}/mcp
server {
  listen 443 ssl;
  http2 on;
  server_name ${MCP_HOST};

  ssl_certificate     /etc/nginx/certs/cert.pem;
  ssl_certificate_key /etc/nginx/certs/key.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    set $mcp_upstream http://mcp:8787;
    resolver 127.0.0.11 valid=10s;      # Docker-DNS: nginx startet auch, wenn der MCP-Container nicht läuft
    proxy_pass $mcp_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 300s;
  }
}
