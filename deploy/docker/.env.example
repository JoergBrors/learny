# ══════════════════════════════════════════════════════════════════════════════
# Learny (Docker Hub) — Konfiguration für deploy/docker/docker-compose.yml
#
#   cp .env.example .env      (Dateirechte einschränken: chmod 600 .env)
#
# Alle Werte stehen nur in dieser Datei — nie im Image, nie in der YAML, nie im Repository.
# Jede Variable: Dienst (web/mcp/db/compose) · Pflicht? · Standard · erlaubte Werte · Sicherheit.
# Mit  openssl rand -base64 32  lassen sich sichere Passwörter und Schlüssel erzeugen.
# ══════════════════════════════════════════════════════════════════════════════

# ─── A. Image-Version und Compose-Profile ───────────────────────────────────

# [compose] Version der Images joergb23/learny-web und joergb23/learny-mcp. Optional, Standard: latest (letzte stabile Version).
# Für reproduzierbare Installationen eine feste Version eintragen, z. B. 1.0.0 (siehe Docker Hub „Tags“).
LEARNY_VERSION=latest

# [compose] Aktive Profile, kommagetrennt. Standard: db
#   db     PostgreSQL im Container (bei externer PostgreSQL weglassen)
#   mcp    Learny-MCP-Server zusätzlich starten (siehe Abschnitt E)
#   proxy  nginx-TLS-Reverse-Proxy auf 80/443 (siehe Abschnitt H)
COMPOSE_PROFILES=db

# [compose] Adresse, an die die veröffentlichten Ports gebunden werden. Standard: 127.0.0.1 (nur lokal; davor gehört ein Reverse Proxy).
# 0.0.0.0 nur in einem vertrauenswürdigen Netz — die Web-App vertraut X-Forwarded-*-Headern und darf nie ungeschützt im Internet stehen.
LEARNY_BIND_ADDRESS=127.0.0.1
# [compose] Host-Port der Web-App. Standard: 8080
LEARNY_WEB_PORT=8080
# [compose] Host-Port des MCP-Servers (nur Profil mcp). Standard: 8787
LEARNY_MCP_PORT=8787

# ─── B. Datenbank (web, db) ─────────────────────────────────────────────────

# [web] Datenbank-Provider. Standard: postgres. Erlaubt: postgres | sqlite (SQLite-Datei im Volume web_data, nur für kleine Einzelinstallationen).
DB_PROVIDER=postgres
# [web] PostgreSQL-Host. Standard: db (der mitgelieferte Container). Bei externer PostgreSQL deren Adresse eintragen und COMPOSE_PROFILES ohne „db“ setzen.
POSTGRES_HOST=db
# [web] PostgreSQL-Port. Standard: 5432
POSTGRES_PORT=5432
# [web, db] Datenbankname. Standard: learncards
POSTGRES_DB=learncards
# [web, db] Datenbankbenutzer. Standard: learncards
POSTGRES_USER=learncards
# [web, db] PFLICHT. Passwort des Datenbankbenutzers (kein Standardwert; Compose bricht ohne ab). Lang und zufällig wählen.
POSTGRES_PASSWORD=CHANGE_ME
# [web] SSL-Modus der Datenbankverbindung. Standard: disable (internes Docker-Netz ausreichend).
# Bei externer PostgreSQL über das Internet: require (oder verify-full, falls unterstützt).
POSTGRES_SSLMODE=disable

# ─── C. Web-Anwendung (web) ─────────────────────────────────────────────────

# [web] ASP.NET-Umgebung. Standard: Production. Nicht auf Development stellen.
ASPNETCORE_ENVIRONMENT=Production
# [web] Verzeichnis der Data-Protection-Schlüssel (Anmelde-Cookies, geschützte Daten). Standard: /app/data/keys — liegt im persistenten Volume web_data; nicht ändern.
DATA_PROTECTION_DIR=/app/data/keys
# [web] Anzeige-Domain der Anwendung. Standard: localhost. Beispiel: learny.example.org
APP_DOMAIN=localhost
# [web] Öffentliche Basis-URL ohne abschließenden Schrägstrich (Aussteller-ID und Prüf-Links der Open Badges, Widerrufsliste).
# Standard: leer. In Produktion setzen, z. B. https://learny.example.org — spätere Änderung macht die Aussteller-URL bereits ausgestellter Badges ungültig.
PUBLIC_BASE_URL=
# [web] Ausführliche Fehler. Standard: false. Erlaubt: true | false
DEBUG=false

# ─── D. Anmeldung / Microsoft Entra ID (web) ────────────────────────────────

# [web] Anmeldeverfahren. Standard in diesem Paket: oidc.
#   oidc  Anmeldung über Microsoft Entra ID (Produktion)
#   dev   Login OHNE Passwort für einen Standardbenutzer mit Administratorrechten — ausschließlich zum lokalen Ausprobieren hinter 127.0.0.1, NIE in Produktion.
# Hinweis (ADR 0014): Nicht „auto“ verwenden und Schreibfehler vermeiden — unbekannte Werte und fehlende OIDC-Angaben können still zu dev führen.
AUTH_MODE=oidc
# [web] PFLICHT bei oidc. Aussteller (Issuer) des Verzeichnisses, z. B. https://login.microsoftonline.com/<Tenant-ID>/v2.0
OIDC_ISSUER=
# [web] PFLICHT bei oidc. Anwendungs-(Client-)ID der Entra-App-Registrierung.
OIDC_CLIENT_ID=
# [web] PFLICHT bei oidc. Geheimer Clientschlüssel der App-Registrierung (Wert, nicht die ID). Läuft ab — Ablaufdatum notieren. Sicherheitsrelevant.
OIDC_CLIENT_SECRET=CHANGE_ME
# [web] Optional. Erwartete Zielgruppe (Audience). Standard: leer. Üblich: gleich OIDC_CLIENT_ID.
OIDC_AUDIENCE=
# [web] Optional. Angeforderte Scopes. Standard: openid profile email
OIDC_WEB_SCOPE=openid profile email
# [web] Optional. Zuordnung von Entra-App-Rollen zu Learny-Rollen: „Rollenwert=admin|auditor“, kommagetrennt, z. B. Admin.All=admin,Auditor=auditor.
# Standard (wenn leer): Admin.All=admin
OIDC_ROLE_MAP=
# [web] Optional. Bootstrap: IdP-Subjects (Claim „sub“), die beim Login die Rolle admin erhalten, kommagetrennt. Standard: leer. Nur für die Ersteinrichtung.
ADMIN_SUBJECTS=
# Redirect-URI in der Entra-App-Registrierung (Typ „Web“): https://<öffentliche Adresse>/auth/callback

# ─── E. MCP — Zugang für KI-Clients (web, mcp) ──────────────────────────────

# [web, mcp] PFLICHT nur bei aktivem MCP (Profil mcp). Gemeinsamer Dienstschlüssel zwischen Web-App und MCP-Server (Header X-MCP-Key).
# Gewährt nie Datenzugriff (ADR 0013), nur Code-Tausch und öffentliches Schema. Zufällig und lang wählen; nie an Clients weitergeben.
MCP_API_KEY=
# [web] PFLICHT bei aktivem MCP und produktivem Betrieb. Erlaubte öffentliche MCP-URL(s) für die Rückleitung nach der Anmeldung,
# kommagetrennt, ohne Schrägstrich am Ende, z. B. https://mcp.example.org. Ohne Wert ist die MCP-Anmeldung in Produktion deaktiviert.
MCP_PUBLIC_URL=
# [web] Gültigkeit persönlicher MCP-Tokens in Tagen. Standard: 30 (erlaubt 1–365).
MCP_TOKEN_DAYS=30
# [web] PFLICHT (immer, auch ohne MCP-Server). Hauptschlüssel für MCP-Tokens, Einmal-Codes und dynamisch registrierte OAuth-Clients in der Datenbank
# (HMAC, Zeilen-MAC, AES-256-GCM; ADR 0025). Base64, mindestens 32 Byte. Erzeugen: openssl rand -base64 32.
# Nur in dieser Datei ablegen und getrennt von Datenbank-Sicherungen sichern. Geht er verloren, sind alle MCP-Zugänge ungültig (Neuanmeldung); Lerninhalte bleiben erhalten.
# Ohne gültigen Schlüssel startet Learny nicht.
MCP_TOKEN_KEY=CHANGE_ME
# [web] Optional. Nach einer Schlüsselrotation die bisherigen Schlüssel (kommagetrennt, Base64): nur zum Prüfen/Entschlüsseln. Standard: leer.
MCP_TOKEN_KEY_PREVIOUS=
# [web] Optional. Ende der Übergangsfrist für ältere MCP-Tokens (reiner SHA-256, vor ADR 0025). ISO-Datum. Standard: 2027-01-31
MCP_LEGACY_TOKEN_UNTIL=
# [mcp] PFLICHT bei aktivem MCP. Öffentliche URL der Learny-Weboberfläche für die Browser-Anmeldung, z. B. https://learny.example.org
LEARNCARDS_WEB_PUBLIC_URL=
# [mcp] Interne API-Adresse (http://web:8080/api), HTTP-/stdio-Schalter und Listener setzt die Compose-Datei selbst; sie sind hier bewusst nicht einstellbar.
# [mcp] Den Issuer (öffentliche MCP-URL) und die OAuth-Einstellungen stellst du in ./mcpsettings.json ein (Kopie von mcpsettings.example.json).

# ─── F. KI (web) ────────────────────────────────────────────────────────────

# [web] Optional. OpenAI-API-Schlüssel für Chat, Quiz-Generierung und KI-Bewertung. Ohne Schlüssel arbeitet Learny im Offline-Fallback. Sicherheitsrelevant.
OPENAI_API_KEY=
# [web] Optional. Modell. Standard: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# [web] Optional. Basis-URL einer OpenAI-kompatiblen API. Standard: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── G. Open Badges und Blockchain-Verankerung (web) ────────────────────────
# Zertifikate (ADR 0021) werden immer signiert. Die Verankerung auf Polygon (ADR 0022) ist optional; es werden keine personenbezogenen Daten on-chain gespeichert.

# [web] Optional. Privater Signaturschlüssel der Badges (ECDSA P-256, PKCS#8-PEM, mehrzeilig in Anführungszeichen). Standard: leer = Schlüssel wird beim ersten Start
# im Volume (/app/data/badge-signing-key.pem) erzeugt. Dieses Volume sichern — ohne den Schlüssel sind ausgestellte Badges nicht mehr prüfbar. Streng geheim.
BADGE_SIGNING_KEY_PEM=
# [web] Optional. Eigenes Signaturzertifikat für die PDF-Signatur der Zertifikate (ADR 0033), unabhängig vom Badge-Schlüssel. Ohne Zertifikat liefert die Anwendung KEINE PDFs aus (503).
# Variante A: PKCS#12-Datei im Container (z. B. als Docker-Secret eingebunden) + Passwort; Variante B: Base64-Inhalt der .pfx. Siehe docs/pdf-signature.md. Streng geheim.
PDF_SIGNING_CERT_FILE=
PDF_SIGNING_CERT_PASSWORD=
PDF_SIGNING_CERT_PFX_BASE64=
# [web] Verankerung ein/aus. Standard: true. Erlaubt: true | false. (false = nur signierte Badges.)
BLOCKCHAIN_ENABLED=true
# [web] Netzwerk. Standard: polygon-amoy (Testnetz, keine echten Kosten). Mainnet: polygon-mainnet (zusätzlich Freigabe nötig, siehe unten).
BLOCKCHAIN_NETWORK=polygon-amoy
# [web] Automatische Bündelung und Verankerung. Standard: true
BLOCKCHAIN_AUTO_ANCHOR=true
# [web] Harte Kostengrenze je Nachweis in EUR. Standard und Maximum: 0.001 (höhere Werte sind ungültig).
BLOCKCHAIN_MAX_COST_EUR=0.001
# [web] Mainnet technisch erlauben. Standard: false. Zusätzlich braucht Mainnet eine ausdrückliche Freigabe durch einen Administrator und einen Signierer.
BLOCKCHAIN_MAINNET_ENABLED=false
# [web] Batch-Bündelung ein/aus. Standard: true
BLOCKCHAIN_BATCH_ENABLED=true
# [web] Maximale Nachweise je Batch. Standard: 100
BLOCKCHAIN_BATCH_MAX_SIZE=100
# [web] Maximale Wartezeit bis zum Senden eines Batches in Minuten. Standard: 60
BLOCKCHAIN_BATCH_MAX_WAIT_MINUTES=60
# [web] Öffentliche Wallet-Adresse (0x…) des Ausstellers. Standard: leer. Kein privater Schlüssel!
BLOCKCHAIN_WALLET_ADDRESS=

# ─── H. Reverse Proxy / HTTPS (Profil proxy) ────────────────────────────────

# [compose, proxy] Öffentlicher Hostname der Web-App (ohne https://). Standard: localhost. Beispiel: learny.example.org
LEARNY_HOST=localhost
# [compose, proxy] Öffentlicher Hostname des MCP-Servers (ohne https://). Standard: mcp.localhost. Beispiel: mcp.example.org
MCP_HOST=mcp.localhost
# Das Profil proxy erwartet ./certs/cert.pem (Zertifikat mit Kette) und ./certs/key.pem (privater Schlüssel, Rechte 600).

# ─── I. Bildspeicher (web) — ADR 0017/0018 ──────────────────────────────────
# Bilder erreichen Clients nur über /api/images/{id}. Zugangsdaten gehören nur hierher.

# [web] Provider. Standard: database. Erlaubt: database | local | azureblob | s3 | sharepoint
#   database  Bilder in der Datenbank (kein weiterer Speicher nötig)
#   local     Dateien im Volume web_data unter IMAGE_LOCAL_PATH
IMAGE_STORAGE_PROVIDER=database
# [web, nur local] Verzeichnis. Standard in diesem Paket: /app/data/images (persistentes Volume). Muss unter /app/data liegen, sonst gehen Bilder beim Neustart verloren.
IMAGE_LOCAL_PATH=/app/data/images
# [web] Bild-Proxy aktiv. Standard: true
IMAGE_PROXY_ENABLED=true
# [web] Timeout ausgehender Speicheraufrufe in Sekunden. Standard: 30
IMAGE_HTTP_TIMEOUT_SECONDS=30
# [web] Bildcache. Standard: true; maximale Größe MB (512), Gültigkeit Minuten (1440), Speichercache MB (64); Pfad optional (leer = unter /app/data).
IMAGE_CACHE_ENABLED=true
IMAGE_CACHE_MAX_SIZE_MB=512
IMAGE_CACHE_TTL_MINUTES=1440
IMAGE_CACHE_MEMORY_MB=64
IMAGE_CACHE_PATH=

# --- Azure Blob (IMAGE_STORAGE_PROVIDER=azureblob) ---
# [web] Speicherkonto-Name (oder IMAGE_AZUREBLOB_ENDPOINT), Container (Standard learncards-images), Authentifizierung (Standard managedidentity; sonst clientsecret | sharedkey (sharedkey nur Entwicklung/Test)).
IMAGE_AZUREBLOB_ACCOUNT=
IMAGE_AZUREBLOB_ENDPOINT=
IMAGE_AZUREBLOB_CONTAINER=learncards-images
IMAGE_AZUREBLOB_AUTH=managedidentity
# [web] Nur bei clientsecret: Tenant/Client/Secret der App-Registrierung. Nur bei sharedkey: Kontoschlüssel. Geheim.
IMAGE_AZUREBLOB_TENANT_ID=
IMAGE_AZUREBLOB_CLIENT_ID=
IMAGE_AZUREBLOB_CLIENT_SECRET=
IMAGE_AZUREBLOB_ACCOUNT_KEY=
# [web] Gültigkeit kurzlebiger Lese-Signaturen in Sekunden. Standard: 60
IMAGE_AZURE_SAS_TTL_SECONDS=60

# --- S3 / S3-kompatibel (IMAGE_STORAGE_PROVIDER=s3) ---
# [web] Endpoint (leer = AWS), Region (Standard us-east-1), Bucket, Zugangsschlüssel; Path-Style (Standard false; für MinIO true). Geheim.
IMAGE_S3_ENDPOINT=
IMAGE_S3_REGION=us-east-1
IMAGE_S3_BUCKET=
IMAGE_S3_ACCESS_KEY_ID=
IMAGE_S3_SECRET_ACCESS_KEY=
IMAGE_S3_SESSION_TOKEN=
IMAGE_S3_PATH_STYLE=false
IMAGE_S3_PRESIGN_TTL_SECONDS=60

# --- SharePoint / Microsoft Graph (IMAGE_STORAGE_PROVIDER=sharepoint) ---
# [web] Tenant, App-Registrierung (Client-ID/-Secret), Site- und Laufwerks-ID, Zielordner (Standard LearnCards/images). Geheim.
IMAGE_SHAREPOINT_TENANT_ID=
IMAGE_SHAREPOINT_CLIENT_ID=
IMAGE_SHAREPOINT_CLIENT_SECRET=
IMAGE_SHAREPOINT_SITE_ID=
IMAGE_SHAREPOINT_DRIVE_ID=
IMAGE_SHAREPOINT_FOLDER=LearnCards/images
# Weitere, selten benötigte Optionen (…_ALLOW_HTTP, …_ALLOW_PRIVATE_NETWORK, …_AUTHORITY, …_ENDPOINT) siehe docs/adr/0017-konfigurierbare-bildspeicher.md; sie sind in der Compose-Datei nicht vorbelegt.
