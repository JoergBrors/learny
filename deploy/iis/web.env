# LearnCards Web-App Konfiguration fuer IIS-Deployments aus dem Repository.
# Diese Datei wird beim Tag-Deploy nach <IIS_PHYSICAL_PATH>\.env kopiert.
# Achtung: Werte in diesem Repository sind bei einem geteilten Repo sichtbar.

# Oeffentliche Basis-URL (Badge-Aussteller, Pruef-Links, Widerrufsliste); GitHub Variable PUBLIC_BASE_URL
PUBLIC_BASE_URL=__PUBLIC_BASE_URL__
APP_DOMAIN=__APP_DOMAIN__
DEBUG=__DEBUG__

# PDF-Signatur der Zertifikate (ADR 0033): Zertifikat NICHT im Repository ablegen. Nach dem Deployment in <IIS_PHYSICAL_PATH>\.env ergaenzen:
# PDF_SIGNING_CERT_FILE=<root>\keys\pdf-signing.pfx   PDF_SIGNING_CERT_PASSWORD=...   (siehe docs/pdf-signature.md); ohne Zertifikat liefert die App keine PDFs.

# Datenbank
DB_PROVIDER=__DB_PROVIDER__
SQLITE_PATH=__SQLITE_PATH__
# Fuer PostgreSQL statt SQLite diese Werte anpassen:
# DB_PROVIDER=postgres
POSTGRES_HOST=__POSTGRES_HOST__
POSTGRES_PORT=__POSTGRES_PORT__
POSTGRES_USER=__POSTGRES_USER__
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=__POSTGRES_DB__
POSTGRES_SSLMODE=__POSTGRES_SSLMODE__

# Auth
AUTH_MODE=__AUTH_MODE__
OIDC_ISSUER=__OIDC_ISSUER__
OIDC_CLIENT_ID=__OIDC_CLIENT_ID__
OIDC_CLIENT_SECRET=__OIDC_CLIENT_SECRET__
OIDC_AUDIENCE=__OIDC_AUDIENCE__
OIDC_WEB_SCOPE=__OIDC_WEB_SCOPE__

# OpenAI
OPENAI_API_KEY=__OPENAI_API_KEY__
OPENAI_MODEL=__OPENAI_MODEL__
OPENAI_BASE_URL=__OPENAI_BASE_URL__

# MCP-Zugriff auf die Web-API
MCP_API_KEY=__MCP_API_KEY__
# Erlaubte oeffentliche MCP-URL fuer die Rueckleitung nach der Anmeldung (muss gleich oauth.issuer sein); GitHub Variable MCP_PUBLIC_URL
MCP_PUBLIC_URL=__MCP_PUBLIC_URL__
# Pflicht (ADR 0025): Hauptschluessel fuer MCP-Tokens, Codes und OAuth-Clients in der Datenbank; GitHub Secret MCP_TOKEN_KEY (Base64, mind. 32 Byte)
MCP_TOKEN_KEY=__MCP_TOKEN_KEY__
# ADMIN_SUBJECTS und MCP_TOKEN_DAYS werden vom Deploy-Workflow nicht gerendert (ADR 0011/0013): als IIS-Umgebungsvariablen am App-Pool setzen
# (Umgebungsvariablen haben Vorrang vor .env). Ohne MCP_PUBLIC_URL ist die OAuth-Anmeldung am MCP-Server deaktiviert.

# Lokaler Dev-Login-Fallback falls OIDC leer bleibt
DEV_USER_NAME=__DEV_USER_NAME__
DEV_USER_EMAIL=__DEV_USER_EMAIL__

# Bildspeicher (ADR 0017/0018): Standard "database". Weitere IMAGE_* Werte (local/azureblob/s3/sharepoint, Cache, SAS-TTL) als IIS-Umgebungsvariablen
# setzen - der Workflow rendert sie (noch) nicht; Secrets gehoeren nie in dieses Repository. Siehe .env.example und docs/iis-deployment.md.
IMAGE_STORAGE_PROVIDER=database
