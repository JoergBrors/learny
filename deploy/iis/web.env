# LearnCards Web-App Konfiguration fuer IIS-Deployments aus dem Repository.
# Diese Datei wird beim Tag-Deploy nach <IIS_PHYSICAL_PATH>\.env kopiert.
# Achtung: Werte in diesem Repository sind bei einem geteilten Repo sichtbar.

APP_DOMAIN=JOERGS-SRV
DEBUG=false

# Datenbank
DB_PROVIDER=sqlite
SQLITE_PATH=data/learncards.db
# Fuer PostgreSQL statt SQLite diese Werte anpassen:
# DB_PROVIDER=postgres
# POSTGRES_HOST=replace-with-postgres-host
# POSTGRES_PORT=5432
# POSTGRES_USER=replace-with-postgres-user
# POSTGRES_PASSWORD=replace-with-postgres-password
# POSTGRES_DB=learncards
# POSTGRES_SSLMODE=require

# Auth
AUTH_MODE=auto
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_WEB_SCOPE=openid profile email

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# MCP-Zugriff auf die Web-API
MCP_API_KEY=replace-with-your-mcp-api-key

# Lokaler Dev-Login-Fallback falls OIDC leer bleibt
DEV_USER_NAME=Lokale Entwicklung
DEV_USER_EMAIL=dev@localhost
