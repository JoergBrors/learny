# LearnCards Web-App Konfiguration fuer IIS-Deployments aus dem Repository.
# Diese Datei wird beim Tag-Deploy nach <IIS_PHYSICAL_PATH>\.env kopiert.
# Achtung: Werte in diesem Repository sind bei einem geteilten Repo sichtbar.

APP_DOMAIN=__APP_DOMAIN__
DEBUG=__DEBUG__

# Datenbank
DB_PROVIDER=__DB_PROVIDER__
SQLITE_PATH=__SQLITE_PATH__
# Fuer PostgreSQL statt SQLite diese Werte anpassen:
# DB_PROVIDER=postgres
POSTGRES_HOST=__POSTGRES_HOST__
POSTGRES_PORT=__POSTGRES_PORT__
POSTGRES_USER=__POSTGRES_USER__
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=__POSTGRES_DB__
POSTGRES_SSLMODE=__POSTGRES_SSLMODE__

# Auth
AUTH_MODE=__AUTH_MODE__
OIDC_ISSUER=__OIDC_ISSUER__
OIDC_CLIENT_ID=__OIDC_CLIENT_ID__
OIDC_CLIENT_SECRET=__OIDC_CLIENT_SECRET__
OIDC_AUDIENCE=__OIDC_AUDIENCE__
OIDC_WEB_SCOPE=__OIDC_WEB_SCOPE__

# OpenAI
OPENAI_API_KEY=__OPENAI_API_KEY__
OPENAI_MODEL=__OPENAI_MODEL__
OPENAI_BASE_URL=__OPENAI_BASE_URL__

# MCP-Zugriff auf die Web-API
MCP_API_KEY=__MCP_API_KEY__

# Lokaler Dev-Login-Fallback falls OIDC leer bleibt
DEV_USER_NAME=__DEV_USER_NAME__
DEV_USER_EMAIL=__DEV_USER_EMAIL__
