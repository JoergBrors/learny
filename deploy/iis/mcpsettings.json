{
  "serverName": "learncards",
  "serverVersion": "2.1.0",
  "upstreamApi": {
    "baseUrl": "http://localhost/api",
    "apiKey": "__MCP_API_KEY__"
  },
  "transports": {
    "stdio": {
      "enabled": false
    },
    "http": {
      "enabled": true,
      "urls": [
        "http://127.0.0.1:8787"
      ]
    }
  },
  "oauth": {
    "enabled": true,
    "issuer": "http://127.0.0.1:8787",
    "audience": "learncards-mcp",
    "signingKey": "__MCP_OAUTH_SIGNING_KEY__",
    "tokenLifetimeMinutes": 60,
    "clients": [
      {
        "clientId": "learncards-local-llm",
        "clientSecret": "__MCP_OAUTH_CLIENT_SECRET__",
        "scopes": [
          "mcp"
        ]
      }
    ]
  }
}
