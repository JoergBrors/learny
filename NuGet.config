<?xml version="1.0" encoding="utf-8"?>
<!--
  LearnCards ist bewusst ohne externe NuGet-Pakete gebaut (nur .NET SDK + ASP.NET Core Framework).
  Damit funktioniert der Build vollständig offline. Wer Pakete ergänzen möchte, trägt hier
  wieder nuget.org als Quelle ein:
  <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
